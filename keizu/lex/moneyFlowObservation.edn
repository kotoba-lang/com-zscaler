{:lexicon 1
 :id "com.etzhayyim.keizu.moneyFlowObservation"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :description "A FACTUAL public money flow between public roles/organs (procurement award, subsidy, grant, political donation, budget outlay), traced from public information. FACTUAL only (G2): bribe / kickback / slush are not enum members. Sourced (G3): ≥2 public-source citations. NON-adjudicating: records the disclosed flow, never asserts wrongdoing."
   :record
   {:type "object"
    :required ["moneyId" "payer" "payee" "kind" "amount" "currency" "nonAdjudicatingNotice" "sources" "sourcing"]
    :properties
    {:moneyId  {:type "string" :description "→ :money/id"}
     :payer    {:type "string" :description "→ :node/id (public authority / donor seat)"}
     :payee    {:type "string" :description "→ :node/id (recipient public org / awardee role)"}
     :kind     {:type "string"
                :enum ["procurement-award" "subsidy" "grant" "political-donation" "budget-outlay"]
                :description "G2 INVARIANT — disclosed public flow kinds only. bribe / kickback / slush are NOT enum members."}
     :amount   {:type "number"}
     :currency {:type "string" :description "ISO-4217 (JPY / USD / EUR / GBP …)"}
     :asOf     {:type "integer" :description "G10 — disclosed-at; append-only."}
     :nonAdjudicatingNotice {:type "boolean" :const true
                             :description "G2 INVARIANT — only true."}
     :sources  {:type "array" :items {:type "string"} :minLength 2
                :description "G3 INVARIANT — ≥2 public-source URLs/CIDs (調達ポータル / 政治資金収支報告書 / USAspending / TED …)."}
     :sourcing {:type "string" :enum ["representative" "authoritative"]}}}}}}
