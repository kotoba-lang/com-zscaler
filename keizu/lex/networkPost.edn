{:lexicon 1
 :id "com.etzhayyim.keizu.networkPost"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :description "A DRY-RUN social post narrating an AGGREGATE finding from the relation graph (a committee's cross-organ concentration, a per-payee award share, a revolving-door chain). Mirror-stance (G5): opens with the accountability-map disclaimer, never speaks AS a government. NON-adjudicating (G2). Member-signed (G7): the server never signs. Outward-gated (G8): status is dry-run only at R0."
   :record
   {:type "object"
    :required ["postId" "subject" "body" "status" "isMirror" "nonAdjudicatingNotice" "serverHeldKey" "sources"]
    :properties
    {:postId  {:type "string" :description "→ :post/id"}
     :subject {:type "string" :description "the aggregate finding (committee/organ/jurisdiction), not a person"}
     :body    {:type "string" :description "the narration; opens with the mirror + non-adjudicating disclaimer"}
     :status  {:type "string" :const "dry-run"
               :description "G8 INVARIANT — only 'dry-run' at R0. 'published' is not a valid value; live posting needs Council Lv6+ + operator + member signature."}
     :isMirror {:type "boolean" :const true
                :description "G5 INVARIANT — only true. An observational mirror, never the government, never a target-list."}
     :nonAdjudicatingNotice {:type "boolean" :const true
                             :description "G2 INVARIANT — only true."}
     :serverHeldKey {:type "boolean" :const false
                     :description "G7 / no-server-key INVARIANT — only false. The member signs; the server never does (ADR-2605231525)."}
     :author  {:type "string" :description "SBT-bound member DID (required for any gated live post)"}
     :sources {:type "array" :items {:type "string"} :minLength 2
               :description "G3 — the post carries the same ≥2 public-source citations as the finding."}}}}}}
