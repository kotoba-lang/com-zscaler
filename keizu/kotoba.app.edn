;; kotoba.app.edn — actor:keizu 系図 KOTOBA Mesh application manifest (generated scaffold).
;; Deploy:  kotoba app deploy kotoba.app.edn  (compiles methods/mesh.clj → CID → control datoms)
{:kotoba.app/name    "keizu"
 :kotoba.app/version "0.1.0"
 :kotoba.app/components
 [{:name     "keizu"
   :src      "methods/mesh.clj"                  ; Clojure default → run + on-kse
   :scale    1
   :triggers [{:type :kse :topic "etzhayyim/actor/keizu"}]  ; observatory on-kse (ADR-2606230001 §4)
   :requires #{:cap/kqe}}
  ;; self-publication: keizu periodically drafts its OWN history (aggregate edge-primary
  ;; relation/money concentration findings) + procedures as DRY-RUN social posts, and —
  ;; once it holds its own mesh-runtime key (self-custodied, no-server-key, ADR-2605231525)
  ;; under a member CACAO leash — signs + emits them itself. Reuses the PRE-EXISTING social
  ;; cell (cells/social_post/state_machine.cljc membrane + methods/social.cljc projection,
  ;; ADR-2606066000), now did-web-registered + trigger-wired. Live broadcast stays Council
  ;; Lv6+ + operator gated (§1.12/G11); R0 = dry-run. ADR-2606272355.
  {:name     "keizu-social"
   :src      "methods/social.cljc"
   :scale    1
   :triggers [{:type :tick :cron "0 */6 * * *"}                 ; every 6h: self-publish backlog
              {:type :kse  :topic "etzhayyim/actor/keizu/publish"}]
   :requires #{:cap/kqe :cap/atproto}}]

 :kotoba.app/placement {:spread  :zone
                        :require {:tier "edge"}}}
