{:paths ["src"]
 ;; kotoba-actors-clj — a PARALLEL Clojure / kotoba-datomic refactor of the
 ;; etzhayyim Python actors (kabuto 兜 / uchiwake 内訳). The Python actors under
 ;; etzhayyim/root/20-actors/{kabuto,uchiwake}/ are LEFT UNTOUCHED — this project
 ;; only READS their seed EDN + reuses their pure .cljc ports on the classpath,
 ;; and adds a Datom/EAVT + datalog refactor layer in src/.
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}}}
