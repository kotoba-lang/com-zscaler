{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:infra.etzhayyim.com:datacenter",
  "name": "datacenter",
  "nanoid": "d7c3n7r0",
  "displayName": "Datacenter Operations Actor",
  "description": "ADR-0055 BPMN-as-actor for datacenter incident response, planned maintenance, physical access review, capacity reservation, and access-payload purge. Facility-scoped operations with explicit change review, health validation, Tier 3 visitor payload separation, and audit trail.",
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "performerType": "service",
  "parentDid": "did:web:infra.etzhayyim.com",
  "heartbeatRequired": true,
  "domainKnowledgeRequired": true,
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke"
  ],
  "convoSystemPrompt": "You are the Datacenter Operations actor. You manage facility-scoped incident response, planned maintenance, physical access review, rack/power/cooling reservation, and post-change health validation. Prioritize uptime, least-privilege access, safe rollback, reserved headroom visibility, and auditable execution state. Respond in the user's language.",
  "profile": {
    "agentType": "reactive",
    "isBot": true,
    "operator": "etzhayyim.co.jp",
    "displayName": "Datacenter Operations",
    "description": "Facility-scoped BPMN operations actor for change review, execution, physical access approval, capacity reservation, health check, and incident stabilization.",
    "category": "infrastructure"
  },
  "governance": {
    "classification": "internal",
    "raci": "responsible",
    "rules": [
      {
        "id": "RULE-DATACENTER-APPROVAL",
        "name": "High-Risk Change Approval Required",
        "enforcement": "Operations marked requiresApproval=true must not enter execution without reviewChange approve verdict."
      },
      {
        "id": "RULE-DATACENTER-HEALTHCHECK",
        "name": "Health Check Before Closure",
        "enforcement": "Planned work and incidents must pass reportHealthCheck before completed or incident-stabilized terminal states."
      },
      {
        "id": "RULE-DATACENTER-AUDIT",
        "name": "Audit Every Terminal Outcome",
        "enforcement": "completed, rejected, and incident-stabilized outcomes must emit generic.audit.emit."
      }
    ]
  },
  "actors": [
    {
      "path": "actor:intake-router",
      "displayName": "Operations Intake Router",
      "description": "Routes facility requests into planned work or incident response."
    },
    {
      "path": "actor:change-review",
      "displayName": "Change Review",
      "description": "Applies approval gate for planned work with non-trivial blast radius."
    },
    {
      "path": "actor:incident-stabilizer",
      "displayName": "Incident Stabilizer",
      "description": "Runs stabilization loop until facility health is restored or degraded state is contained."
    },
    {
      "path": "actor:physical-access-review",
      "displayName": "Physical Access Review",
      "description": "Handles contractor and visitor access requests with Tier 3 identity payload separation."
    },
    {
      "path": "actor:capacity-planner",
      "displayName": "Capacity Planner",
      "description": "Approves rack, power, and cooling reservations and maintains reserved-headroom visibility."
    }
  ],
  "triggers": {
    "xrpc": {
      "procedures": [
        "com.etzhayyim.apps.datacenter.startOperation",
        "com.etzhayyim.apps.datacenter.submitIntake",
        "com.etzhayyim.apps.datacenter.reviewChange",
        "com.etzhayyim.apps.datacenter.reportExecution",
        "com.etzhayyim.apps.datacenter.reportHealthCheck",
        "com.etzhayyim.apps.datacenter.stabilizeIncident",
        "com.etzhayyim.apps.datacenter.requestAccess",
        "com.etzhayyim.apps.datacenter.submitAccessDraft",
        "com.etzhayyim.apps.datacenter.reviewAccess",
        "com.etzhayyim.apps.datacenter.reserveCapacity",
        "com.etzhayyim.apps.datacenter.reviewCapacity",
        "com.etzhayyim.apps.datacenter.purgeAccessPii"
      ],
      "queries": [
        "com.etzhayyim.apps.datacenter.getOperation",
        "com.etzhayyim.apps.datacenter.listForFacility",
        "com.etzhayyim.apps.datacenter.getMyAccessRequest",
        "com.etzhayyim.apps.datacenter.listAccessForFacility"
      ]
    }
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "kyumei"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "complianceDocs": [
    "90-docs/adr/0055-datacenter-operations-actor.md",
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md"
  ],
  "uiType": "redirect"
}
