  "primarySchema": "20-actors/hibiki/lex/presentation.edn",
  "siblings": ["utsushie", "ossekai", "kataribe"],
  "runtime": {
    "kind": "offline-method",
    "note": "R0 = pure, offline, deterministic presentation-PLAN builder (methods/present_plan.cljc); no model call, no clock/RNG, no network. render() raises at R0 (H5/G8 Murakumo-only). R1 wraps build-plan in a Pregel cell + reuses utsushie's G8 Murakumo render/TTS leg; publish via ossekai."
  },
  "gates": {
    "H1": "PROPOSE-not-act (= G1) — builds a PLAN; render/publish G8-gated and carried by ossekai (member-capability), no autonomous broadcast, no truth-verdict",
    "H2": "script ≤ excerpt (= G4) — narration bounded to the proposal's ≤280-char finding excerpt + the proposed action; nothing asserted beyond the proposal",
    "H3": "ANTI-DEEPFAKE (= G9) — neutral synthetic narrator + visuals; no named-real-person likeness or voice clone",
    "H4": "NO-ENGAGEMENT-OPT + ANTI-MANIPULATION (= G2) — the 説得力 knife-edge: clarity+resonance only; no watch/dwell/conversion-optimized edit, no fake urgency, no weaponized audio",
    "H5": "MURAKUMO-ONLY render/TTS (= G6, ADR-2605215000) — external-GPU / commercial-TTS unrepresentable",
    "H6": "MEMBER-SIGNED publish (= G7, ADR-2605231525) — no server-held key; publish carried by ossekai",
    "H7": "AGGREGATE-FIRST (= ossekai G4) — default audience is aggregate/anonymized; targeted is secondary + consent-bound",
    "H8": "NON-ESCHATOLOGICAL (§1.15) — sober framing; SFX/music allowlisted by :purpose; no doom/fear/euphoria edit"
  },
  "composesWith": {
    "ossekai": "upstream source (御節介 :proposal) AND downstream carrier (member-signed publish, consent registry, aggregate-first discipline)",
    "utsushie": "sibling medium — reuse its Murakumo render leg + anti-deepfake gate machinery + i18n; hibiki = proposal-side, utsushie = article-side",
    "kataribe": "multilingual narration / translation (per-language script, ADR-2605140740)",
    "kotoba": "persists the plan as append-only content-addressed datoms (the stream = the trail, 非終末論)"
  },
  "entrypoints": {
    "test": "bb -cp 20-actors -m hibiki.methods.test-present-plan"
  }
