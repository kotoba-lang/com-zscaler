// Xero clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace xero {

    entity Invoice {
        id: string @unique
        invoiceNumber: string
        type: string
        status: string
        total: float
        amountDue: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Contact {
        id: string @unique
        name: string
        emailAddress: string
        contactStatus: string
        taxNumber: string
        isSupplier: boolean
        isCustomer: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Account {
        id: string @unique
        code: string
        name: string
        type: string
        status: string
        bankAccountNumber: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Payment {
        id: string @unique
        amount: float
        status: string
        paymentType: string
        isReconciled: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity BankTransaction {
        id: string @unique
        type: string
        status: string
        total: float
        reference: string
        isReconciled: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity CreditNote {
        id: string @unique
        creditNoteNumber: string
        type: string
        status: string
        total: float
        createdAt: datetime
        updatedAt: datetime
    }

}
