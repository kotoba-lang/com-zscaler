{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:oil-midstream.etzhayyim.com",
  "actors": [
    {
      "description": "Gathering, trunkline and export pipeline coverage.",
      "displayName": "Pipeline Registry",
      "path": "registry:pipeline"
    },
    {
      "description": "Storage, blending, export and import terminal coverage.",
      "displayName": "Terminal Registry",
      "path": "registry:terminal"
    },
    {
      "description": "Flow edges from basins and pipelines into terminals and refineries.",
      "displayName": "Network Flow Map",
      "path": "network:flow"
    },
    {
      "description": "Capacity bottleneck, outage and chokepoint constraint coverage.",
      "displayName": "Constraint Monitoring",
      "path": "risk:constraints"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Oil Midstream agent. Track pipeline networks, storage nodes, terminals and export corridors. Explain how infrastructure availability and bottlenecks constrain movement from upstream assets into refining and shipping systems.",
  "description": "Pipeline, storage, terminal and chokepoint infrastructure coverage across gathering, trunkline, export and import networks.",
  "displayName": "Oil Midstream & Terminal Intelligence",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "PHMSA",
      "IMO ISPS Code",
      "API Pipeline Standards"
    ],
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "oil-midstream",
  "nanoid": "01lm1dst",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:OilPipeline) RETURN p.country_code AS country, count(p) AS count, sum(p.capacity_bpd) AS capacity ORDER BY capacity DESC LIMIT 20"
          },
          "fn": "graph.query",
          "id": "pipelineStats"
        },
        {
          "args": {
            "sql": "MATCH (t:OilTerminal) RETURN t.terminal_type AS terminalType, count(t) AS count LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "terminalStats"
        },
        {
          "args": {
            "sql": "MATCH ()-[e:constrainedBy]->() RETURN e.constraint_type AS constraintType, count(e) AS count LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "networkConstraints"
        },
        {
          "args": {
            "message": "Oil midstream report.\n\nPipeline stats:\n$pipelineStats.rows\n\nTerminal stats:\n$terminalStats.rows\n\nNetwork constraints:\n$networkConstraints.rows\n\nSummarize the main transfer corridors, terminal concentration and the most material infrastructure bottlenecks."
          },
          "depends_on": [
            "pipelineStats",
            "terminalStats",
            "networkConstraints"
          ],
          "fn": "agent.chat",
          "id": "analyze"
        },
        {
          "args": {
            "template": "Oil midstream report: $analyze.text"
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */8 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:OilTerminal) WHERE t.locode = $input.record.loadPort OR t.locode = $input.record.dischargePort RETURN t.vertex_id, t.terminal_type AS terminalType, t.country_code AS country LIMIT 20"
          },
          "fn": "graph.query",
          "id": "matchTerminalFlows"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.oilShipping.cargo"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:OilPipeline {pipeline_code: $input.pipelineCode}) RETURN p.vertex_id, p.repo, p.collection, p.status LIMIT 1"
          },
          "fn": "graph.query",
          "id": "pipeline"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilMidstream.infrastructure.getPipeline",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:OilPipeline) RETURN p.vertex_id, p.repo, p.collection, p.status LIMIT 50"
          },
          "fn": "graph.query",
          "id": "pipelines"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilMidstream.infrastructure.listPipelines",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:OilTerminal) RETURN t.vertex_id, t.repo, t.collection, t.status LIMIT 50"
          },
          "fn": "graph.query",
          "id": "terminals"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilMidstream.infrastructure.listTerminals",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s)-[e:flowsTo]->(t:OilTerminal {locode: $input.locode}) RETURN e.edge_id, e.commodity, e.volume, e.unit LIMIT 50"
          },
          "fn": "graph.query",
          "id": "network"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilMidstream.infrastructure.getTerminalNetwork",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:OilPipeline) RETURN count(p) AS pipelines LIMIT 1"
          },
          "fn": "graph.query",
          "id": "stats"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilMidstream.health",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "oil-midstream",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.oilMidstream.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "01lm1dst",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "pipeline-registry",
      "terminal-registry",
      "network-constraint-analysis",
      "flow-mapping",
      "export-hub-monitoring"
    ],
    "description": "Tracks pipelines, storage hubs, crude/product terminals, flows between basins and refineries, and network bottlenecks.",
    "displayName": "Oil Midstream & Terminal Intelligence",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.oilMidstream.pipeline",
        "com.etzhayyim.apps.oilMidstream.terminal",
        "com.etzhayyim.apps.oilMidstream.flow",
        "com.etzhayyim.apps.oilShipping.cargo",
        "com.etzhayyim.apps.port.portCallEvent"
      ]
    }
  },
  "uiType": "yoro"
}
