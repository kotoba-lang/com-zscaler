// Zap_energy clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace zap_energy {

    entity Shot {
        id: string @unique
        number: integer
        configuration: string
        status: string
        executedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Diagnostic {
        id: string @unique
        shotId: string
        instrument: string
        channel: string
        dataRef: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Coil {
        id: string @unique
        name: string
        currentKa: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PlasmaState {
        id: string @unique
        shotId: string
        temperatureKev: float
        densityM3: float
        betaN: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Pulse {
        id: string @unique
        shotId: string
        durationMs: integer
        energyMj: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Sample {
        id: string @unique
        shotId: string
        parameter: string
        value: float
        takenAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
