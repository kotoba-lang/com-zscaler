[{:db/id -1, :skillBand/lexicon 1, :skillBand/id "com.etzhayyim.monosashi.skillBand", :skillBand/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"eval/actor\" \"eval/baseline\" \"eval/as-of\" \"eval/p50\" \"eval/n\" \"eval/point-asserted\"], :properties #:eval{:use {:type \"string\", :enum [\"model-assessment\" \"resilience\" \"planning\" \"research\"], :description \"G2 non-speculative use; trade/position/target are NOT members\"}, :kind {:type \"string\", :const \":skill-band\"}, :coherence {:type \"number\", :description \"OPTIONAL same-series band-width coherence vs a tsuchifumi sysdyn ensemble over the SAME quantity (1 = coherent); a DIAGNOSTIC, not part of the grade. Omitted unless a same-series structural model is supplied.\"}, :n {:type \"integer\", :description \"number of scored forecasts in the band\"}, :p90 {:type \"number\", :description \"90th percentile skill-vs-baseline\"}, :as-of {:type \"string\", :description \"ISO-8601 evaluation boundary; every residual :score/observed-at is REQUIRED and MUST be ≤ this, compared as instants (G5)\"}, :calibration-deviation {:type \"number\", :description \"PIT-histogram deviation Σ|freq−1/bins| (0 = uniform = CALIBRATED; larger = over/under-confident). The mitooshi calibration-summary primitive.\"}, :point-asserted {:type \"boolean\", :const false, :description \"G1 INVARIANT — a skill grade is a BAND, never a point\"}, :p10 {:type \"number\", :description \"10th percentile skill-vs-baseline\"}, :p50 {:type \"number\", :description \"median skill-vs-baseline (>0 ⇒ beats baseline)\"}, :actor {:type \"string\", :description \"predictive actor handle (hakoniwa/mitooshi/tsuchifumi/…)\"}, :baseline {:type \"string\", :description \"G12 — the ONE documented baseline this band's skill is vs (climatology/persistence/random-walk). Bands are grouped per (actor, baseline); skill is never pooled across baselines.\"}, :skilled {:type \"boolean\", :description \"G12 — true ONLY if p50 > 0 vs the documented baseline\"}}}}}"}]
