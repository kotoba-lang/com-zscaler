 ;; ── e-gov SERVICE STANDARD: transactional digital services, COFOG-classed, spec-bound ──
 ;; Each service is universal (country-neutral); countries bind it via :country-profile.
 ;; :spec-basis = OFFICIAL public/international specs ONLY (G2). :invariants encode G1/G3.
 :services
 [;; ===== TAXATION (納税/徴税) — COFOG 01.1 =====
  {:egov.service/id "tax.income.file" :egov.service/domain ":taxation" :egov.service/cofog "01.1"
   :egov.service/en "Income tax return filing" :egov.service/ja "所得税確定申告（納税申告）"
   :egov.service/module "tax-assess"
   :egov.service/spec-basis ["OECD SAF-T (Standard Audit File for Tax)" "OECD CRS/CbCR XML" "ISO 20022 (settlement)" "UN/CEFACT"]
   :egov.service/io {:in ["taxpayer-id" "income-statements" "deductions" "period"] :out ["assessed-liability" "filing-receipt" "payment-instruction"]}
   :egov.service/invariants {:server-held-authority false :spec-derived true}
   :egov.service/maturity ":reference-impl"}
  {:egov.service/id "tax.corporate.file" :egov.service/domain ":taxation" :egov.service/cofog "01.1"
   :egov.service/en "Corporate tax return filing" :egov.service/ja "法人税申告"
   :egov.service/module "tax-assess"
   :egov.service/spec-basis ["OECD SAF-T" "OECD Pillar-Two GloBE XML" "XBRL (financial facts)" "ISO 20022"]
   :egov.service/io {:in ["entity-id" "financial-statements" "adjustments" "period"] :out ["assessed-liability" "filing-receipt"]}
