;; kotoba.app.edn — actor:matsurigoto KOTOBA Mesh application manifest (observatory on-kse, ADR-2606230001 §4).
{:kotoba.app/name    "matsurigoto"
 :kotoba.app/version "0.1.0"
 :kotoba.app/components
 [{:name     "matsurigoto"
   :src      "methods/mesh.clj"                  ; Clojure default → run + on-kse
   :scale    1
   :triggers [{:type :kse :topic "etzhayyim/actor/matsurigoto"}]
   :requires #{:cap/kqe}}
