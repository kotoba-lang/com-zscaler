{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:talent.etzhayyim.com",
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/adr/0018-pii-tier3-cohort-first.md"
  ],
  "convoSystemPrompt": "You are the Talent agent — a global ISCO-08-scoped candidate/workforce registry. You operate under PII Tier 3 (ADR-0018): cohort-first default, individual profiles are opt-in via self-sovereign PDS registration only. You MUST NOT ingest third-party candidate databases (LinkedIn / scraping / purchased lists) — such writes are blocked at the governance gate. Identifying fields (name / email / phone / address) MUST be Signal E2E encrypted (`signal:v1:{ciphertext}`). Cohort statistics (ISCO × country × experience-band) are the default read surface; individual profile access requires consent-gated authorization. You support OrcID / GitHub / public-certification registry ingest (public-consent sources only) for enrichment.",
  "description": "Global ISCO-08 scoped talent registry. PII Tier 3 cohort-first (ADR-0018). Signal E2E on identifying fields. Self-sovereign individual registration only.",
  "displayName": "Talent",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "restricted",
    "piiTier": 3,
    "complianceFrameworks": [
      "gdpr-art-5",
      "gdpr-art-6",
      "gdpr-art-9",
      "gdpr-art-17",
      "jp-apppi",
      "ilo-isco-08"
    ],
    "dataSources": {
      "allowed": [
        "orcid.org",
        "api.github.com",
        "public-certification-registry"
      ],
      "prohibited": [
        "linkedin.com",
        "indeed.com/resumes",
        "third-party-purchased-list",
        "any-scraped-candidate-database"
      ],
      "prohibitedReason": "ADR-0018 PII Tier 3 — only self-sovereign PDS or public-consent source allowed"
    },
    "cohortFirst": true,
    "signalE2ERequiredFields": [
      "fullName",
      "email",
      "phone",
      "address",
      "dateOfBirth",
      "governmentId"
    ],
    "gdprArt17Cascade": true,
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "talent",
  "nanoid": "tl7n3x9p",
  "performerType": "service",
  "pipelines": [
    {
      "trigger": {
        "type": "xrpc",
        "nsid": "com.etzhayyim.apps.talent.listOccupations"
      },
      "steps": [
        {
          "id": "occupations",
          "fn": "graph.query",
          "args": {
            "sql": "MATCH (c:TalentCohort) WHERE ($iscoCode IS NULL OR c.iscoCode = $iscoCode) AND ($country IS NULL OR c.country = $country) RETURN c.iscoCode AS iscoCode, c.country AS country, c.size AS size, c.experienceBand AS experienceBand ORDER BY c.size DESC SKIP $offset LIMIT $limit"
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "xrpc",
        "nsid": "com.etzhayyim.apps.talent.getCohortStats"
      },
      "steps": [
        {
          "id": "cohortStats",
          "fn": "graph.query",
          "args": {
            "sql": "MATCH (c:TalentCohort {iscoCode: $iscoCode, country: $country}) RETURN c.size AS size, c.experienceBand AS experienceBand, c.skillsTop10 AS skillsTop10, c.updatedAt AS updatedAt LIMIT 1"
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "xrpc",
        "nsid": "com.etzhayyim.apps.talent.registerSelf"
      },
      "steps": [
        {
          "id": "consentGate",
          "fn": "agent.invoke",
          "args": {
            "command": "verifyConsent",
            "params": {
              "subjectDid": "$input.caller.did",
              "purpose": "talent-self-registration",
              "piiTier": 3
            }
          }
        },
        {
          "id": "encryptFields",
          "fn": "agent.invoke",
          "depends_on": [
            "consentGate"
          ],
          "args": {
            "command": "signalEncryptFields",
            "params": {
              "subjectDid": "$input.caller.did",
              "fields": "$input.params.identifyingFields"
            }
          }
        },
        {
          "id": "write",
          "fn": "graph.write",
          "depends_on": [
            "encryptFields"
          ],
          "args": {
            "template": "MERGE (p:TalentProfile {subjectDid: $subjectDid, actorDid: $did}) SET p.iscoCode = $iscoCode, p.country = $country, p.experienceBand = $experienceBand, p.skillsPublic = $skillsPublic, p.identifyingEncrypted = $encryptedBlob, p.consentRecordUri = $consentRecordUri, p.createdAt = timestamp()",
            "params": {
              "subjectDid": "$input.caller.did",
              "iscoCode": "$input.params.iscoCode",
              "country": "$input.params.country",
              "experienceBand": "$input.params.experienceBand",
              "skillsPublic": "$input.params.skillsPublic",
              "encryptedBlob": "$encryptFields.ciphertext",
              "consentRecordUri": "$consentGate.consentRecordUri"
            }
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "xrpc",
        "nsid": "com.etzhayyim.apps.talent.forgetSelf"
      },
      "steps": [
        {
          "id": "gdprCascade",
          "fn": "graph.write",
          "args": {
            "template": "MATCH (p:TalentProfile {subjectDid: $subjectDid}) DETACH DELETE p",
            "params": {
              "subjectDid": "$input.caller.did"
            }
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "xrpc",
        "nsid": "com.etzhayyim.apps.talent.stats"
      },
      "steps": [
        {
          "id": "stats",
          "fn": "graph.query",
          "args": {
            "sql": "MATCH (c:TalentCohort) RETURN count(c) AS cohorts, sum(c.size) AS totalTalent LIMIT 1"
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "cron",
        "cron": "0 */6 * * *"
      },
      "steps": [
        {
          "id": "coverageNodes",
          "fn": "graph.query",
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount LIMIT 1"
          }
        },
        {
          "id": "coverageSnapshot",
          "fn": "graph.write",
          "depends_on": [
            "coverageNodes"
          ],
          "args": {
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, status: 'active'})",
            "params": {
              "actorName": "talent",
              "bucket": "6h",
              "nanoid": "tl7n3x9p",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            }
          }
        }
      ]
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "listOccupations",
      "getCohortStats",
      "registerSelf",
      "forgetSelf",
      "stats"
    ],
    "description": "ISCO-08 scoped talent registry (cohort-first, PII Tier 3, self-sovereign).",
    "displayName": "Talent",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.talent.talentCohort",
        "com.etzhayyim.apps.talent.talentProfile"
      ]
    }
  },
  "uiType": "yoro"
}
