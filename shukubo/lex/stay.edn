[{:db/id -1, :lex.stay/lexicon 1, :lex.stay/id "com.etzhayyim.shukubo.stay", :lex.stay/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"stayId\" \"ring\" \"hostDid\" \"kind\" \"sourcing\"], :properties {:availability {:type \"string\", :description \"external ring: available|unavailable|unknown (:representative honesty, G10)\"}, :ring {:type \"string\", :description \"commons|internal|external\"}, :capacity {:type \"integer\", :description \"guests\"}, :hostDid {:type \"string\", :description \"member/actor host DID; external ring = operator DID\"}, :habitability {:type \"string\", :description \"attested space safety: water|heat|egress|accessibility flags (the SPACE is attested, never the person)\"}, :stayId {:type \"string\"}, :costMode {:type \"string\", :description \"free|cost-share|fixed (Ring0=free/cost-share; Ring1=fixed cost-share; NEVER demand-priced)\"}, :title {:type \"string\"}, :currency {:type \"string\", :description \"ISO-4217; internal=USDC\"}, :kind {:type \"string\", :description \"pilgrim-shukubo|member-room|mutual-aid-shelter|actor-operated|external-mirror\"}, :geoDid {:type \"string\", :description \"maps/region DID for location (coarse; exact addr encrypted)\"}, :sourcing {:type \"string\", :description \"authoritative|representative|synthesized (G10)\"}, :costMinor {:type \"integer\", :description \"USDC minor units for the WHOLE stay (flat); 0 for free\"}, :noSurveil {:type \"boolean\", :description \"const true — no in-stay cameras/biometrics (G14)\"}, :operatorUrl {:type \"string\", :description \"external ring ONLY: operator's OWN booking page (member self-books; affiliate-stripped)\"}}}}}"}]
