;; okaimono 御買物 — kotoba EAVT schema
;; ADR-2606012100
;; Provisioning-commons over three rings: product catalog (Ring 0 commons / Ring 1
;; internal / Ring 2 external), member need, multi-source basket, provision record,
;; and end-of-life lifecycle route. All state is kotoba Datoms (no RW/SQL; G6).

[;; ───────────────────────────── :product/* — catalog entry ─────────────────────────────
 {:db/ident :product/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "stable product key, e.g. int.mitsuho.rice-5kg / ext.gtin.04901234567894"}
 {:db/ident :product/title
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :product/ring
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":commons (Ring 0 borrow/repair/secondhand/surplus) | :internal (Ring 1 SBT↔SBT) | :external (Ring 2 world catalog)"}
 {:db/ident :product/unspsc
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "UNSPSC commodity code (reuses the organism vocabulary, ADR-2605231500)"}
 {:db/ident :product/gtin
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "GS1 GTIN-14 (external open-standard catalog), optional"}
 {:db/ident :product/maker-actor
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "for :internal — the producing etzhayyim actor id, e.g. mitsuho / makura / yakushi"}
 {:db/ident :product/source
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "catalog data source: :internal-actor | :open-standard | :vendor-direct | :api-data-only | :scraped"}
 {:db/ident :product/price-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "unit price in minor currency units (internal = USDC 6-dp minor; external = retailer currency minor)"}
 {:db/ident :product/currency
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ISO-4217 (internal = USDC); external retailer currency"}
 ;; Wellbecoming comparison axes (G4) — NOT engagement metrics
 {:db/ident :product/durability-years
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "expected useful life in years (durability axis)"}
 {:db/ident :product/repairability
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "repairability index 0..10 (iFixit-style); higher = better, routes to hodoki"}
 {:db/ident :product/labor-provenance
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":etzhayyim-dignity | :verified-fair | :disclosed | :unknown (G8)"}
 {:db/ident :product/carbon-kg
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "embodied carbon estimate (kg CO2e), :representative"}
 {:db/ident :product/commons-mode
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "Ring 0 only: :borrow | :repair | :secondhand | :surplus"}
 {:db/ident :product/lifecycle-route
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "end-of-life actor (G13): :hodoki | :kanayama | :haraedo | :wakai | :commons-return"}
 {:db/ident :product/sourcing
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":authoritative | :representative (R0 seed honesty, G10)"}
 ;; R2 (ADR-2606012100 §R2) — external-catalog fields (Ring 2)
 {:db/ident :product/retailer-url
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "external ring: retailer deep-link, AFFILIATE-STRIPPED at ingest (G3); self-checkout handoff target"}
 {:db/ident :product/availability
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "external ring: :in-stock | :out-of-stock | :preorder | :unknown (data-only API field)"}
 {:db/ident :product/tariff-bps
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "external ring: cross-border import tariff in basis points (landed-cost input)"}

 ;; ───────────────────────────── :need/* — member need (PII envelope) ─────────────────────────────
 {:db/ident :need/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :need/member-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "DID of consenting member (G1); detail held encrypted com.etzhayyim.encrypted.* (G9)"}
 {:db/ident :need/text
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "natural-language need (encrypted envelope ref at rest; G9)"}
 {:db/ident :need/household-scope
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":individual | :household | :multi-generational (G12)"}
 {:db/ident :need/resolved-ring
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "ring that satisfied the need: :commons | :internal | :external | :unresolved"}

 ;; ───────────────────────────── :basket/* — multi-source basket ─────────────────────────────
 {:db/ident :basket/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :basket/need
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :basket/line
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/many
  :db/doc "ref :basket-line entries"}
 {:db/ident :basket/landed-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "total landed cost (items + shipping + tariff + tithe), minor units"}
 {:db/ident :basket-line/product
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :basket-line/qty
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :basket-line/shipping-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :basket-line/tariff-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}

 ;; ───────────────────────────── :provision/* — provisioning record ─────────────────────────────
 {:db/ident :provision/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :provision/basket
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :provision/ring
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one}
 {:db/ident :provision/settlement
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":commons-none | :usdc-warifu (Ring 1) | :self-checkout-handoff (Ring 2 R0) | :proxy-gated (Ring 2 R3, requires :provision/gate-ref)"}
 {:db/ident :provision/tithe-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "10% TitheRouter auto-split to Public Fund (Ring 1 only; G7)"}
 {:db/ident :provision/gate-ref
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Council Lv7+ / operator authorization ref required for :proxy-gated (G11); absent ⇒ proxy refused"}
 {:db/ident :provision/handoff-uri
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Ring 2 R0 self-checkout deep-link (member pays externally; NO affiliate tag, G3)"}

 ;; ───────────────────────────── :lifecycle/* — end-of-life trajectory ─────────────────────────────
 {:db/ident :lifecycle/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :lifecycle/product
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :lifecycle/stage
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":in-use | :repair | :reuse | :recycle | :dispose | :return — Wellbecoming as-of trajectory, no final state (G13)"}
 {:db/ident :lifecycle/route-actor
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":hodoki | :kanayama | :haraedo | :kurashimori | :wakai"}

 ;; ═════════════════════════════ R1 — Ring 1 internal economy (ADR-2606012100 §R1) ═════════════════════════════
 ;; ───────────────────────────── :order/* — internal order state machine ─────────────────────────────
 {:db/ident :order/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :order/basket
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :order/buyer-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "buyer member DID (must be active Adherent SBT holder, §3 / G2)"}
 {:db/ident :order/maker-actor
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "producing etzhayyim actor (SBT↔SBT counterpart)"}
 {:db/ident :order/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":cart → :placed → :settle-intent → :fulfilling → :delivered → :in-use (as-of trajectory; no terminal :consumed, G13)"}
 {:db/ident :order/settlement
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :order/fulfillment-actor
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "etzhayyim logistics actor (:haraedo | :wadachi | :sarutahiko); never gig labor (G8)"}

 ;; ───────────────────────────── :settlement/* — USDC + TitheRouter intent (NOT executed; G11) ─────────────────────────────
 {:db/ident :settlement/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :settlement/rail
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":usdc-base-l2 (ERC-4337 smart-account via warifu, ADR-2605302000); no fiat (G7)"}
 {:db/ident :settlement/gross-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "USDC minor (6-dp) gross landed cost"}
 {:db/ident :settlement/tithe-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "10% TitheRouter auto-split → Public Fund (G7)"}
 {:db/ident :settlement/maker-payout-minor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "net to producing actor (gross − tithe), USDC minor"}
 {:db/ident :settlement/tithe-router
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "TitheRouter contract ref (50-infra/etzhayyim-tithe-router)"}
 {:db/ident :settlement/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":intent (computed, NOT broadcast) | :executed (operator-broadcast, G11). R1 stops at :intent"}
 {:db/ident :settlement/operator-ref
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "operator/Council authorization to broadcast (G11); absent ⇒ stays :intent"}

 ;; ───────────────────────────── :sbt/* — Adherent SBT eligibility attestation (§3) ─────────────────────────────
 {:db/ident :sbt/holder-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "DID of an Adherent SBT holder (member or producing actor)"}
 {:db/ident :sbt/active
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "active Adherent SBT? both parties must be true for an internal trade (§3 / G2)"}]
