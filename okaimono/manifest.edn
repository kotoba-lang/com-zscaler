;; okaimono 御買物 — actor manifest
;; Global product discovery + provisioning-commons (three concentric rings)
;; ADR-2606012100
{:actor/id        "okaimono"
 :actor/glyph     "御買物"
 :actor/tier      :tier-b
 :actor/domain    "okaimono.etzhayyim.com"
 :actor/purpose   "Amazon-inverse provisioning commons — Ring 0 commons-first (borrow/repair/secondhand/surplus) → Ring 1 internal SBT↔SBT economy over etzhayyim's own producing actors (full list/compare/basket/checkout, USDC+TitheRouter) → Ring 2 external world catalog (discovery+compare now; self-checkout handoff R0; 代理-purchase R3-gated). No ads, no affiliate, no dark-patterns, Murakumo-only, kotoba-EAVT-native."
 :actor/status    :r3
 :actor/adr       "2606012100"

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1"  :gate/name "consent-bound"             :gate/rule "member DID-signed consent before need-capture or any provisioning action"}
  {:gate/id "G2"  :gate/name "value-inflow-boundary"     :gate/rule "no external purchase value INTO etzhayyim; internal trade SBT↔SBT carve-out only (§3); external 代理-purchase R3-gated (Lv7+ amendment OR vendor arm)"}
  {:gate/id "G3"  :gate/name "no-ads-no-affiliate"       :gate/rule "product APIs DATA-ONLY; affiliate tags stripped; zero commission; no sponsored ranking / paid placement (Charter Rider §2)"}
  {:gate/id "G4"  :gate/name "wellbecoming-anti-dark"    :gate/rule "commons-first ordering; no urgency/scarcity/FOMO/dark-patterns; optimize sufficiency+durability+multi-gen, never engagement"}
  {:gate/id "G5"  :gate/name "murakumo-only"             :gate/rule "NL need parsing / semantic match via KotobaLLM 127.0.0.1:4000; no external LLM (ADR-2605215000)"}
  {:gate/id "G6"  :gate/name "kotoba-eavt-native"        :gate/rule "catalog/need/basket/provision are kotoba Datoms; no RisingWave/SQL/Lance as canonical"}
  {:gate/id "G7"  :gate/name "tithe-non-fiat"            :gate/rule "internal settlement USDC Base L2 + ERC-4337 + warifu only; TitheRouter 10% auto-split per transaction; no Stripe/fiat"}
  {:gate/id "G8"  :gate/name "labor-dignity-provenance"  :gate/rule "fulfillment via etzhayyim logistics actors, no gig exploitation; labor-provenance disclosed on external products"}
  {:gate/id "G9"  :gate/name "pii-encrypted-envelope"    :gate/rule "need + provisioning history → com.etzhayyim.encrypted.*, DID-bound (ADR-2605181100)"}
  {:gate/id "G10" :gate/name "catalog-sourcing-legality" :gate/rule "scraping respects robots.txt+ToS+rate-limit+public-only; API ToS honored; :representative honesty; no fabricated price/availability"}
  {:gate/id "G11" :gate/name "outward-gated"             :gate/rule "live scraping ingest + real external 代理-purchase = Council Lv7+ + operator"}
  {:gate/id "G12" :gate/name "anti-individualism"        :gate/rule "household/multi-generational baskets + commons-share first; not individual-consumption-maximizing"}
  {:gate/id "G13" :gate/name "lifecycle-closure"         :gate/rule "every product carries repair/recycle/disposal route (hodoki/kanayama/haraedo); history is Wellbecoming trajectory, no final consumer state"}
  {:gate/id "G14" :gate/name "member-principal"          :gate/rule "assisted checkout: okaimono is NEVER the buyer; member is purchasing principal, pays retailer directly — no external purchase inflow (§1.3 preserved without amendment)"}
  {:gate/id "G15" :gate/name "no-server-key"             :gate/rule "member signs each payment with own passkey/ERC-4337 smart-account; okaimono holds no card secret/key (ADR-2605231525); server signature refused"}]

 :actor/cells
 [{:cell/id "catalog"   :cell/kind :datalog   :cell/runtime :kotoba}
  {:cell/id "discover"  :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "compare"   :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "basket"    :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "provision" :cell/kind :langgraph :cell/runtime :wasm}
  {:cell/id "lifecycle" :cell/kind :datalog   :cell/runtime :kotoba}]

 :actor/lexicons
 ["com.etzhayyim.okaimono.product"
