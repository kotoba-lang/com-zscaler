  "com.etzhayyim.okaimono.basket"
  "com.etzhayyim.okaimono.provision"
  "com.etzhayyim.okaimono.order"        ;; R1
  "com.etzhayyim.okaimono.settlement"   ;; R1
  "com.etzhayyim.okaimono.assist"]      ;; R3 — assisted secure checkout (member-principal)

