[{:db/id -1, :listing/lexicon 1, :listing/id "com.etzhayyim.omise.listing", :listing/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"listingId\" \"storefrontId\" \"sellerDid\" \"title\" \"priceMinor\" \"laborProvenance\"], :properties {:carbonKg {:type \"number\"}, :lifecycleRoute {:type \"string\", :description \"hodoki|kanayama|haraedo|wakai|commons-return\"}, :priceMinor {:type \"integer\", :description \"USDC minor units; no take-rate added (G2)\"}, :ring {:type \"string\", :description \"const internal (okaimono Ring-1 coherence, G11)\"}, :listingId {:type \"string\"}, :makerActor {:type \"string\", :description \"etzhayyim producing actor (maps to okaimono :product/maker-actor)\"}, :fulfilmentActor {:type \"string\", :description \"logistics actor for handoff (todoke/…), G8\"}, :title {:type \"string\"}, :inventory {:type \"integer\", :description \"on-hand units; honest count (no false scarcity, G5)\"}, :currency {:type \"string\", :description \"const USDC for internal ring\"}, :unspsc {:type \"string\"}, :storefrontId {:type \"string\"}, :sellerDid {:type \"string\", :description \"producing-actor id OR SBT member DID (G3)\"}, :sourcing {:type \"string\", :description \"authoritative|representative\"}, :gtin {:type \"string\"}, :durabilityYears {:type \"number\"}, :laborProvenance {:type \"string\", :description \"etzhayyim-dignity|verified-fair|disclosed (G8)\"}, :repairability {:type \"integer\", :description \"0..10 iFixit-style (surfaced for Wellbecoming ordering, G5)\"}}}}}"}]
