{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:omise.etzhayyim.com",
  "actors": [
    {
      "description": "ISCO 1120 — seller approval, suspension, governance",
      "displayName": "Platform Admin",
      "path": "actor:platformAdmin"
    },
    {
      "description": "ISCO 4222 — dispute resolution, escalated CS",
      "displayName": "Platform Support",
      "path": "actor:platformSupport"
    },
    {
      "description": "ISCO 3339 — registration, KYC, profile setup",
      "displayName": "Seller Onboarding",
      "path": "actor:sellerOnboarding"
    },
    {
      "description": "ISCO 5221 — product listing, pricing, inventory",
      "displayName": "Seller Catalog",
      "path": "actor:sellerCatalog"
    },
    {
      "description": "ISCO 4321 — order processing, packing, ship-ready",
      "displayName": "Seller Fulfillment",
      "path": "actor:sellerFulfillment"
    },
    {
      "description": "ISCO 3313 — settlement, payout, revenue",
      "displayName": "Seller Finance",
      "path": "actor:sellerFinance"
    },
    {
      "description": "ISCO 2431 — coupons, promotions, campaigns",
      "displayName": "Seller Marketing",
      "path": "actor:sellerMarketing"
    },
    {
      "description": "ISCO 5223 — cart, checkout, order tracking",
      "displayName": "Buyer Assistant",
      "path": "actor:buyerAssistant"
    },
    {
      "description": "ISCO 2641 — product reviews, ratings",
      "displayName": "Buyer Review",
      "path": "actor:buyerReview"
    },
    {
      "description": "ISCO 4323 — shipment, carrier integration",
      "displayName": "Logistics",
      "path": "actor:logistics"
    },
    {
      "description": "ISCO 2120 — platform + seller KPI analytics",
      "displayName": "Analyst",
      "path": "actor:analyst"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Omise EC marketplace agent. You operate a Shopify-like multi-tenant marketplace with Platform (governance), Seller (onboarding/catalog/fulfillment/finance/marketing), and Buyer (cart/checkout/review) actors. Checkout uses SAGA pattern: validateCart > checkInventory > reserveStock > applyCoupon > kakin.etzhayyim.com processPayment > confirmOrder. Settlement deducts commission and transfers via kakin payout.",
  "description": "Shopify-like multi-tenant EC marketplace with Platform/Seller/Buyer three-party structure. Seller onboarding, catalog management, checkout SAGA, settlement flow, logistics, reviews, coupons. 11 ISCO-mapped actor DIDs. kagami P10v2 GraphAr-native storage.",
  "displayName": "Omise EC Marketplace",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "omise",
  "nanoid": "om1s3sh0p",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (o:OmiseOrder) WHERE o.created_at > datetime() - duration('P1D') RETURN o.status AS status, count(o) AS total, sum(o.total_amount) AS revenue LIMIT 10"
          },
          "fn": "graph.query",
          "id": "dailyAnalytics"
        },
        {
          "args": {
            "sql": "MATCH (s:OmiseSeller {status: 'pending'}) RETURN count(s) AS pending LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "pendingSellers"
        },
        {
          "args": {
            "message": "You are Omise EC Marketplace. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $pendingSellers.rows"
          },
          "depends_on": [
            "pendingSellers"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 0 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "message": "You are Omise EC Marketplace. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $input.record"
          },
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "notifySeller"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.omise.order"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "message": "New product review: rating=$input.record.rating, comment=$input.record.comment. Summarize sentiment and flag if rating <= 2."
          },
          "fn": "agent.chat",
          "id": "reviewAnalysis"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.omise.review"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "omise",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.omise.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "om1s3sh0p",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        },
        {
          "args": {
            "message": "You are Omise EC Marketplace. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $coverageSnapshot.text"
          },
          "depends_on": [
            "coverageSnapshot"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.omise.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "register-seller",
      "create-product",
      "create-order",
      "submit-review",
      "create-shipment",
      "request-payout",
      "platform-analytics"
    ],
    "description": "Multi-tenant EC marketplace. Seller onboarding/catalog/fulfillment/finance, buyer cart/checkout/review, logistics, SAGA payment via kakin.etzhayyim.com.",
    "displayName": "Omise EC Marketplace",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.omise.seller",
        "com.etzhayyim.apps.omise.product",
        "com.etzhayyim.apps.omise.order",
        "com.etzhayyim.apps.omise.shipment",
        "com.etzhayyim.apps.omise.review"
      ]
    }
  },
  "uiType": "yoro"
}
