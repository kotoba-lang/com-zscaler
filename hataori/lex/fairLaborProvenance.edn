[{:db/id -1, :lex.fairLaborProvenance/lexicon 1, :lex.fairLaborProvenance/id "com.etzhayyim.hataori.fairLaborProvenance", :lex.fairLaborProvenance/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"lotId\" \"displacedCohortId\" \"noWorkerBelowBhi\" \"createdAt\"], :properties {:lotId {:type \"string\", :description \"finished garment lot id\"}, :displacedCohortId {:type \"string\", :description \"displacement cohort this line's automation created (ADR-2606032130); links to the dividend\"}, :noWorkerBelowBhi {:type \"boolean\", :const true, :description \"G9 invariant — no displaced worker re-employed below the Basic-High-Income standard; the actor exists to END sweatshop labour, never to recreate it\"}, :dividendAttested {:type \"boolean\", :description \"displaced cohort registered for the tenure-weighted Displacement Dividend (G2)\"}, :fiberSource {:type \"string\", :description \"fiber provenance (sanae/open supplier; :representative)\"}, :createdAt {:type \"string\", :format \"datetime\"}}}}}"}]