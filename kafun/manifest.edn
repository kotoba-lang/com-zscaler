;; kafun 花粉 — actor manifest (clj-native, kotoba-Datom-native)
;; 花粉撲滅 remediation actor: 撲滅 = ecological RESTORATION (主伐再造林), never
;; deforestation-for-profit. The clj-native Tier-B actor-ization of the legacy
;; 60-apps/etzhayyim-project-public-kafun-bokumetsu pipeline (ADR-2605100100 +
;; 2605210928). ADR-2606211712 (R0).
{:actor/id        "kafun"
 :actor/glyph     "花"
 :actor/tier      :tier-b
 :actor/integrates ["inochi" "iyashi" "kamado" "mitate" "musubi" "sanae"]
 :actor/domain    "kafun.etzhayyim.com"
 :actor/kind      :pollen-remediation-gate
 :actor/purpose   "花粉撲滅 remediation gate. Edge-primary pollen-source concentration (stand-area × emission-density × exposed-population-weight, on read) routed to REMEDIATION. A forest STAND is routed for remediation ONLY by passing the gate: refuse a 主伐 without 再造林 (撲滅 is RESTORATION, not deforestation) / net-positive carbon; await landowner consent (land sovereignty); selective-only on protected (watershed/steep/habitat) stands; await 無花粉苗木 supply (the L1-1 bottleneck); else reforest-priority (主伐再造林, the L3-1 bottleneck). ASSESSMENT + R0 DESIGN ONLY — kafun never cuts and never plants; live forestry is the landowner's + operator/Council step. The clj-native Tier-B actor-ization of the legacy kafun-bokumetsu pipeline (scout→cadastral→envoy). Routes to sanae (planting robotics) / inochi (biosphere restoration) / mitate + iyashi (allergic-rhinitis care)."
 :actor/status    :r0
 :actor/adr       "2606211712"
 :actor/related   ["2605100100" "2605210928" "2606073000" "2606032100" "2605260115" "2605262130" "2605192245" "2606201200" "2607102230"]

 :actor/charter-rider
 {:rider/version "3.5"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1" :gate/name "remediation-is-restoration" :gate/rule "撲滅 = 主伐再造林 (RESTORATION); a 主伐 without 再造林 → :refuse :clearcut-without-reforest; :kafun/clearcut + :kafun.stand/eradicate-species unrepresentable (test-enforced)"}
  {:gate/id "G2" :gate/name "map-not-cut-list-no-person-data" :gate/rule "A restoration worklist, NEVER a cut-list/target-list; cohorts aggregate; :kafun.person/health unrepresentable (no individual health/biometric)"}
  {:gate/id "G3" :gate/name "consent-land-sovereignty" :gate/rule "No remediation without landowner + community consent (ADR-2605192245); absent → :await-consent"}
  {:gate/id "G4" :gate/name "carbon-balance-2d" :gate/rule "Net of the 再造林 recapture; net-positive carbon → :refuse :carbon-positive (§2(d))"}
  {:gate/id "G5" :gate/name "assessment-r0-only-never-acts" :gate/rule "Assessment + R0 design only; no actuation; :kafun/actuate unrepresentable; live forestry is the landowner's + operator/Council step"}
  {:gate/id "G6" :gate/name "no-server-key-no-network" :gate/rule "Platform holds no key; the heartbeat performs no network I/O — appends to a local ledger only"}
  {:gate/id "G7" :gate/name "synthetic-seed" :gate/rule "R0 seed is :synthetic; real cadastral/satellite-derived stands are an operator/Council step (the legacy scout→cadastral→envoy pipeline behind an operator flip)"}
  {:gate/id "G8" :gate/name "kotoba-eavt-native" :gate/rule "State is kotoba EAVT Datoms; verdict datoms flagged :kafun/derived + :kafun/sourcing"}]

 :actor/non-goals
 [{:n/id "N1" :n/rule "Never actually cuts/plants/sprays (R0 assessment + design; live actuation unrepresentable)"}
  {:n/id "N2" :n/rule "Not a deforestation tool AND not a do-nothing observatory — a real remediation gate (refuses non-restorative cuts AND prioritizes restoration)"}
  {:n/id "N3" :n/rule "Never targets species for extermination; 撲滅 acts on the 花粉 burden via restoration, not on the cedar as an enemy"}
  {:n/id "N4" :n/rule "No medical diagnosis/treatment of allergy — that is mitate (route) + iyashi (care)"}
  {:n/id "N5" :n/rule "No person-level data; aggregate cohort/stand-level only"}]

 :actor/methods
 [{:method/id "kafun_edn" :method/file "methods/kafun_edn.cljc" :method/role "seed loader + classify"}
  {:method/id "remediate" :method/file "methods/remediate.cljc" :method/role "pollen-burden → verdict → assess → render-datoms → render-report (+ bb CLI)"}
  {:method/id "kotoba"    :method/file "methods/kotoba.cljc"    :method/role "持続永続化: content-addressed append-only REMEDIATION LEDGER (tx-cid/make-tx/append-tx/read-log/verify-chain)"}
  {:method/id "autorun"   :method/file "methods/autorun.cljc"   :method/role "持続永続化: deterministic, idempotent-by-content heartbeat — assess → append verdict datoms to the ledger (+ bb CLI)"}
  {:method/id "ie_flow"   :method/file "methods/ie_flow.cljc"   :method/role "SoS: embeds shared etzhayyim.ie-flow.metrics (order calculus) + renders energy-flow viz — assessment → measured flow events → order-index/η + viz/energy-flow.html (ADR-2606212030)"}
  {:method/id "digest"    :method/file "methods/digest.cljc"    :method/role "Murakumo-narrated remediation digest (ibuki/colony-digest pattern): digest-data → narrate (injected infer, FAIL-OPEN template G6; loopback-only murakumo-infer) → :digest/* datoms (:digest/status :dry-run ONLY, G8)"}
  {:method/id "dynamics"    :method/file "methods/dynamics.cljc"    :method/role "kafun's OWN remediation-readiness stock-flow (system dynamics): step-system/simulate/counterfactual, re-scored through the UNCHANGED remediate/verdict (ADR-2607102230)"}
  {:method/id "react_loop"  :method/file "methods/react_loop.cljc"  :method/role "SD ReAct beat: SENSE→ORIENT→HYPOTHESIZE→REVIEW→RANK→EVOLVE→ACT→OBSERVE→LEARN→PERSIST over the readiness stock-flow; ACT is a pre-registered forecast + propose-only route (never actuation, G5) (+ bb CLI; ADR-2607102230)"}
  {:method/id "cell"      :method/file "cell.cljc"             :method/role "fleet heartbeat cell — `fire` runs one deterministic, idempotent-by-content remediation beat (autorun/beat); no-server-key, no external I/O"}]

 :actor/fleet
 {:cell/name "KafunRemediationHeartbeatCell"
  :cell/module "kafun.cell"
  :cell/entry "fire"
  :cell/node "simeon"
  :cell/cron "31 * * * *"
  :cell/healthz-port 13091
  :cell/registry "50-infra/cluster/murakumo/cell-runner/cells.edn"
  :cell/note "one deterministic remediation beat per fire; idempotent-by-content (unchanged = no-op); no-server-key; --live Murakumo digest + live-engine bridge stay operator/Council-gated"}

 :actor/ie-flow
 {:flow/adopted true
  :flow/adr "2606212030"
  :flow/registry "80-data/ie-flow/registry.edn"
  :flow/viz "viz/energy-flow.html"
  :flow/note "kafun RECTIFIES (整流) scattered pollen-burden (disorder) into prioritized restoration order; embeds the SHARED ie-flow metrics (not a fork). Synthetic-seed result: order-index 0.320, η 6.58×, net-gain +133.9, non-parasitic. Verdict sinks feed sanae/inochi/musubi/kamado = the system of systems. Live record!/beat! to 80-data/ie-flow/kafun/flow.kotoba.edn (gitignored) is the heartbeat/operator step."}

 :actor/lex
 [{:lex/id "remediationVerdict" :lex/nsid "com.etzhayyim.kafun.remediationVerdict"
   :lex/file "00-contracts/lexicons/com/etzhayyim/kafun/remediationVerdict.json"}
  {:lex/id "pollenRemediationMap" :lex/nsid "com.etzhayyim.kafun.pollenRemediationMap"
   :lex/file "00-contracts/lexicons/com/etzhayyim/kafun/pollenRemediationMap.json"}]

 :actor/ledger
 {:ledger/file "data/persisted/kafun.remediation.kotoba.edn"
  :ledger/kind :append-only-content-addressed-commit-dag
  :ledger/gitignored true
  :ledger/note "Generated remediation ledger of 花粉撲滅 verdicts; tamper-evident (verify-chain); no-server-key; a record of restoration DECISIONS, never a cut-list."}

 :actor/seed
 {:seed/file "kotoba/seed.edn"
  :seed/ontology "kotoba/ontology.kafun.edn"
  :seed/sourcing :synthetic
  :seed/verdicts [:refuse :await-consent :protected-selective :await-sapling-supply :reforest-priority :monitor]}

 :actor/tests
 {:runner "babashka"
  :cmd "./20-actors/kafun/run_tests.sh"
  :suites ["methods/test_kafun_edn.cljc" "methods/test_remediate.cljc"
           "methods/test_kotoba.cljc" "methods/test_autorun.cljc"
           "methods/test_ie_flow.cljc" "methods/test_digest.cljc"
           "methods/test_bottleneck.cljc" "methods/test_dynamics.cljc"
           "methods/test_react_loop.cljc"]}}
