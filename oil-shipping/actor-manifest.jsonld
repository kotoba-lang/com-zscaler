{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:oil-shipping.etzhayyim.com",
  "actors": [
    {
      "description": "VLCC, Suezmax and Aframax crude shipping coverage.",
      "displayName": "Crude Tanker Fleet",
      "path": "fleet:crude-tanker"
    },
    {
      "description": "Clean product tanker coverage.",
      "displayName": "Product Tanker Fleet",
      "path": "fleet:product-tanker"
    },
    {
      "description": "Hormuz, Suez, Bab el-Mandeb, Malacca and Bosporus exposure.",
      "displayName": "Chokepoint Monitor",
      "path": "route:chokepoints"
    },
    {
      "description": "AIS anomaly and sanctions-sensitive fleet monitoring.",
      "displayName": "Dark Fleet Risk",
      "path": "risk:dark-fleet"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Oil Shipping agent. Track crude and product tanker flows, correlate cargoes with vessels and terminals, monitor chokepoints like Hormuz, Bab el-Mandeb, Suez and Malacca, and flag sanction or dark-fleet exposure.",
  "description": "Crude and product tanker routing, STS transfer tracking, chokepoint exposure, cargo load/discharge intelligence, and dark-fleet risk monitoring.",
  "displayName": "Oil Shipping & Tanker Intelligence",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "IMO Conventions",
      "MARPOL",
      "ISPS Code",
      "OFAC Sanctions"
    ],
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "oil-shipping",
  "nanoid": "01l5h1p0",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:OilCargo) RETURN c.commodity AS commodity, count(c) AS count, sum(c.quantity) AS totalQty ORDER BY totalQty DESC LIMIT 20"
          },
          "fn": "graph.query",
          "id": "cargoStats"
        },
        {
          "args": {
            "sql": "MATCH (f)-[e:flowsTo]->(t) RETURN e.label AS route, count(e) AS edges LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "routeStats"
        },
        {
          "args": {
            "sql": "MATCH (s:Ship) WHERE s.riskLevel IN ['high', 'critical'] RETURN s.imoNumber AS imo, s.riskLevel AS risk, s.flagState AS flag LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "riskFlags"
        },
        {
          "args": {
            "message": "Oil shipping report.\n\nCargo stats:\n$cargoStats.rows\n\nRoute stats:\n$routeStats.rows\n\nRisk flags:\n$riskFlags.rows\n\nSummarize the main cargo corridors, chokepoints, and sanction-sensitive shipping risks."
          },
          "depends_on": [
            "cargoStats",
            "routeStats",
            "riskFlags"
          ],
          "fn": "agent.chat",
          "id": "analyze"
        },
        {
          "args": {
            "template": "Oil shipping report: $analyze.text"
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */8 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:OilCargo {discharge_port: $input.record.portLocode}) RETURN c.cargo_id AS cargoId, c.commodity AS commodity, c.quantity AS quantity LIMIT 20"
          },
          "fn": "graph.query",
          "id": "matchCargoAtPort"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.vessel.portCall"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:OilCargo {cargo_id: $input.cargoId}) RETURN c.vertex_id, c.repo, c.collection, c.status LIMIT 1"
          },
          "fn": "graph.query",
          "id": "cargo"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilShipping.routing.getCargo",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:OilCargo) RETURN c.vertex_id, c.repo, c.collection, c.status LIMIT 50"
          },
          "fn": "graph.query",
          "id": "cargoes"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilShipping.routing.listCargoes",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s)-[e:flowsTo {label: $input.route}]->(t) RETURN e.edge_id, e.commodity, e.volume, e.unit LIMIT 50"
          },
          "fn": "graph.query",
          "id": "flows"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilShipping.routing.getRouteExposure",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:OilTerminal) WHERE t.terminal_type = 'chokepoint' RETURN t.vertex_id, t.repo, t.collection, t.status LIMIT 20"
          },
          "fn": "graph.query",
          "id": "chokepoints"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilShipping.routing.listChokepoints",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:OilCargo) RETURN count(c) AS cargoes LIMIT 1"
          },
          "fn": "graph.query",
          "id": "stats"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilShipping.health",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "oil-shipping",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.oilShipping.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "01l5h1p0",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "cargo-routing",
      "tanker-tracking",
      "chokepoint-risk",
      "sts-transfer-monitoring",
      "dark-fleet-screening"
    ],
    "description": "Tracks crude tanker, product tanker, LNG and LPG maritime flows. Links cargo, vessel, terminal, port, route and sanctions-sensitive shipping exposure.",
    "displayName": "Oil Shipping & Tanker Intelligence",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.oilShipping.cargo",
        "com.etzhayyim.apps.oilShipping.route",
        "com.etzhayyim.apps.oilShipping.stsTransfer",
        "com.etzhayyim.apps.vessel.voyage",
        "com.etzhayyim.apps.vessel.portCall",
        "com.etzhayyim.apps.port.portCallEvent"
      ]
    }
  },
  "uiType": "yoro"
}
