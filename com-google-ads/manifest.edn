;; com-google-ads (広) — actor manifest (kotoba-native)
;; Charter-clean outreach & performance-marketing actor. The buy/create side of the
;; akashi (証) disclose/verify loop. Proposes campaign/bid/budget/creative; publishes
;; ONLY after human (finance/Council) sign-off; targets cohorts, never individuals.
;; ADR-2606292130 (R0 scaffold).
{:actor/id          "com-google-ads"
 :actor/glyph       "広"
 :actor/display-name "広 — Charter-Clean Outreach & Performance Marketing"
 :actor/tier        :tier-b
 :actor/integrates ["akashi" "danjo" "isco" "moushibumi" "talent" "toritate"]
 :actor/domain      "com-google-ads.etzhayyim.com"
 :actor/purpose     "kotoba-native charter-clean outreach & performance-marketing actor. Plans and PROPOSES the org's own outreach campaigns (mission amplification: events, publications, mutual-aid drives, land-sovereignty appeals, donation drives); publishes only after human finance/Council sign-off. Cohort-scale only — no individual targeting/profiling/retargeting, no tracking pixel, no purchased/scraped audiences. The buy/create side of the akashi 証 disclose/verify loop: every published creative + spend range is mirrored to akashi as the org's own disclosure. Murakumo-only narration. Mission-bound (no audience/lead resale, no competitor-intel SaaS)."
 :actor/status      :r0
 :actor/adr         "2606292130"
 :actor/parent-actor nil
 :actor/cross-actor
 {:upstream   "talent (self-sovereign opt-in cohort supply), isco (occupation taxonomy)"
  :peer       "akashi 証 (disclosure mirror target — the one-loop buy/disclose pair), moushibumi (shared no-political-profiling boundary)"
  :downstream "toritate (ledger — spend records), danjo (public accountability — spend transparency)"
  :bounded-away "malak (no CTI / no ad-fraud case creation; fraud/malware landing evidence routes akashi→malak, not com-google-ads→malak)"}

 :actor/gates
 [{:gate/id "G1" :gate/name "propose-not-actuate"        :gate/rule "campaign/bid/budget/creative PUBLISH requires human (finance/Council) sign-off via interrupt-before #{:request-approval}; the actor only proposes. The MRC analog is a zero-spend pause when governance fails or confidence is low."}
  {:gate/id "G2" :gate/name "cohort-scale-only"          :gate/rule "no :person/* individual targeting, profiling, retargeting, or cross-site identity exists; audiences are aggregate cohorts; anti-surveillance is structural (the schema has no individual-profile attribute to misuse)"}
  {:gate/id "G3" :gate/name "consent-gated-audience"     :gate/rule "audiences from self-sovereign opt-in + public-credential enrichment ONLY (talent G1 lineage); purchased/scraped/third-party PII refused, license notwithstanding; identifying fields are signal:v1: ciphertext (ADR-2605181100); forgetAudience is GDPR Art 17 cascade HARD delete (no :_alive flag)"}
  {:gate/id "G4" :gate/name "spend-append-only-finance-signed" :gate/rule "every spend/bid/impression is a durable EAVT datom, finance DID-signed; no silent/off-book spend; spend is never mutated, only appended/retracted-with-attestation"}
  {:gate/id "G5" :gate/name "anti-manipulation"          :gate/rule "no microtargeting of protected categories (religion/ethnicity/health/politics/sexual-orientation/age-inferred-minor); no dark patterns; no deceptive creatives; creative review gate precedes publish"}
  {:gate/id "G6" :gate/name "murakumo-only-narration"    :gate/rule "all NL narration routes through the Murakumo LiteLLM loopback (ADR-2605215000); deterministic offline fallback when unreachable; never an external/vendor LLM"}
  {:gate/id "G7" :gate/name "akashi-transparency-mirror" :gate/rule "every published creative + spend range is mirrored to akashi 証 as the org's own disclosure; buy/create side and disclose/verify side are one loop — the org discloses what it amplifies"}
  {:gate/id "G8" :gate/name "no-ad-sdk-no-tracking-pixel" :gate/rule "no Meta Pixel / GA4 ads / third-party ad SDK / affiliate tracking code in org properties; first-party aggregate ingestion only"}
  {:gate/id "G9" :gate/name "no-commercial-resale"       :gate/rule "no audience/lead resale, no competitor-intel SaaS; outreach is mission-bound; surplus reach → community-benefit credit only (not a paid targeting terminal)"}]

 :actor/non-goals
 ["individual behavioral targeting / profiling / retargeting (G2)"
  "cross-site tracking pixel / third-party ad SDK / affiliate tracking code (G8)"
  "auto-actuated spend without human sign-off (G1)"
  "purchased / scraped / third-party PII audiences (G3)"
  "microtargeting protected categories / dark patterns / deceptive creatives (G5)"
  "vendor / external LLM narration (G6)"
  "audience or lead resale / competitor-intel SaaS (G9)"
  "CTI / ad-fraud case creation (bounded to malak via akashi)"
  "voter persuasion / political profiling (shared boundary with moushibumi / akashi G4)"]

 :actor/allowed-enrichment ["orcid" "github-public" "public-credential-registry"]   ; talent-lineage
 :actor/prohibited-sources  ["linkedin" "indeed" "glassdoor" "purchased-list" "scraped-db" "third-party-cookie-graph" "data-broker"]

 :actor/cells
 [{:cell/id "googleads.audience"   :cell/kind :datalog   :cell/runtime :kotoba :cell/doc "self-sovereign opt-in cohort registry, k-anonymity, hard-deletable (G3). Cohorts flow in from talent's consented registry; no individual profile attribute exists (G2)."}
  {:cell/id "googleads.propose"    :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "proposal-only campaign planner. Sealed Murakumo LLM advisor returns campaign+bid+budget+creative PROPOSALS; independent PolicyGovernor checks G2/G3/G5; interrupt-before #{:request-approval} for finance sign-off (G1). Never publishes."}
  {:cell/id "googleads.performance" :cell/kind :datalog  :cell/runtime :kotoba :cell/doc "aggregate-first performance read (impressions/clicks/conversions by cohort); flags :bond/is-transient — read-time aggregates, never durable verdicts (G2, itonami-G3 lineage)."}
  {:cell/id "googleads.spend"      :cell/kind :datalog   :cell/runtime :kotoba :cell/doc "append-only spend ledger, finance DID-signed (G4); the audit trail; promotion gates are Datalog queries over this log."}
  {:cell/id "googleads.disclose"   :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "mirrors every published creative + spend range to akashi 証 (G7) and spend records to toritate/danjo. The buy→disclose half-loop."}]

 :actor/lexicons
 ["com.etzhayyim.googleads.campaign"
  "com.etzhayyim.googleads.audience"
  "com.etzhayyim.googleads.creative"
  "com.etzhayyim.googleads.performanceReport"
  "com.etzhayyim.googleads.spendRecord"
  "com.etzhayyim.googleads.proposal"]

 :actor/commands
 [{:cmd/id "proposeCampaign"      :cmd/nsid "com.etzhayyim.apps.googleads.proposeCampaign"      :cmd/access "operator"   :cmd/doc "propose a campaign (G1 — proposal only, never publish)"}
  {:cmd/id "approveProposal"      :cmd/nsid "com.etzhayyim.apps.googleads.approveProposal"      :cmd/access "finance"    :cmd/doc "human sign-off to publish (G1/G4); finance DID"}
  {:cmd/id "registerAudience"     :cmd/nsid "com.etzhayyim.apps.googleads.registerAudience"     :cmd/access "caller=cohort-owner" :cmd/doc "self-sovereign opt-in cohort (G3)"}
  {:cmd/id "forgetAudience"       :cmd/nsid "com.etzhayyim.apps.googleads.forgetAudience"       :cmd/access "caller=cohort-owner" :cmd/doc "GDPR Art 17 cascade HARD delete (G3)"}
  {:cmd/id "getCohortPerformance" :cmd/nsid "com.etzhayyim.apps.googleads.getCohortPerformance" :cmd/access "public-aggregate" :cmd/doc "aggregate performance by cohort (G2)"}
  {:cmd/id "listSpend"            :cmd/nsid "com.etzhayyim.apps.googleads.listSpend"            :cmd/access "audit"      :cmd/doc "append-only spend ledger read (G4)"}
  {:cmd/id "discloseCreative"     :cmd/nsid "com.etzhayyim.apps.googleads.discloseCreative"     :cmd/access "system"     :cmd/doc "mirror creative + spend range to akashi 証 (G7)"}]

 :actor/cohort {:k-anonymity 5 :path "did:web:com-google-ads.etzhayyim.com:cohort:{isco}:{country}"}
 :actor/did    "did:web:etzhayyim.github.io:com-google-ads"
 :actor/repo   "github.com/etzhayyim/com-google-ads"}
