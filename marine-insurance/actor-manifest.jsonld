{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:marine-insurance.etzhayyim.com",
  "actors": [
    {
      "description": "Ship hull, engines, equipment damage/loss coverage (IHC 2003)",
      "displayName": "Hull & Machinery",
      "path": "hull:machinery"
    },
    {
      "description": "Protection & Indemnity — crew injury, cargo damage, pollution, wreck removal (13 IG Clubs)",
      "displayName": "P&I Club",
      "path": "pi:club"
    },
    {
      "description": "ICC (A/B/C), warehouse-to-warehouse coverage",
      "displayName": "Cargo Insurance",
      "path": "cargo:insurance"
    },
    {
      "description": "War, strikes, terrorism, piracy coverage — JWC listed areas",
      "displayName": "War Risk",
      "path": "war:risk"
    },
    {
      "description": "York-Antwerp Rules — sacrifice/expenditure apportionment",
      "displayName": "General Average Adjuster",
      "path": "ga:adjuster"
    },
    {
      "description": "Marine claims lifecycle — notification, survey, adjustment, settlement",
      "displayName": "Claims Handler",
      "path": "claims:handler"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Marine Insurance agent. You manage Hull & Machinery policies, P&I Club entries, Cargo insurance, War Risk covers, and General Average declarations. Track policy lifecycle (quote→bind→active→renew), claims (notify→investigate→adjust→settle), and P&I calls. Link to vessel.etzhayyim.com for insured vessel details and legal-entity.etzhayyim.com for underwriter/club identity.",
  "description": "Hull & Machinery, Protection & Indemnity (P&I), Cargo insurance, War Risk, General Average. Full marine insurance lifecycle from quotation to claims settlement.",
  "displayName": "Marine Insurance & P&I Intelligence",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "Institute Cargo Clauses",
      "Institute Time Clauses",
      "York-Antwerp Rules",
      "IHC 2003"
    ],
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "marine-insurance",
  "nanoid": "m1ns0001",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy) RETURN p.policyType AS type, p.status AS status, count(p) AS count, sum(p.insuredValueUsd) AS totalValue ORDER BY totalValue DESC LIMIT 20"
          },
          "fn": "graph.query",
          "id": "policyStats"
        },
        {
          "args": {
            "sql": "MATCH (c:MarineClaim) WHERE c.status IN ['notified', 'under-investigation', 'adjusted'] RETURN c.lossType AS lossType, count(c) AS count, sum(c.claimedAmountUsd) AS totalClaimed LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "openClaims"
        },
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy {status: 'active'}) WHERE p.expiryDate <= toString(datetime() + duration('P60D')) RETURN p.policyNumber AS policy, p.policyType AS type, p.vesselImo AS vessel, p.expiryDate AS expiry ORDER BY p.expiryDate ASC LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "expiringPolicies"
        },
        {
          "args": {
            "message": "Marine insurance weekly report.\n\nPolicy portfolio:\n$policyStats.rows\n\nOpen claims:\n$openClaims.rows\n\nPolicies expiring within 60 days:\n$expiringPolicies.rows\n\nAssess portfolio risk exposure, highlight critical claims, and flag renewal priorities."
          },
          "depends_on": [
            "policyStats",
            "openClaims",
            "expiringPolicies"
          ],
          "fn": "agent.chat",
          "id": "analyze"
        },
        {
          "args": {
            "template": "Marine insurance report: $analyze.text"
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 8 * * 1",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy {vesselImo: $input.record.imoNumber, status: 'active'}) RETURN p.policyType AS type, p.expiryDate AS expiry LIMIT 10"
          },
          "fn": "graph.query",
          "id": "checkCoverage"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.vessel.ship"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy {policyId: $input.policyId}) RETURN p.vertex_id, p.rkey, p.repo, p.did, p.status, p.props, p._seq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "policy"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineInsurance.underwriting.getPolicy",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy) RETURN p.vertex_id, p.rkey, p.repo, p.did, p.status, p.props, p._seq ORDER BY p.inceptionDate DESC LIMIT 50"
          },
          "fn": "graph.query",
          "id": "policies"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineInsurance.underwriting.listPolicies",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:MarineClaim) RETURN c.vertex_id, c.rkey, c.repo, c.did, c.status, c.props, c._seq ORDER BY c.incidentDate DESC LIMIT 50"
          },
          "fn": "graph.query",
          "id": "claims"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineInsurance.underwriting.listClaims",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (e:PiEntry {vesselImo: $input.vesselImo}) RETURN e.vertex_id, e.rkey, e.repo, e.did, e.status, e.props, e._seq ORDER BY e.entryDate DESC LIMIT 20"
          },
          "fn": "graph.query",
          "id": "entries"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineInsurance.underwriting.listPiEntries",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy {vesselImo: $input.vesselImo, status: 'active'}) RETURN p.vertex_id, p.rkey, p.repo, p.did, p.status, p.props, p._seq LIMIT 20"
          },
          "fn": "graph.query",
          "id": "policies"
        },
        {
          "args": {
            "sql": "MATCH (e:PiEntry {vesselImo: $input.vesselImo}) RETURN e.vertex_id, e.rkey, e.repo, e.did, e.status, e.props, e._seq ORDER BY e.entryDate DESC LIMIT 5"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "piEntries"
        },
        {
          "args": {
            "sql": "MATCH (c:MarineClaim)-[:CLAIM_ON]->(p:MarinePolicy {vesselImo: $input.vesselImo}) WHERE c.status IN ['notified', 'under-investigation'] RETURN c.vertex_id, c.rkey, c.repo, c.did, c.status, c.props, c._seq LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "openClaims"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineInsurance.underwriting.getVesselCoverage",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (p:MarinePolicy) RETURN count(p) AS policies LIMIT 1"
          },
          "fn": "graph.query",
          "id": "stats"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineInsurance.health",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n:MarinePolicy) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n:MarinePolicy) WHERE n.repo = $did RETURN count(n) AS cnt LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "marine-insurance",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.marineinsurance.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "m1ns0001",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (n:MarinePolicy) WHERE n.repo = $did RETURN count(n) AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.marineinsurance.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "hull-machinery",
      "protection-indemnity",
      "cargo-insurance",
      "war-risk",
      "general-average",
      "claims-management"
    ],
    "description": "Marine insurance management — Hull & Machinery (H&M), Protection & Indemnity (P&I Club entries), Cargo insurance, War Risk, Loss of Hire, General Average declarations. Claims lifecycle (notification→investigation→adjustment→settlement). Links to vessel.etzhayyim.com for insured vessels and legal-entity.etzhayyim.com for insurers/underwriters.",
    "displayName": "Marine Insurance & P&I Intelligence",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.marineInsurance.policy",
        "com.etzhayyim.apps.marineInsurance.claim",
        "com.etzhayyim.apps.marineInsurance.generalAverage",
        "com.etzhayyim.apps.marineInsurance.piEntry",
        "com.etzhayyim.apps.vessel.ship"
      ]
    }
  },
  "uiType": "yoro"
}
