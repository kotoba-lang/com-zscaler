 {:db/ident :funamori.measure/witness-quorum :db/valueType :db.type/long :db/cardinality :db.cardinality/one} ;; Council Lv6+ ≥3

 ;; ── stack robotics (install/clean/swap dry-run plans; ADR §5 + ADR-2606091800) ─
 {:db/ident :funamori.robotics/job-id    :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
