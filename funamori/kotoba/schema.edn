 {:db/ident :funamori.robotics/coverage  :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ;; anti-fouling 被覆率 0..1
 {:db/ident :funamori.robotics/lanes     :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.robotics/membrane-id :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.robotics/membrane-permitted :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.robotics/reachable :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.robotics/envelope-ok :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ;; motion safety envelope
 {:db/ident :funamori.robotics/witness-ok :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ;; G8 ≥2 robot DIDs
 {:db/ident :funamori.robotics/member-sig :db/valueType :db.type/string :db/cardinality :db.cardinality/one}
 {:db/ident :funamori.robotics/server-held-key :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ;; G11 invariant — always false
 {:db/ident :funamori.robotics/dry-run   :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one} ;; R0 no-live-actuation — always true

 ;; ── plant + grid-tie (tidal generation → hikari microgrid; ADR §4) ───────────
 {:db/ident :funamori.plant/technology   :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one} ;; :pro | :red
 {:db/ident :funamori.plant/rated-kw     :db/valueType :db.type/double  :db/cardinality :db.cardinality/one} ;; 平均 Δ塩分 定格
