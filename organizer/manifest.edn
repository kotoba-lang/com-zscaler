;; organizer — actor manifest (kotoba-native; supersedes actor-manifest.jsonld)
;; Auto-organize file commons (Google Drive inversion) — free, content-addressed,
;; vault-isolated, un-mined. ADR-2606072400 (remediation Phase A of ADR-2606071800)
{:actor/id        "organizer"
 :actor/glyph     "整"
 :actor/tier      :tier-b
 :actor/integrates ["kaiyaku" "tenso"]
 :actor/domain    "organizer.etzhayyim.com"
 :actor/purpose   "Google-Drive-inverse auto-organize file commons — upload → AI auto-classifies + groups into collections, FREE with no storage tiers and NO content mining. Items are content-addressed (Blake3) so identical content dedups to one item; each item is isolated to its owner's vault DID; blobs are encrypted at rest; mutations are member-signed. Classification emits category/labels for the OWNER only — never a profile, ad signal, or cross-vault aggregate. kotoba-EAVT-native, Murakumo-only."
 :actor/status    :r1
 :actor/adr       "2606072400"
 :actor/supersedes "actor-manifest.jsonld (legacy single-Worker / RisingWave; deprecated, removed after 1 R-cycle)"

 :actor/charter-rider
 {:rider/version "2.0"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1"  :gate/name "no-tier"             :gate/rule "free; no paid storage tiers / subscription; no external inflow (§1.3)"}
  {:gate/id "G2"  :gate/name "no-mining"           :gate/rule "classification emits category/labels for the OWNER only; NO content mining → profile / ad signal / training corpus / cross-vault aggregate"}
  {:gate/id "G3"  :gate/name "vault-isolation"     :gate/rule "every item belongs to exactly one vault DID; cross-vault read is refused (own-data-only)"}
  {:gate/id "G4"  :gate/name "content-addressed"   :gate/rule "item id derives from Blake3 of content; identical content → one item (dedup, no redundant storage / re-upload leak)"}
  {:gate/id "G5"  :gate/name "encrypted-at-rest"   :gate/rule "blob → com.etzhayyim.encrypted.* envelope, DID-bound (ADR-2605181100); no plaintext blob"}
  {:gate/id "G6"  :gate/name "no-server-key"       :gate/rule "item/collection mutations are member-signed; organizer holds no key (ADR-2605231525); server signature refused"}
  {:gate/id "G7"  :gate/name "murakumo-only"       :gate/rule "classification / NL via KotobaLLM 127.0.0.1:4000; no external LLM (ADR-2605215000)"}
  {:gate/id "G8"  :gate/name "kotoba-eavt-native"  :gate/rule "item/classification/collection/rule are kotoba Datoms; no RisingWave/SQL (corrects legacy manifest)"}]

 :actor/cells
 [{:cell/id "vault"     :cell/kind :datalog   :cell/runtime :kotoba :cell/doc "per-vault item + classification + collection Datoms"}
  {:cell/id "ingest"    :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "blob → content-addressed dedup (G4) → encrypted item (G5)"}
  {:cell/id "organize"  :cell/kind :langgraph :cell/runtime :wasm   :cell/doc "classify (Murakumo G7) → organize-rule → collection (auto-organize)"}]

 :actor/lexicons
 ["com.etzhayyim.organizer.item"
  "com.etzhayyim.organizer.classification"
  "com.etzhayyim.organizer.collection"]

 :actor/deferred
 {:subscription-discovery "mailer → organizer → kaiyaku pipeline retained as a follow-up (not this core conversion)"}

 :actor/siblings
 {:tenso  "secure file transfer sibling"
  :yoro   "appview host"
  :kaiyaku "subscription cancellation (deferred pipeline)"}}
