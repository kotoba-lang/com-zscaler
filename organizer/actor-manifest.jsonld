{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:organizer.etzhayyim.com",
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Organizer agent — an AI auto-organize platform. Users upload files and you automatically classify, tag, and group them into collections using Murakumo vision/NLP. You manage per-user vaults (did:web:organizer.etzhayyim.com:vault:{nanoid}) and shared collections (did:web:organizer.etzhayyim.com:collection:{nanoid}). You also detect subscriptions from mailer.etzhayyim.com emails, analyze usage patterns, and recommend cancellations via kaiyaku.etzhayyim.com. Blob storage uses Blake3 content-addressing with dedup. Files >64 MiB use multipart chunked parallel upload.",
  "description": "Upload and AI auto-organizes. Replaces manual folder management. Murakumo vision/NLP auto-classification, tag assignment, collection auto-grouping, organize rules. Subscription discovery pipeline (mailer -> organizer -> kaiyaku) for unused subscription cancellation.",
  "displayName": "Organizer — AI Auto-Organize",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "confidential",
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "organizer",
  "nanoid": "org4n1z3",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "message": "Classify this uploaded item.\n\nFilename: $input.record.filename\nContent-Type: $input.record.contentType\nSize: $input.record.size\n\nReturn JSON: {category, subcategory, labels[], confidence}"
          },
          "fn": "agent.chat",
          "id": "classify"
        },
        {
          "args": {
            "template": "MERGE (c:Classification {itemRkey: $input.record.rkey}) SET c.category = $classify.category, c.subcategory = $classify.subcategory, c.confidence = $classify.confidence, c.model = 'murakumo'"
          },
          "fn": "graph.write",
          "id": "writeClassification"
        },
        {
          "args": {
            "sql": "MATCH (r:OrganizeRule) WHERE r.condition CONTAINS $classify.category RETURN r.collectionId AS collectionId, r.action AS action LIMIT 5"
          },
          "depends_on": [
            "classify"
          ],
          "fn": "graph.query",
          "id": "autoCollect"
        },
        {
          "args": {
            "message": "You are Organizer — AI Auto-Organize. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $autoCollect.rows"
          },
          "depends_on": [
            "autoCollect"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.organizer.item"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "message": "Analyze this inbound email for subscription billing patterns.\n\nEmail: $input.record\n\nLook for: invoice, receipt, subscription renewal, auto-charge, billing statement.\nReturn JSON: {isSubscription: boolean, serviceName, amount, currency, billingCycle}"
          },
          "fn": "agent.chat",
          "id": "detectSubscription"
        },
        {
          "args": {
            "template": "MERGE (s:SubscriptionItem {serviceName: $detectSubscription.serviceName, sender: $input.record.sender}) SET s.amount = $detectSubscription.amount, s.currency = $detectSubscription.currency, s.billingCycle = $detectSubscription.billingCycle, s.lastSeenAt = toString(timestamp())"
          },
          "fn": "graph.write",
          "id": "writeSubscription"
        },
        {
          "args": {
            "template": "New data added: $detectSubscription.text"
          },
          "depends_on": [
            "detectSubscription"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.mailer.inboundEmail"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:SubscriptionItem) RETURN s.serviceName AS name, s.amount AS amount, s.currency AS currency, s.billingCycle AS cycle, s.lastSeenAt AS lastSeen LIMIT 50"
          },
          "fn": "graph.query",
          "id": "subscriptions"
        },
        {
          "args": {
            "message": "Monthly subscription analysis.\n\nActive subscriptions: $subscriptions.rows\n\nScore each by usage (usageScore 0-100). Recommend: keep (score>=50), review (20-49), cancel (<20 and costPerMonth>500). Return JSON array."
          },
          "fn": "agent.chat",
          "id": "analyze"
        },
        {
          "args": {
            "template": "Monthly subscription review: $analyze.text"
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 0 1 * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "organizer",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.organizer.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "org4n1z3",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        },
        {
          "args": {
            "message": "You are Organizer — AI Auto-Organize. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $coverageSnapshot.text"
          },
          "depends_on": [
            "coverageSnapshot"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.organizer.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "upload-item",
      "classify",
      "tag",
      "create-collection",
      "organize-rule",
      "detect-subscription",
      "analyze-subscriptions",
      "get-recommendations"
    ],
    "description": "Upload -> AI auto-organize. Murakumo vision/NLP classification, Blake3 dedup, vault/collection Multi-DID. Subscription discovery from mailer emails with kaiyaku auto-cancellation. Replaces etzhayyim-project-drive.",
    "displayName": "Organizer — AI Auto-Organize",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.organizer.item",
        "com.etzhayyim.apps.organizer.classification",
        "com.etzhayyim.apps.organizer.subscriptionItem",
        "com.etzhayyim.apps.mailer.inboundEmail"
      ]
    }
  },
  "uiType": "appview"
}
