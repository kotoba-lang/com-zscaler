<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_yobel_rite_lifecycle"
                  targetNamespace="https://etzhayyim.com/bpmn/yobel">

  <bpmn:process id="yobel-rite-lifecycle" name="Yobel Rite Lifecycle (declare → ratify → enroll → release → audit)" isExecutable="true">

    <bpmn:documentation>
Per ADR-2605201800. Charter Mission §1 monetary-debt 局面の doctrinal runtime workflow.
One-way debt forgiveness only — schema レベルで 貸付 / 利息計算 / margin / liquidation を拒否。
Council Lv6+ ratification + voluntary creditor opt-in が gate.
    </bpmn:documentation>

    <bpmn:startEvent id="Start_DeclareRequest" name="declareRite request">
      <bpmn:outgoing>flow_to_decl_cell</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_RiteDeclaration" name="rite_declaration cell (judah)"
                      implementation="cell:rite_declaration">
      <bpmn:documentation>Lexicon com.etzhayyim.yobel.declareRite — validate riteType, doctrinalBasis, scope. Emit pending rite MST record.</bpmn:documentation>
      <bpmn:incoming>flow_to_decl_cell</bpmn:incoming>
      <bpmn:outgoing>flow_to_council_gate</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:businessRuleTask id="Gate_CouncilRatification" name="Council Lv6+ ratification (DMN)"
                           implementation="dmn:council-ratification-threshold">
      <bpmn:documentation>DMN gate (dmn/council-ratification-threshold.md): rite type + 影響額 + scope で Council Lv 必要数を決定. 全 rite に最低 Lv6+ × 3 + Lv9 chair.</bpmn:documentation>
      <bpmn:incoming>flow_to_council_gate</bpmn:incoming>
      <bpmn:outgoing>flow_council_decision</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="Gateway_CouncilDecision" name="ratified?">
      <bpmn:incoming>flow_council_decision</bpmn:incoming>
      <bpmn:outgoing>flow_ratified</bpmn:outgoing>
      <bpmn:outgoing>flow_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Rejected" name="rite rejected">
      <bpmn:incoming>flow_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:parallelGateway id="Gateway_FanOut_Enroll" name="fan-out (creditors + debtors)">
      <bpmn:incoming>flow_ratified</bpmn:incoming>
      <bpmn:outgoing>flow_to_creditor_cell</bpmn:outgoing>
      <bpmn:outgoing>flow_to_debtor_cell</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_CreditorEnrollment" name="creditor_enrollment cell (gad)"
                      implementation="cell:creditor_enrollment">
      <bpmn:documentation>Lexicon com.etzhayyim.yobel.enrollCreditor — verify ERC725 EIP-712 signedConsent, hash debts[], append-only enrollment MST. Schema gate: debts[] is read-only historical record.</bpmn:documentation>
      <bpmn:incoming>flow_to_creditor_cell</bpmn:incoming>
      <bpmn:outgoing>flow_creditor_done</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>unlimited</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_DebtorEnrollment" name="debtor_enrollment cell (issachar)"
                      implementation="cell:debtor_enrollment">
      <bpmn:documentation>Lexicon com.etzhayyim.yobel.enrollDebtor — verify CouncilSBT Lv1+ membership, check DMN eligibility-by-rite-type, append-only enrollment MST.</bpmn:documentation>
      <bpmn:incoming>flow_to_debtor_cell</bpmn:incoming>
      <bpmn:outgoing>flow_debtor_done</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>unlimited</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_Join_Enroll" name="join">
      <bpmn:incoming>flow_creditor_done</bpmn:incoming>
      <bpmn:incoming>flow_debtor_done</bpmn:incoming>
      <bpmn:outgoing>flow_to_release</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="Task_ReleaseSettlement" name="release_settlement cell (asher)"
                      implementation="cell:release_settlement">
      <bpmn:documentation>Lexicon com.etzhayyim.yobel.recordRelease — pair (creditor, debtor) enrollment, run DMN eligibility-by-rite-type, execute Base L2 USDC release tx via ERC725 Paymaster, record releaseId + baseL2TxHash MST. Schema gate: releasedMicroUsdc ≤ debt.principalMicroUsdc + accruedMicroUsdc.</bpmn:documentation>
      <bpmn:incoming>flow_to_release</bpmn:incoming>
      <bpmn:outgoing>flow_release_done</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>unlimited</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_RiteComplete" name="rite complete">
      <bpmn:incoming>flow_release_done</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:subProcess id="SubProcess_AuditWitness" name="audit_witness cell (reuben) — continuous"
                     triggeredByEvent="true">
      <bpmn:documentation>Witness every super-step + every release MST event. Encrypted append-only log. Tampering detection → automatic superseded status + Public Fund audit grant emit.</bpmn:documentation>
      <bpmn:startEvent id="Start_AuditTick" name="every super-step / release">
        <bpmn:messageEventDefinition messageRef="msg_super_step_tick"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_AuditWitness" name="witness + anchor"
                        implementation="cell:audit_witness"/>
    </bpmn:subProcess>

    <bpmn:sequenceFlow id="flow_to_decl_cell" sourceRef="Start_DeclareRequest" targetRef="Task_RiteDeclaration"/>
    <bpmn:sequenceFlow id="flow_to_council_gate" sourceRef="Task_RiteDeclaration" targetRef="Gate_CouncilRatification"/>
    <bpmn:sequenceFlow id="flow_council_decision" sourceRef="Gate_CouncilRatification" targetRef="Gateway_CouncilDecision"/>
    <bpmn:sequenceFlow id="flow_ratified" name="ratified=true" sourceRef="Gateway_CouncilDecision" targetRef="Gateway_FanOut_Enroll">
      <bpmn:conditionExpression>ratified == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_rejected" name="ratified=false" sourceRef="Gateway_CouncilDecision" targetRef="End_Rejected">
      <bpmn:conditionExpression>ratified == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_to_creditor_cell" sourceRef="Gateway_FanOut_Enroll" targetRef="Task_CreditorEnrollment"/>
    <bpmn:sequenceFlow id="flow_to_debtor_cell" sourceRef="Gateway_FanOut_Enroll" targetRef="Task_DebtorEnrollment"/>
    <bpmn:sequenceFlow id="flow_creditor_done" sourceRef="Task_CreditorEnrollment" targetRef="Gateway_Join_Enroll"/>
    <bpmn:sequenceFlow id="flow_debtor_done" sourceRef="Task_DebtorEnrollment" targetRef="Gateway_Join_Enroll"/>
    <bpmn:sequenceFlow id="flow_to_release" sourceRef="Gateway_Join_Enroll" targetRef="Task_ReleaseSettlement"/>
    <bpmn:sequenceFlow id="flow_release_done" sourceRef="Task_ReleaseSettlement" targetRef="End_RiteComplete"/>

  </bpmn:process>
</bpmn:definitions>
