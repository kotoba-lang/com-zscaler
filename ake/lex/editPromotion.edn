[{:db/id -1, :lex.editPromotion/lexicon 1, :lex.editPromotion/id "com.etzhayyim.ake.editPromotion", :lex.editPromotion/defs "{:main {:type \"record\", :key \"tid\", :description \"The no-server-key promotion membrane (G1/G8). An accepted edit appends a new revision; a :representative value may be promoted to :authoritative ONLY with verifiable provenance (G4). The promotion is member/operator-signed (server signature refused). published is const false at R0 — live promotion into the served registry / live atproto publish is Council Lv6+ + operator (G8).\", :record {:type \"object\", :required [\"editId\" \"signedBy\" \"serverHeldKey\" \"promoted\" \"published\"], :properties {:asOf {:type \"integer\", :description \"the new revision's as-of instant (append, never overwrite)\"}, :serverHeldKey {:type \"boolean\", :const false, :description \"G1 / no-server-key INVARIANT — only false (ADR-2605231525)\"}, :value {:type \"string\"}, :editId {:type \"string\", :description \"→ :edit/id\"}, :sourcing {:type \"string\", :enum [\"representative\" \"authoritative\"], :description \"G4 — promotion to authoritative requires verifiable provenance\"}, :promoted {:type \"boolean\"}, :entity {:type \"string\"}, :published {:type \"boolean\", :const false, :description \"G8 INVARIANT — only false at R0; live publish is Council Lv6+ + operator gated\"}, :signedBy {:type \"string\", :description \"member/operator DID; a server signature is refused\"}, :attr {:type \"string\"}}}}}"}]