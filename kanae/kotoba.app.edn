;; kotoba.app.edn — actor:kanae KOTOBA Mesh application manifest (observatory on-kse, ADR-2606230001 §4).
;; Deploy: kotoba app deploy kotoba.app.edn  (compiles methods/mesh.clj → CID → control datoms)
{:kotoba.app/name    "kanae"
 :kotoba.app/version "0.1.0"
 :kotoba.app/components
 [{:name     "kanae"
   :src      "methods/mesh.clj"                  ; Clojure default → run + on-kse
   :scale    1
   :triggers [{:type :kse :topic "etzhayyim/actor/kanae"}]
   :requires #{:cap/kqe}}
  ;; self-publication: the actor periodically drafts its OWN history (source-cited
  ;; fund-flow edges + aggregate net-flow summaries assembled from danjo's fiscal
  ;; datoms) + procedures (how a fund flow is traced: appropriation→outlay→recipient)
  ;; as DRY-RUN social posts, and — once it holds its own mesh-runtime key
  ;; (self-custodied, no-server-key, ADR-2605231525) under a member CACAO leash —
  ;; signs + emits them itself. Live broadcast stays Council Lv6+ + operator gated
  ;; (§1.12/G11); R0 = dry-run. ADR-2606272355.
  {:name     "kanae-social"
   :src      "methods/social.cljc"
   :scale    1
   :triggers [{:type :tick :cron "0 */6 * * *"}                 ; every 6h: self-publish backlog
              {:type :kse  :topic "etzhayyim/actor/kanae/publish"}]
   :requires #{:cap/kqe :cap/atproto}}]

 :kotoba.app/placement {:spread  :zone
                        :require {:tier "edge"}}}
