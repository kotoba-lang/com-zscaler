  "@type": "ActorManifest",
  "id": "did:web:narashi.etzhayyim.com",
  "name": "narashi",
  "integrates": ["kanae"],
  "displayName": "均 — Global Inequality Observation",
  "displayNameJa": "均",
  "displayNameEn": "Narashi",
  "description": "kotoba-native global economic inequality observation substrate. Ingests already-published World Bank WDI / UN SDG API / Our World in Data indicators (Gini, poverty headcount ratio, income share, SDG 10 shared-prosperity-premium) into kotoba EAVT as metricObservation datoms, optionally cross-references (NON-causally, G8) kanae's read-only aid/loan fundFlowEdge datoms, narrates trends with Murakumo-only LLM (NON-adjudicating, source-cited), and — at R3+ — publishes aggregate reports. Reads the already-IPFS-pinned WDI/SDG/OWID snapshots (same Tier-A sources as global-energy-datoms); never re-fetches (G3 passive-only). NON-adjudicating (G4 UPL-equivalent; no country-ranking-as-verdict). Non-causal cross-reference (G8; no causal claim about aid/inequality is representable at the schema layer). Murakumo-only inference (G7). kotoba-native — NO RisingWave / Postgres / Lance as store or read backend (G2). Explicitly NOT a redistribution/UBI mechanism (N1) — that role belongs solely to the Liberation Ladder (ADR-2605261000) for etzhayyim's own Adherent SBT holders; narashi observes, it does not redistribute. 3 cells / 4 Lexicons / 9 gates / 8 non-goals.",
  "descriptionJa": "kotoba-native のグローバル経済格差観測 substrate。既に公開済みの World Bank WDI / UN SDG API / Our World in Data の指標 (ジニ係数・貧困率・所得シェア・SDG10 shared-prosperity-premium) を kotoba EAVT に metricObservation datom として取り込み、kanae の援助/融資 fundFlowEdge datom を読み取り専用で非因果的に (G8) 突き合わせ、Murakumo-only LLM で傾向を叙述 (非裁定・出典付き) し、R3+ で集計レポートを公開する。既に IPFS pin 済みの WDI/SDG/OWID snapshot (global-energy-datoms と同じ Tier-A ソース) を読むのみ。再取得なし (G3 受動取得)。非裁定 (G4, UPL 等価; 国のランキング=裁定ではない)。非因果的突き合わせ (G8; 援助と格差の因果主張はスキーマ層で表現不能)。Murakumo-only 推論 (G7)。kotoba-native — RisingWave / Postgres / Lance を store・read backend に禁止 (G2)。再分配/UBI メカニズムでは明確にない (N1) — それは etzhayyim 自身の Adherent SBT 保持者向けの Liberation Ladder (ADR-2605261000) の役割であり、narashi は観測するのみで再分配しない。3 cells / 4 Lexicons / 9 gates / 8 non-goals。",
  "adr": {
    "master": "etzhayyim:adr:2607101800",
    "r0": "etzhayyim:adr:2607101800",
    "r1": "reserved",
    "r2": "reserved",
    "r3": "reserved"
  },
  "tier": "Tier-B",
  "parentActor": null,
  "crossActorBoundary": [
    "did:web:kanae.etzhayyim.com (READ-ONLY cross-reference: kanae's fundFlowEdge datoms where flowClass in {intergovernmental-transfer, aid-disbursement, loan}; narashi never writes to kanae's graph; G8 non-causal pairing only; ADR-2607101800 SS1/SS6)",
    "com.etzhayyim.gov.dataset.* is NOT read by narashi (that is kanae/danjo's corpus; narashi's upstream is WDI/SDG/OWID, a disjoint indicator-outcome corpus, not a fiscal-flow corpus)",
    "org.worldbank.api / org.un.unstats / org.ourworldindata (DataLad raw datasets; READ-ONLY pre-published WDI/SDG/OWID snapshots; same Tier-A source family as global-energy-datoms)",
    "kotoba QuadStore EAVT (metric-observation graph store; ADR-2605262130; no RisingWave / no projection layer)"
  ],
  "lexiconReadAccess": {
    "com.etzhayyim.kanae.fundFlowEdge": "ADR-2605302300; READ-ONLY, filtered to flowClass in {intergovernmental-transfer, aid-disbursement, loan}. Assembled into crossReferenceNote by narashi_cross_reference (G8 non-causal)."
  },
  "form": "任意団体 internal civic-transparency global-inequality observation substrate (NOT 一般社団 / NPO / 公益財団 / 宗教法人 法人格 — Preamble SS0.4 Lv7+ unanimity lock; NOT the World Bank / UN Statistics Division; NOT a policy-advocacy organization)",
  "constitutionalDiscipline": {
    "nonAdjudicating": "G4 — UPL-equivalent (mirrors danjo G4 / kanae G4). narashi reports disclosed metric values and their trend only; it MUST NOT rank jurisdictions as good/bad or assign blame. Every metricNarrative carries nonAdjudicatingNotice=true; the indicator enum carries no merit/ranking token.",
    "kotobaNativePersistence": "G2 — metric-observation graph lives in kotoba EAVT; RisingWave / Postgres / Lance / DuckDB / SQLite PROHIBITED as primary store or read backend (ADR-2605262130).",
    "passiveOnlyUpstream": "G3 — reads ONLY the pre-published IPFS-pinned WDI/SDG/OWID snapshots + kanae fundFlowEdge datoms. No live scraping, no per-query API, no non-public sources.",
    "sourceProvenanceMandatory": "G5 — every metricObservation cites >=2 upstream WDI/SDG/OWID record CIDs, or 1 with singleSourced=true explicit.",
    "openMethod": "G6 — every normalization/aggregation heuristic published as an open, versioned methodNote.",
    "murakumoOnlyInference": "G7 — metricNarrative LLM analysis on Murakumo fleet ONLY (ADR-2605215000). murakumoInferenceAttestation mandatory; vendor-LLM origin unrepresentable at schema layer.",
    "nonCausalCrossReference": "G8 (narashi-specific) — crossReferenceNote.causalClaim is a required const false. narashi juxtaposes an inequality trend against a kanae fund-flow edge; it structurally cannot assert causality.",
    "aggregateOnly": "G9 — narashi operates exclusively on national/sub-national aggregate statistics; it never ingests or derives individual-level records."
  },
  "scope": {
    "phase": "R0 scaffold",
    "scopeBoundary": "Ingestion of pre-published global inequality-outcome indicators into kotoba EAVT + non-causal read-only cross-reference with kanae's fund-flow graph + Murakumo-LLM non-adjudicating narrative + (R3+) Council-attested aggregate publication.",
    "exclusions": [
      "redistribution / UBI / grant-making mechanism (that is the Liberation Ladder, ADR-2605261000, adherents-only)",
      "policy-prescription engine",
      "country-ranking / shaming tool",
      "causal-inference engine",
      "replacement for the World Bank / UN Statistics Division's own publications",
      "live-scraping or non-public-source ingester",
      "vendor-LLM inference path (Murakumo-only)",
      "substrate-engine or projection-layer replacement (kotoba canonical; no RisingWave)"
    ]
  },
  "cells": [
    {
      "name": "metric_ingest",
      "module": "kotodama.cells.narashi_metric_ingest",
      "murakumoNode": "reuben",
      "phase": "continuous",
      "io": "org.worldbank.api / org.un.unstats / org.ourworldindata pre-published snapshot -> kotoba EAVT metricObservation datoms (gini, poverty-headcount-ratio-{international,national}, income-share-{bottom40,top10}, sdg10-shared-prosperity-premium)"
    },
    {
      "name": "cross_reference",
      "module": "kotodama.cells.narashi_cross_reference",
      "murakumoNode": "reuben",
      "phase": "periodic (event)",
      "io": "metricObservation trend + kanae fundFlowEdge (read-only, flowClass filtered) -> crossReferenceNote (causalClaim const false, G8)"
    },
    {
      "name": "narrative",
      "module": "kotodama.cells.narashi_narrative",
      "murakumoNode": "gad",
      "phase": "periodic (event)",
      "io": "metricObservation subgraph -> Murakumo-LLM metricNarrative (factual, source-cited, NON-adjudicating; G4 + G5 + G7)"
    }
  ],
  "lexiconNamespaces": [
    "com.etzhayyim.narashi.metricObservation",
    "com.etzhayyim.narashi.crossReferenceNote",
    "com.etzhayyim.narashi.metricNarrative",
    "com.etzhayyim.narashi.methodNote"
  ],
  "constitutionalGates": {
    "description": "9 immutable gates per ADR-2607101800 SS3. Council Lv6+ supermajority + new ADR to amend.",
    "gates": {
      "G1": "Charter Rider SS2(a)-(h) scan on every published narrative + artifact",
      "G2": "kotoba EAVT persistence — RisingWave / Postgres / Lance / DuckDB / SQLite PROHIBITED as primary store or read backend",
      "G3": "Passive-only / upstream-only ingestion — only pre-published IPFS-pinned WDI/SDG/OWID snapshots; no live scraping / no per-query API / no non-public sources",
      "G4": "NON-adjudicating (UPL-equivalent) — metricNarrative nonAdjudicatingNotice const true; indicator enum carries no merit/ranking token",
      "G5": "Source-provenance mandatory — >=2 upstream WDI/SDG/OWID record CIDs per metricObservation, or singleSourced=true explicit",
      "G6": "Open method — every normalization/aggregation heuristic published as methodNote (open, versioned)",
      "G7": "Murakumo-only inference (ADR-2605215000) — metricNarrative LLM on Murakumo fleet only; murakumoInferenceAttestation mandatory",
      "G8": "Non-causal cross-reference (narashi-specific) — crossReferenceNote.causalClaim required const false",
      "G9": "Aggregate-only — no individual/household-level data ever ingested or derived"
    }
  },
  "nonGoals": {
    "description": "8 explicitly excluded scopes",
    "goals": {
      "N1": "NOT a redistribution / UBI / grant-making mechanism (reserved to the Liberation Ladder, adherents-only)",
      "N2": "NOT a policy-prescription engine",
      "N3": "NOT a country-ranking / shaming tool",
      "N4": "NOT a causal-inference engine (G8)",
      "N5": "NOT a replacement for the World Bank / UN Statistics Division's own publications",
      "N6": "NOT a live-scraping or non-public-source ingester (G3)",
      "N7": "NOT a vendor-LLM inference path (G7, Murakumo-only)",
      "N8": "NOT a substrate-engine replacement (G2, kotoba canonical)"
    }
  },
