;; iryo 医療 — kotoba EAVT schema
;; The computed レセプト (claim) and its 算定明細 (line) as DERIVED, content-addressed Datoms
;; on the canonical kotoba log (no RW/SQL). PHI never appears here — only codes, points, and
;; the pseudonym patient DID + the encrypted-payload CID pointer. The レセ電 stream + 氏名/生年月日
;; are materialised at submission time outside the public substrate (G2).

[;; ───────────────────────────── :iryo.rezept/* — one computed レセプト ─────────────────────────────
 {:db/ident :iryo.rezept/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "claim key, e.g. iryo.rezept.<patientDid>.<shinryoYM>"}
 {:db/ident :iryo.rezept/patient
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "rotating pseudonym patient DID (never a stable MRN; ADR-2605181200)"}
 {:db/ident :iryo.rezept/encrypted-payload-cid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "CID of the XChaCha20-Poly1305 envelope holding 氏名/生年月日 (PHI; ADR-2605181100)"}
 {:db/ident :iryo.rezept/hokensha-bango
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "保険者番号 (8桁 社保 / 6桁 国保)"}
 {:db/ident :iryo.rezept/shinryo-ym
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "診療年月 YYYY-MM"}
 {:db/ident :iryo.rezept/futan-wari
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "負担割合 0.3 / 0.2 / 0.1 / 0.0"}
 {:db/ident :iryo.rezept/total-ten
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "合計点数 (1点 = 10円)"}
 {:db/ident :iryo.rezept/total-iryohi-yen
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "総医療費 (10割, 円)"}
 {:db/ident :iryo.rezept/ichibu-futan-yen
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "一部負担金(算定, 高額療養費適用前) — 10円未満四捨五入"}
 {:db/ident :iryo.rezept/kogaku-kubun
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "高額療養費 所得区分 ア/イ/ウ/エ/オ"}
 {:db/ident :iryo.rezept/kogaku-applied
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one}
 {:db/ident :iryo.rezept/patient-pay-yen
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "窓口負担 (高額療養費適用後)"}
 {:db/ident :iryo.rezept/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":draft (operator-gated, no-server-key) | :submitted"}
 {:db/ident :iryo.rezept/observed-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}

 ;; ───────────────────────────── :iryo.line/* — 算定明細 (SI/IY/TO) ─────────────────────────────
 {:db/ident :iryo.line/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :iryo.line/rezept
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :iryo.line/kind
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":act 診療行為 | :drug 薬剤 | :material 特定器材"}
 {:db/ident :iryo.line/shikibetsu
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "診療識別 (レセ電 2桁) 11初診/12再診/13医学管理/21投薬/60検査 …"}
 {:db/ident :iryo.line/kubun
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "レセプト点数欄 区分名"}
 {:db/ident :iryo.line/code
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "診療行為/医薬品/特定器材コード"}
 {:db/ident :iryo.line/unit-ten
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one}
 {:db/ident :iryo.line/count
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "回数 / 投与日数"}
 {:db/ident :iryo.line/ten
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "この明細の合計点数 (unit-ten × count)"}

 ;; ───────────────────────────── :iryo.shobyo/* — 傷病名 (codes only, not PHI) ─────────────────────────────
 {:db/ident :iryo.shobyo/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :iryo.shobyo/rezept
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :iryo.shobyo/code
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "傷病名マスタコード"}
 {:db/ident :iryo.shobyo/icd10
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :iryo.shobyo/is-main
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "主傷病"}
 {:db/ident :iryo.shobyo/outcome
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "転帰 継続/治癒/軽快/中止/死亡"}
 {:db/ident :iryo.shobyo/onset
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "診療開始日 YYYY-MM-DD"}]
