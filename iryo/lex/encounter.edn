;; com.etzhayyim.apps.iryo.encounter — lexicon (EDN form)
;; The billable projection of a 診療録 (encounter) iryo computes a レセプト from. Codes only;
;; clinical free-text + identity stay in the karute encrypted envelope (G2).
[{:db/id -1, :lex/lexicon 1, :lex/id "com.etzhayyim.apps.iryo.encounter", :lex/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"patientDid\" \"futanWari\"], :properties {:patientDid {:type \"string\"}, :futanWari {:type \"number\"}, :kogakuKubun {:type \"string\"}, :acts {:type \"array\", :items {:type \"ref\", :ref \"#actLine\"}}, :prescriptions {:type \"array\", :items {:type \"ref\", :ref \"#prescription\"}}, :materials {:type \"array\", :items {:type \"ref\", :ref \"#materialLine\"}}}}}, :actLine {:type \"object\", :required [\"code\"], :properties {:code {:type \"string\", :description \"診療行為コード\"}, :count {:type \"integer\"}}}, :prescription {:type \"object\", :required [\"shikibetsu\" \"drugs\"], :properties {:shikibetsu {:type \"string\", :description \"21内服/22屯服/23外用\"}, :days {:type \"integer\", :description \"投与日数(内服)/回数(屯服)\"}, :label {:type \"string\"}, :drugs {:type \"array\", :items {:type \"ref\", :ref \"#drugDose\"}}}}, :drugDose {:type \"object\", :required [\"code\" \"amount\"], :properties {:code {:type \"string\", :description \"医薬品コード\"}, :amount {:type \"number\", :description \"所定単位数 (例: 1日錠数)\"}}}, :materialLine {:type \"object\", :required [\"code\"], :properties {:code {:type \"string\", :description \"特定器材コード\"}, :amount {:type \"number\"}, :shikibetsu {:type \"string\"}}}}"}]
