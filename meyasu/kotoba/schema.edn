;; meyasu 目安 — kotoba EAVT schema
;; The unified arbitrage-intel CARD (a fusion of kakaku spread/supply-demand + mitooshi
;; forecast) and the aggregate-first POST derived from it. These are DERIVED observations
;; (G1: buyer-transparency + supply-resilience, never a trade). All state is kotoba Datoms
;; (no RW/SQL); a forecast band is carried, never a point assertion.

[;; ───────────────────────────── :meyasu.card/* — fused arbitrage-intel card ─────────────────────────────
 {:db/ident :meyasu.card/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "card key, e.g. meyasu.card.<productId>.<observedAt>"}
 {:db/ident :meyasu.card/product
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "the canonical product this card is about (kakaku productId)"}
 {:db/ident :meyasu.card/price-spread
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "landed-price spread (max-min) from kakaku, minor units"}
 {:db/ident :meyasu.card/spread-fraction
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one}
 {:db/ident :meyasu.card/notable-spread
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one}
 {:db/ident :meyasu.card/supply-demand-now
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "present supply/demand index in [-1,1] from kakaku"}
 {:db/ident :meyasu.card/reading
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":scarcity | :balanced | :glut"}
 {:db/ident :meyasu.card/forecast-band-lo
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "mitooshi forecast distribution lower band (mean - sd); NEVER a point (G1/G2)"}
 {:db/ident :meyasu.card/forecast-band-hi
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one}
 {:db/ident :meyasu.card/trajectory
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":tightening | :easing | :stable | :unknown"}
 {:db/ident :meyasu.card/attention
  :db/valueType :db.type/boolean
  :db/cardinality :db.cardinality/one
  :db/doc "notable spread AND tightening → routed to a resilience planner"}
 {:db/ident :meyasu.card/route-to
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "planner the card is routed to (G4): okaimono buyers / danjo resilience"}
 {:db/ident :meyasu.card/intent
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "G1 invariant string: buyer-transparency+supply-resilience"}
 {:db/ident :meyasu.card/observed-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}

 ;; ───────────────────────────── :meyasu.post/* — aggregate-first published note ─────────────────────────────
 {:db/ident :meyasu.post/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :meyasu.post/card
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :meyasu.post/text
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :meyasu.post/shape
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":aggregate (G3 aggregate-first; never targeted)"}
 {:db/ident :meyasu.post/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":draft (operator-gated, no-server-key) | :posted"}
 {:db/ident :meyasu.post/observed-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}]
