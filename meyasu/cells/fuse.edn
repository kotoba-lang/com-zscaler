;; meyasu 目安 — fuse cell (langgraph, wasm runtime)
;; maps to py/agent.py handle_fuse
[{:cell/entry "py/agent.py", :cell/id "fuse", :cell/glyph "目安", :cell/kind :langgraph, :cell/runtime :wasm, :db/id -1, :cell/gates ["G1" "G2" "G4"], :cell/doc "Fuse kakaku (price SPREAD + present supply/demand index) + mitooshi (forecast DISTRIBUTION of that index) into one per-product arbitrage-intel card. Does NOT compute price/forecast math itself. G2: a point-asserted or speculative forecast is refused, never fused. Attention = notable spread AND tightening forecast → routed to a resilience planner; else routed to the buyer planner (G4). Intent is buyer-transparency + supply-resilience, never a trade (G1).", :cell/handler "handle_fuse", :cell/kotoba "{:reads [:spread/fraction :sd/index :sd/reading :forecast/mean :forecast/sd :forecast/point-asserted :forecast/use], :writes [:meyasu.card/product :meyasu.card/price-spread :meyasu.card/trajectory :meyasu.card/attention :meyasu.card/route-to]}"}]
