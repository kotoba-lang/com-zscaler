;; com.etzhayyim.apps.meyasu.post — lexicon (EDN form)
;; An aggregate-first public note derived from a meyasu card. G3 aggregate-first (never
;; targeted); G1 no purchase/trade nudge; broadcast operator-gated (no-server-key).
{:lexicon 1
 :id "com.etzhayyim.apps.meyasu.post"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["cardId" "text" "shape" "state" "observedAt"]
    :properties
    {:cardId     {:type "string"}
     :text       {:type "string"}
     :shape      {:type "string" :description "aggregate (G3; never targeted)"}
     :state      {:type "string" :description "draft (operator-gated) | posted"}
     :routeTo    {:type "string"}
     :observedAt {:type "string"}}}}}}
