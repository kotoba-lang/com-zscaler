;; com.etzhayyim.apps.meyasu.card — lexicon (EDN form)
;; A unified arbitrage-intel card: kakaku price-spread + supply/demand fused with the
;; mitooshi forecast distribution. G1: buyer-transparency + supply-resilience, never a trade;
;; the forecast is carried as a BAND, never a point.
{:lexicon 1
 :id "com.etzhayyim.apps.meyasu.card"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["productId" "intent" "observedAt"]
    :properties
    {:productId        {:type "string"}
     :priceSpread      {:type "integer" :description "landed-price spread (max-min), minor units"}
     :spreadFraction   {:type "number"}
     :notableSpread    {:type "boolean"}
     :supplyDemandNow  {:type "number" :description "[-1,1]; +1 scarcity, -1 glut"}
     :reading          {:type "string" :description "scarcity|balanced|glut"}
     :forecastBandLo   {:type "number" :description "mitooshi forecast lower band (mean-sd); NEVER a point (G1/G2)"}
     :forecastBandHi   {:type "number"}
     :trajectory       {:type "string" :description "tightening|easing|stable|unknown"}
     :attention        {:type "boolean"}
     :routeTo          {:type "string" :description "planner (G4): okaimono|danjo"}
     :intent           {:type "string" :description "G1 invariant: buyer-transparency+supply-resilience"}
     :observedAt       {:type "string"}}}}}}
