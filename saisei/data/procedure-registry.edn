[{:proc/mandatory-preconditions [], :proc/options "[{:opt/id :self-file, :opt/kind :self-submit, :opt/protective true, :opt/label \"地方裁判所に申立書一式を提出 (本人申立て可。書式は各庁の書式集を利用)\"}]", :proc/required-docs ["破産手続開始・免責許可申立書" "債権者一覧表" "財産目録" "家計収支表" "陳述書"], :proc/timeline-rules "[{:tl/label \"免責許可決定の確定\", :tl/rule \"破産手続廃止(同時廃止)または終結後、免責審尋を経て免責許可決定 → 確定により非免責債権(破産法253条1項各号: 租税・悪意による不法行為に基づく損害賠償・養育費 等)を除き債務が消滅\", :tl/anchor \"破産法248条以下・252条・253条\", :tl/source-url \"https://laws.e-gov.go.jp/law/416AC0000000075\"}]", :proc/label "自己破産 (self-bankruptcy petition)", :proc/eligibility-signals ["支払不能 (支払能力を欠くため弁済期にある債務を一般的継続的に弁済できない状態、破産法2条11項) — 債務超過とは別概念" "免責不許可事由 (破産法252条1項各号: 浪費・賭博等による著しい財産減少、財産の隠匿・損壊、詐術による信用取引 等) に該当しないか要確認 — 該当しても裁量免責の余地あり(同条2項)"], :proc/verify-current-law true, :proc/fee "{:fee/label \"予納金\", :fee/note \"申立手数料 収入印紙1,000-1,500円 + 予納郵券。同時廃止事件の引継予納金は庁により目安1-3万円、管財事件は原則20万円以上(少額管財運用があれば庁により20万円程度に圧縮)\"}", :proc/jurisdiction :jp, :proc/track :self-filing, :db/id -1, :proc/refer-when ["管財事件が見込まれる(相当額の財産・免責不許可事由あり)" "債権者が多数・複雑な権利関係"], :proc/official-forms-url "https://www.courts.go.jp/saiban/syosiki/syosiki_hasan/hasan/index.html", :proc/forum "地方裁判所 (破産部)", :proc/id "proc:jp-jiko-hasan", :proc/fee-waiver "訴訟上の救助 (民事訴訟費用等に関する法律5条、破産法にも準用) / 法テラス民事法律扶助の立替制度"} {:proc/mandatory-preconditions [], :proc/options "[{:opt/id :self-file, :opt/kind :self-submit, :opt/protective true, :opt/label \"地方裁判所に申立書一式を提出 (本人申立て可。個人再生委員が選任されることが多い)\"}]", :proc/required-docs ["再生手続開始申立書" "債権者一覧表" "財産目録" "家計収支表" "住宅資金特別条項を利用する場合は別紙"], :proc/timeline-rules "[{:tl/label \"再生計画認可決定の確定\", :tl/rule \"再生計画案の可決(小規模個人再生は書面決議で反対が議決権者の半数未満等)または給与所得者等再生の可処分所得要件充足 → 認可決定確定により原則3年(最長5年)の分割弁済 → 完済で残債務免除\", :tl/anchor \"民事再生法221条以下・230条・241条\", :tl/source-url \"https://laws.e-gov.go.jp/law/412AC0000000225\"}]", :proc/label "個人再生 (individual civil rehabilitation)", :proc/eligibility-signals ["住宅ローン等を除く再生債権総額が原則5,000万円以下 (民事再生法221条1項)" "将来の継続的・反復的な収入の見込みがあること" "小規模個人再生(債権者の消極的同意で足りる)と給与所得者等再生(可処分所得要件あり、同意不要)の2類型 — 収入の安定性で選択"], :proc/verify-current-law true, :proc/fee "{:fee/label \"予納金\", :fee/note \"申立手数料 収入印紙10,000円 + 予納郵券 + 個人再生委員選任時の予納金(庁により目安15-25万円程度)\"}", :proc/jurisdiction :jp, :proc/track :self-filing, :db/id -2, :proc/refer-when ["住宅資金特別条項の利用を検討" "債権者の異議が見込まれる" "可処分所得の算定が複雑"], :proc/official-forms-url "https://www.courts.go.jp/saiban/syosiki/syosiki_hasan/kojinsaisei/index.html", :proc/forum "地方裁判所 (民事再生部)", :proc/id "proc:jp-kojin-saisei", :proc/fee-waiver "法テラス民事法律扶助の立替制度"} {:proc/mandatory-preconditions "[{:pre/label \"Credit counseling (pre-filing)\", :pre/detail \"an individual must complete credit counseling from a USTP-approved agency within 180 days before filing — the certificate is a required attachment to the petition\", :pre/anchor \"11 U.S.C. §109(h)\"}]", :proc/options "[{:opt/id :self-file, :opt/kind :self-submit, :opt/protective true, :opt/label \"file pro se via the court's CM/ECF or paper petition (Official Form 101 + schedules)\"}]", :proc/required-docs ["Voluntary Petition (Official Form 101)" "Schedules A/B–J" "Statement of Financial Affairs" "means test forms (122A-1/122A-2)" "credit counseling certificate"], :proc/timeline-rules "[{:tl/label \"Discharge order\", :tl/rule \"absent an objection (11 U.S.C. §727) or a §523 nondischargeability finding, the court enters a discharge order after the §341 meeting of creditors and the applicable objection period run — discharge extinguishes covered debts except the §523(a) nondischargeable categories (most tax debt, student loans absent undue hardship, domestic support, etc.)\", :tl/anchor \"11 U.S.C. §727, §523\", :tl/source-url \"https://www.uscourts.gov/forms-rules/current-rules-practice-procedure/federal-rules-bankruptcy-procedure\"}]", :proc/label "Chapter 7 (liquidation)", :proc/eligibility-signals ["means test: current monthly income vs. state median — above-median filers face a further disposable-income test before Chapter 7 eligibility (11 U.S.C. §707(b))" "no minimum debt/asset threshold, but exempt-property schedules (state or federal exemptions) determine what stays with the debtor"], :proc/verify-current-law true, :proc/fee "{:fee/label \"filing fee\", :fee/note \"$338 (as of the current fee schedule) — periodically adjusted by the Judicial Conference\"}", :proc/jurisdiction :us, :proc/track :self-filing, :db/id -3, :proc/refer-when ["above-median income (means-test complexity)" "business assets / multiple properties" "anticipated §727/§523 objection"], :proc/official-forms-url "https://www.uscourts.gov/forms-rules/forms/bankruptcy-forms", :proc/forum "United States Bankruptcy Court (federal, per judicial district)", :proc/id "proc:us-chapter7", :proc/fee-waiver "fee waiver under 28 U.S.C. §1930(f) for income below 150% of the federal poverty line, or installment payment of the fee"} {:proc/mandatory-preconditions "[{:pre/label \"Credit counseling (pre-filing)\", :pre/detail \"same §109(h) requirement as Chapter 7 — certificate required before filing\", :pre/anchor \"11 U.S.C. §109(h)\"}]", :proc/options "[{:opt/id :self-file, :opt/kind :self-submit, :opt/protective true, :opt/label \"file pro se, propose a plan (Official Form 113 or local district form)\"}]", :proc/required-docs ["Voluntary Petition (Official Form 101)" "Schedules A/B–J" "Chapter 13 Plan (Official Form 113 or local form)" "Statement of Financial Affairs" "credit counseling certificate"], :proc/timeline-rules "[{:tl/label \"Plan confirmation + discharge\", :tl/rule \"after the §341 meeting, the court confirms a feasible plan meeting §1325's requirements; discharge follows completion of all plan payments (typically 3-5 years), broader than Chapter 7's discharge for some debt categories\", :tl/anchor \"11 U.S.C. §1301 et seq., §1325, §1328\", :tl/source-url \"https://www.uscourts.gov/forms-rules/current-rules-practice-procedure/federal-rules-bankruptcy-procedure\"}]", :proc/label "Chapter 13 (wage-earner plan)", :proc/eligibility-signals ["individual with regular income; unsecured