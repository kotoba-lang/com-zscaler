& Wales"], :proc/verify-current-law true, :proc/fee "{:fee/label \"adjudicator fee + official receiver's deposit\", :fee/note \"£130 adjudicator fee + £550 official receiver deposit (as of the current fee order) — no fee-exempt route for the deposit portion at present\"}", :proc/jurisdiction :uk, :proc/track :self-filing, :db/id -5, :proc/refer-when ["business assets / trading debts" "prior bankruptcy within the relevant look-back period" "disputed debt figures"], :proc/official-forms-url "https://www.gov.uk/apply-for-bankruptcy", :proc/forum "Adjudicator (online application via gov.uk) — no court hearing needed since the 2016 reform", :proc/id "proc:uk-bankruptcy", :proc/fee-waiver "none for the deposit; the adjudicator fee may have limited remission in specific circumstances — verify current Insolvency Service guidance"} {:proc/mandatory-preconditions "[{:pre/label \"Approved intermediary\", :pre/detail \"a DRO application CANNOT be self-filed directly — it must be submitted via an FCA/Insolvency-Service-approved intermediary (typically a free debt-advice charity adviser), who assesses eligibility and submits on the debtor's behalf with the debtor's information\", :pre/anchor \"Insolvency Act 1986 Pt 7A\"}]", :proc/options "[{:opt/id :find-intermediary, :opt/kind :self-submit, :opt/protective true, :opt/label \"contact a free debt-advice charity (MoneyHelper locator) to find an approved intermediary — this step IS the filing route, not optional pre-work\"}]", :proc/required-docs ["intermediary intake assessment" "full income/expenditure/asset statement"], :proc/timeline-rules "[{:tl/label \"Automatic discharge\", :tl/rule \"discharge is automatic 12 months after the DRO is made, provided circumstances have not changed materially (a moratorium period during which creditors cannot pursue the debts)\", :tl/anchor \"Insolvency Act 1986 Pt 7A\", :tl/source-url \"https://www.legislation.gov.uk/ukpga/1986/45/part/7A\"}]", :proc/label "Debt Relief Order (DRO)", :proc/eligibility-signals ["total debts below the statutory DRO ceiling, disposable income below the statutory monthly threshold, assets (excl. certain exempt items and one vehicle below a value cap) below the statutory threshold — all figures periodically adjusted, verify current Insolvency Service figures"], :proc/verify-current-law true, :proc/fee "{:fee/label \"application fee\", :fee/note \"£90 (as of the current fee order)\"}", :proc/jurisdiction :uk, :proc/track :self-filing, :db/id -6, :proc/refer-when ["always — DRO structurally requires the intermediary; there is no self-submit-without-intermediary path"], :proc/official-forms-url "https://www.moneyhelper.org.uk/en/money-troubles/dealing-with-debt/debt-advice-locator", :proc/forum "Insolvency Service (application MUST go through an approved intermediary — not a direct self-file portal)", :proc/id "proc:uk-dro", :proc/fee-waiver "none currently — the fee itself is set low relative to bankruptcy specifically to keep this route accessible"} {:proc/mandatory-preconditions "[{:pre/label \"außergerichtlicher Einigungsversuch\", :pre/detail \"vor Antragstellung MUSS der Schuldner nachweislich versucht haben, sich mit den Gläubigern außergerichtlich auf Grundlage eines Plans zu einigen — die Bescheinigung darüber (von einer geeigneten Stelle, i.d.R. einer anerkannten Schuldnerberatungsstelle) ist zwingende Anlage zum Antrag, KEIN optionaler Schritt\", :pre/anchor \"§305 Abs. 1 Nr. 1 InsO\"}]", :proc/options "[{:opt/id :schuldnerberatung, :opt/kind :self-submit, :opt/protective true, :opt/label \"anerkannte Schuldnerberatungsstelle aufsuchen — dieser Schritt IST der verpflichtende Verfahrenseinstieg, nicht optional (§305 InsO)\"} {:opt/id :self-file, :opt/kind :self-submit, :opt/protective true, :opt/label \"nach gescheitertem außergerichtlichem Einigungsversuch: Antrag beim Insolvenzgericht selbst einreichen (amtliches Formular, Beratungsstelle unterstützt regelmäßig beim Ausfüllen)\"}]", :proc/required-docs ["Antrag auf Eröffnung des Insolvenzverfahrens (amtliches Formular)" "Bescheinigung über den gescheiterten außergerichtlichen Einigungsversuch" "Vermögensübersicht" "Gläubiger- und Forderungsverzeichnis" "Schuldenbereinigungsplan"], :proc/timeline-rules "[{:tl/label \"Restschuldbefreiung\", :tl/rule \"seit der Reform 2021 grundsätzlich Erteilung der Restschuldbefreiung nach 3 Jahren ab Verfahrenseröffnung (vorher 6 Jahre), vorbehaltlich Versagungsgründen (§290 InsO) — Restschuldbefreiung wirkt gegen alle Insolvenzgläubiger außer den in §302 InsO genannten Ausnahmen (z.B. vorsätzlich unerlaubte Handlung)\", :tl/anchor \"§287 Abs. 2, §300, §302, §290 InsO (Fassung nach dem Gesetz zur weiteren Verkürzung des Restschuldbefreiungsverfahrens, 2021)\", :tl/source-url \"https://www.gesetze-im-internet.de/inso/\"}]", :proc/label "Verbraucherinsolvenzverfahren + Restschuldbefreiung", :proc/eligibility-signals ["natürliche Person ohne (oder mit nur unwesentlicher) selbständiger wirtschaftlicher Tätigkeit (§304 InsO)" "Zahlungsunfähigkeit (§17 InsO) oder drohende Zahlungsunfähigkeit als Antragsgrund"], :proc/verify-current-law true, :proc/fee "{:fee/label \"Gerichtskosten\", :fee/note \"Gerichtskosten werden i.d.R. bei Mittellosigkeit gestundet (Verfahrenskostenstundung, §4a InsO) — keine feste Vorschusspflicht wie im Regelinsolvenzverfahren\"}", :proc/jurisdiction :de, :proc/track :self-filing, :db/id -7, :proc/refer-when ["selbständige Nebentätigkeit unklar (Regel- vs. Verbraucherinsolvenz-Abgrenzung)" "Versagungsgründe nach §290 InsO im Raum" "komplexe Gläubigerstruktur"], :proc/official-forms-url "https://www.bmjv.de/DE/service/formulare/form_verbraucherinsolvenzverfahren/form_verbraucherinsolvenzverfahren_node.html", :proc/forum "Insolvenzgericht (Amtsgericht am Wohnsitz)", :proc/id "proc:de-verbraucherinsolvenz", :proc/fee-waiver "Verfahrenskostenstundung (§4a InsO) — Stundung der Gerichts- und Insolvenzverwalterkosten bei Mittellosigkeit"}]
