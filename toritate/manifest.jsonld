  "id": "did:web:toritate.etzhayyim.com",
  "name": "toritate",
  "integrates": ["chigiri", "kawase-yui", "toritsugi", "wakai"],
  "displayName": "執帳 — Accounting + Audit",
  "displayNameJa": "執帳",
  "displayNameEn": "Toritate",
  "description": "Non-profit religious-corp accounting + audit substrate. Aggregates on-chain TitheRouter + Public Fund Safe + Council Safe + Land Registry transactions into transparent reports. 100% on-chain transparency invariant (G3). No commercial accounting software (G8 PROHIBITED). No tax-advice rendering (G5; external opinion via Public Fund Council Lv6+). No payroll (volunteer ≠ employee). 6 cells / 5 Lexicons / 12 gates / 12 non-goals.",
  "descriptionJa": "非営利 religious-corp の会計+監査 substrate。on-chain TitheRouter + Public Fund Safe + Council Safe + Land Registry 取引を集約し透明レポートとして公開。100% on-chain 透明性 (G3)。商業会計ソフト禁止 (G8: QuickBooks / Xero / FreeAgent / Wave / FreshBooks / Sage / Zoho Books)。税務助言禁止 (G5; 外部意見は Public Fund Council Lv6+ 経由)。給与なし (volunteer ≠ employee per Liberation Ladder G13)。6 cells / 5 Lexicons / 12 gates / 12 non-goals。",
  "adr": {
    "master": "etzhayyim:adr:2605262900",
    "parent": "etzhayyim:adr:2605192145",
    "r0": "etzhayyim:adr:2605262900",
    "r1": "reserved",
    "r2": "reserved",
    "r3": "reserved"
  },
  "tier": "Tier-B",
  "parentActor": null,
  "crossActorBoundary": [
    "did:web:chigiri.etzhayyim.com (tax_receipt boundary, 2-way)",
    "TitheRouter on-chain contract (income read)",
    "Public Fund Safe on-chain contract (disbursement read)",
    "Council Safe on-chain contract (operational expense read)",
    "Land Registry on-chain contract (acquisition read)",
    "chigiri.stewardLaborAttestation (L0..L6 classification read)",
    "did:web:kawase-yui.etzhayyim.com (ledgerEntry purpose=kawase-mutual-aid for every kawase flow + annual silenKawaseReview cross-referenced into toritate.annualReport; reserve buffer seed grant via Public Fund Safe at R1 launch; ADR-2605282200)",
    "did:web:wakai.etzhayyim.com (mutual-aid pool transparency + Public Fund backstop accounting; sibling-mutual-aid-actor pairing with kawase-yui; ADR-2605263500)",
    "did:web:toritsugi.etzhayyim.com (tax-procedure boundary: toritsugi guides a member through citizen-side tax mechanics e.g. 確定申告/e-Tax operation + 必要書類, but ALL 税務 characterization + 税理士法-reserved 税務代理/税務書類作成 route to toritate + licensed 税理士; toritsugi renders no tax advice — toritsugi G5/N13; ADR-2605312030)"
  ],
  "lexiconReadAccess": {
    "com.etzhayyim.corp.leiReference": "ADR-2605263800; READ-ONLY GLEIF LEI canonical for recipient-vendor identity resolution before disbursement. Anti-related-party check on Public Fund Safe + Council Safe outflow against corporate-donor + officer-network records. CC0 1.0 license.",
    "com.etzhayyim.corp.ownershipEdge": "ADR-2605263800; READ-ONLY UBO + parent-subsidiary + control-relationship + officer edge traversal for anti-related-party check. Flags if disbursement-recipient + donor-recipient share UBO within configurable threshold. Tier-A GLEIF L2 (CC0) + Tier-B OpenCorporates open-data (`-tierB-` infix; SA propagates).",
    "com.etzhayyim.gov.dataset.budgetRecord": "ADR-2605263900; READ-ONLY per-jurisdiction gov budget recipient cross-reference (USAspending / EU FTS / UK Treasury / JP 予算書). Flags vendor receiving simultaneous religious-corp Public Fund disbursement AND state appropriation in same fiscal cycle.",
    "com.etzhayyim.gov.dataset.procurementRecord": "ADR-2605263900; READ-ONLY per-jurisdiction gov procurement awardee cross-reference (EU TED / US SAM.gov / JP 政府調達 / UK Contracts Finder). Uses awardeeLei + recipientLei cross-link to corp.leiReference for entity identity."
  },
  "form": "任意団体 internal accounting + audit substrate (NOT 一般社団 / NPO / 公益財団 / 宗教法人 法人格 — Preamble §0.4 Lv7+ unanimity lock)",
  "constitutionalDiscipline": {
    "onChainPrimaryLedger": "G3 + G4 — 100% on-chain transparency; USDC + Base L2 + TitheRouter + Public Fund Safe + Council Safe are canonical SoT; off-chain primary ledger PROHIBITED; fiat reporting (if any) is derived projection only",
    "uplEquivalent": "G5 — toritate does NOT render tax advice or accounting opinion; opinion via external counsel contracted through Public Fund Safe (Council Lv6+); same pattern as chigiri G14 UPL",
    "noCommercialAccountingSoftware": "G8 — QuickBooks / Xero / FreeAgent / Wave / FreshBooks / Sage / Zoho Books PROHIBITED (Charter Rider §2(e) anti-gatekeeping + §2(c) vendor data-sovereignty)",
    "noPayroll": "G12 + ADR-2605262700 G13 — volunteer ≠ employee; subsistence flow ≠ wage; `payroll` is NOT a valid ledgerEntry category",
    "muragumoOnlyInference": "G7 — Murakumo-only inference per ADR-2605215000; no vendor LLM API callout"
  },
  "scope": {
    "phase": "R0 scaffold",
    "scopeBoundary": "On-chain accounting aggregation + transparent reporting + audit attestation orchestration",
    "exclusions": [
      "commercial accounting firm operations",
      "fee-for-service accounting work",
      "tax-advice rendering (G5; external opinion via Public Fund Council)",
      "payroll system (volunteer ≠ employee)",
      "commercial accounting software integration (QuickBooks / Xero / FreeAgent / Wave / FreshBooks / Sage / Zoho Books)",
      "financial-statement audit opinion (external auditor via Public Fund)",
      "budgeting / forecasting (Council Lv6+ allocates; toritate reports actual)",
      "transaction approval gating (on-chain Safes)",
      "donor surveillance (aggregate only)",
      "state-granted legal personality dependency (NOT 宗教法人法 登記)",
      "Land Trust market valuation (inalienable per ADR-2605192245)",
      "closed-source tooling"
    ]
  },
  "cells": [
    {
      "name": "tithe_accounting",
      "module": "kotodama.cells.toritate_tithe_accounting",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "TitheRouter tx → income summary entry"
    },
    {
      "name": "public_fund_accounting",
      "module": "kotodama.cells.toritate_public_fund_accounting",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "Public Fund Safe disbursement → grant summary entry"
    },
    {
      "name": "council_compensation",
      "module": "kotodama.cells.toritate_council_compensation",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "Council Safe tx → operational expense summary (typically zero)"
    },
    {
      "name": "steward_subsistence_accounting",
      "module": "kotodama.cells.toritate_steward_subsistence_accounting",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "chigiri.stewardLaborAttestation → L0..L6 subsistence flow summary"
    },
    {
      "name": "transaction_ledger",
      "module": "kotodama.cells.toritate_transaction_ledger",
      "murakumoNode": "reuben",
      "phase": "continuous",
      "io": "raw on-chain Base L2 tx parsing + categorization"
    },
    {
      "name": "annual_audit_report",
      "module": "kotodama.cells.toritate_annual_audit_report",
      "murakumoNode": "reuben",
      "phase": "annual (event)",
      "io": "aggregate cells (1-5) → annual transparency report + Council ≥3 attestation chain"
    },
    {
      "name": "imputed_income_compute",
      "module": "kotodama.cells.toritate_imputed_income_compute",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "encrypted per-adherent in-kind consumption → imputed income (FLOW) → metricReport.basicHighIncome (ADR-2605301020; valuation/ tables)"
    },
    {
      "name": "commons_asset_value",
      "module": "kotodama.cells.toritate_commons_asset_value",
      "murakumoNode": "gad",
      "phase": "continuous",
      "io": "SBT-bound non-alienable commons-asset access (STOCK) → metricReport.basicHighIncome (ADR-2605301020 §2)"
    }
  ],
  "lexiconNamespaces": [
    "com.etzhayyim.toritate.financialAttestation",
