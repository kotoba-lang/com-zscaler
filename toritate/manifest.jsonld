  "constitutionalGates": {
    "description": "12 immutable gates per ADR-2605262900. Council Lv6+ supermajority + new ADR to amend.",
    "gates": {
      "G1": "Charter Rider §2(a)-(h) scan on every report",
      "G2": "kotoba-datomic attestation lineage on every record",
      "G3": "100% on-chain transparency — no off-chain primary ledger",
      "G4": "USDC + Base L2 canonical SoT; fiat reporting derived projection only",
      "G5": "UPL-equivalent — no tax advice / accounting opinion (external counsel via Public Fund Council Lv6+)",
      "G6": "Annual audit attestation ≥3 distinct Council Lv6+ DIDs",
      "G7": "Murakumo-only inference (ADR-2605215000)",
      "G8": "No commercial accounting software (QuickBooks / Xero / FreeAgent / Wave / FreshBooks / Sage / Zoho Books PROHIBITED)",
      "G9": "≥3-year ledger retention via IPFS pin (replicationMin: 2)",
      "G10": "No donor PII in published reports (aggregate + pseudonymous DIDs only)",
      "G11": "Read-only on financial chain (no transaction approval — Safes own that)",
      "G12": "No payroll category (volunteer ≠ employee per Liberation Ladder G13)"
    }
  },
  "nonGoals": {
    "description": "12 explicitly excluded scopes",
    "goals": {
      "N1": "NOT a commercial accounting firm",
      "N2": "NOT a fiat reconciliation system",
      "N3": "NOT a tax-prep service for donors (chigiri.taxReceipt)",
      "N4": "NOT a payroll system",
      "N5": "NOT a commercial-accounting-software integrator",
      "N6": "NOT a financial-statement audit firm (external auditor via Public Fund)",
      "N7": "NOT a budgeting / forecasting tool",
      "N8": "NOT transaction approval gating",
      "N9": "NOT donor surveillance",
      "N10": "NOT closed-source",
      "N11": "NOT a state-granted legal personality",
      "N12": "NOT a Land Trust valuation engine (inalienable land has no market price)"
    }
  },
