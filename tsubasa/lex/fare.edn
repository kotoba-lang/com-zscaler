[{:db/id -1, :lex-fare/lexicon 1, :lex-fare/id "com.etzhayyim.tsubasa.fare", :lex-fare/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"fareId\" \"origin\" \"destination\" \"departDate\" \"carrier\" \"fareMinor\" \"co2Kg\" \"sourcing\"], :properties {:durationMin {:type \"integer\"}, :stops {:type \"integer\", :description \"0 = direct\"}, :fareMinor {:type \"integer\", :description \"base fare, minor units\"}, :baggageMinor {:type \"integer\", :description \"checked-bag fee (total-cost honesty, G4)\"}, :fareId {:type \"string\"}, :carrier {:type \"string\", :description \"operating airline (IATA)\"}, :departDate {:type \"string\", :format \"date\"}, :currency {:type \"string\", :description \"ISO-4217\"}, :origin {:type \"string\", :description \"IATA airport code\"}, :sourcing {:type \"string\", :description \"authoritative|representative|synthesized (G8 honesty)\"}, :bookUrl {:type \"string\", :description \"airline's OWN booking page — affiliate-stripped at handoff (G1)\"}, :cabin {:type \"string\", :description \"economy|premium|business|first\"}, :destination {:type \"string\", :description \"IATA airport code\"}, :co2Kg {:type \"number\", :description \"REQUIRED — per-passenger CO₂; surfaced on every option (G4)\"}}}}}"}]
