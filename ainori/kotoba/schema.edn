;; ainori 相乗 — kotoba EAVT schema
;; ADR-2606071500
;; Pooled passenger mobility. NO :*/surge, :*/demand-multiplier, or :*/driver-wage>0 attribute
;; exists (G1/G2). Location is origin/destination + ephemeral match state only — NO continuous
;; :*/position or :*/track attribute (G7/G12 no person-tracking). All state is kotoba Datoms (G6).

[;; ───────────────────────────── :ride/* — a pooled ride need ─────────────────────────────
 {:db/ident :ride/id            :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :ride/rider-did     :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :ride/origin        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "geo DID / coarse point (exact via encrypted envelope, G7)"}
 {:db/ident :ride/destination   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :ride/seats         :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :ride/consent-ref   :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "DID-signed consent (G8)"}
 {:db/ident :ride/mode          :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":human-pooled | :autonomous-pooled"}

 ;; ───────────────────────────── :match/* — pooled match result ─────────────────────────────
 {:db/ident :match/id           :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :match/ride         :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :match/carrier-did  :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "member-driver or fleet shuttle DID"}
 {:db/ident :match/route        :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/doc "todoke-route sequenced trip id"}
 {:db/ident :match/occupancy    :db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "riders pooled — higher is better (G11)"}
 {:db/ident :match/cost-share-minor :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/doc "flat fuel/wear / occupancy; NO surge (G2)"}
 {:db/ident :match/driver-wage-minor :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/doc "INVARIANT 0 — platform pays driver no wage (G1)"}
 {:db/ident :match/envelope-ok  :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "SAE-L4 satisfied; false ⇒ refused (G3)"}
 {:db/ident :match/state        :db/valueType :db.type/keyword :db/cardinality :db.cardinality/one :db/doc ":proposed :consented :enroute :completed :cancelled"}

 ;; ───────────────────────────── :settle/* — cost-share settlement ─────────────────────────────
 {:db/ident :settle/id          :db/valueType :db.type/string  :db/cardinality :db.cardinality/one :db/unique :db.unique/identity}
 {:db/ident :settle/match       :db/valueType :db.type/string  :db/cardinality :db.cardinality/one}
 {:db/ident :settle/gross-minor :db/valueType :db.type/long    :db/cardinality :db.cardinality/one}
 {:db/ident :settle/tithe-minor :db/valueType :db.type/long    :db/cardinality :db.cardinality/one :db/doc "10% TitheRouter (G4)"}
 {:db/ident :settle/carrier-reimbursement-minor :db/valueType :db.type/long :db/cardinality :db.cardinality/one :db/doc "fuel/wear recovery, NOT income (G1)"}
 {:db/ident :settle/signed      :db/valueType :db.type/boolean :db/cardinality :db.cardinality/one :db/doc "member-signed (G5 no-server-key)"}]
