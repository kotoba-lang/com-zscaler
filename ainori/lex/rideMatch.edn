[{:db/id -1, :ridematch/lexicon 1, :ridematch/id "com.etzhayyim.ainori.rideMatch", :ridematch/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"matchId\" \"requestId\" \"carrierDid\" \"routeId\" \"occupancy\" \"costShareMinor\"], :properties {:costShareMinor {:type \"integer\", :description \"this rider's flat cost-share (fuel/energy+wear / occupancy); USDC minor; NO margin (G2)\"}, :occupancy {:type \"integer\", :description \"riders pooled onto this trip (G11: higher is better)\"}, :detourMeters {:type \"integer\", :description \"added distance vs carrier's solo trip (kept minimal)\"}, :envelopeOk {:type \"boolean\", :description \"SAE-L4 safety envelope satisfied (G3); false ⇒ match refused\"}, :titheMinor {:type \"integer\", :description \"10% TitheRouter split (G4)\"}, :settlementRef {:type \"string\", :description \"warifu settlement ref (member-signed; intent-only at R0)\"}, :requestId {:type \"string\"}, :carrierDid {:type \"string\", :description \"member-driver DID (human-pooled) OR fleet shuttle DID (autonomous-pooled)\"}, :status {:type \"string\", :description \"proposed|consented|enroute|completed|cancelled\"}, :routeId {:type \"string\", :description \"pooledRoute id from todoke-route sequencer\"}, :matchId {:type \"string\"}, :driverPaidMinor {:type \"integer\", :description \"const 0 — platform pays driver cash≡0 (G1); driver compensation is dividend, not here\"}}}}}"}]
