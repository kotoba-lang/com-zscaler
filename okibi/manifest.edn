 :actor/gates
 [{:gate/id "G1" :gate/name "map-not-dispatch" :gate/rule "A matching MAP, never a dispatch ORDER. No :okibi/dispatch attribute exists (test-enforced); hikari actuates under Council gate."}
  {:gate/id "G2" :gate/name "physical-feasibility" :gate/rule "A match must pass the temperature cascade (source ≥ sink-req + approach) AND distance — an infeasible pair can never become a match (no :okibi.match/fabricated). A cooling LOAD is not a heat sink (§1 anti-pattern unrepresentable)."}
  {:gate/id "G3" :gate/name "verification-via-mio" :gate/rule "A delivered match's kWh is verified by 澪 mio (signed BTU meter, §9 gates) before it earns; okibi observes, mio verifies (R1)."}
  {:gate/id "G4" :gate/name "kotoba-eavt-native" :gate/rule "State is kotoba EAVT Datoms on an append-only content-addressed commit-DAG; every derived datom :okibi/derived + :okibi/sourcing."}
  {:gate/id "G5" :gate/name "net-not-positive-carbon" :gate/rule "A match must not induce additional fossil heat (kamado net≤0 standard); waste heat to a non-heat-demand surfaces as unmatched, never a match."}
  {:gate/id "G6" :gate/name "murakumo-only-narration" :gate/rule "Any narration via the Murakumo no-VKE mesh, DEFAULT-PREFERRED (Rider v3.3 §2(i))"}
  {:gate/id "G7" :gate/name "no-server-key" :gate/rule "Platform holds no key; live meter/nameplate ingest is an operator step (R0 seed = :representative + folded :authoritative)."}]

