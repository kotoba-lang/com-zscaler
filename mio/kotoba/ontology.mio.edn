[{:mio.ontology/node-kinds "[{:kind :claim, :doc \"A flow-improvement CLAIM submitted by a suite actor (撓/燠/樋/委) or hikari: an assertion that some energy flow was ORDERED (waste heat delivered, peak shaved, surplus absorbed, compute routed to a heat/renewable sink). Carries the five verification facts.\", :keys [:id :name :flow-class :source-actor :order-delta-kwh :baseline-method :additionality :measurement-source :double-count-key :leakage :sourcing :source :note]} {:kind :class, :doc \"Derived aggregate over a flow class (:flexibility / :waste-heat / :compute-routing / :intention / :renewable-absorb / :peak-shave).\"}]", :ontology/id "mio", :ontology/version "0.1.0", :mio.ontology/route-kinds "{:reward \"verified ordered-flow → advisory reward proposal (drafted-unsent; actual issue = 1 SBT=1 vote + TitheRouter; hikari actuates)\", :review \"unverified / rejected → returned to the submitting actor with the failing verification fact\"}", :mio.ontology/unrepresentable [":mio/trade" ":mio/signal" ":mio.obs/consumed-reward" ":mio.claim/consumed-reward-kwh" ":mio.claim/price-forecast-point" ":mio.person/intention-content"], :mio.ontology/flow-classes #{:peak-shave :flexibility :waste-heat :renewable-absorb :compute-routing :intention}, :db/id -1, :ontology/adr ["2606211200" "2605262130" "2605312345" "2606111400"], :mio.ontology/measurement-weight "{:third-party-audit 1.0, :zk-proof 0.95, :signed-meter 0.9, :dual-sensor 0.9, :satellite 0.85, :self-report 0.3}", :mio.ontology/verdict-kinds "{:verified \"all five verification facts satisfied + confidence ≥ threshold → routes to :reward (advisory, 1 SBT=1 vote)\", :insufficient-evidence \"missing baseline / additionality < min / no trusted measurement / confidence < threshold → :review\", :rejected-double-count \"double-count-key collides with an earlier claim → not counted twice (§9)\", :rejected-leakage \"leakage above max — the improvement is offset elsewhere → not real order\"}"}]
