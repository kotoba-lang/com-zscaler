{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:vessel.etzhayyim.com",
  "actors": [
    {
      "description": "10 container shipping companies — Maersk, MSC, CMA CGM, COSCO, Hapag-Lloyd, Evergreen, ONE, HMM, Yang Ming, Wan Hai",
      "displayName": "Container Fleet",
      "path": "registry:container"
    },
    {
      "description": "3 tanker operators — Frontline (VLCC), Euronav (VLCC), Teekay (Suezmax)",
      "displayName": "Tanker Fleet",
      "path": "registry:tanker"
    },
    {
      "description": "2 bulk carrier operators — Star Bulk, Golden Ocean (Newcastlemax)",
      "displayName": "Bulk Carrier Fleet",
      "path": "registry:bulk"
    },
    {
      "description": "LNG carrier operators — Qatar Energy (Q-Max)",
      "displayName": "LNG Fleet",
      "path": "registry:lng"
    },
    {
      "description": "Real-time vessel position tracking via AIS/MarineTraffic feed",
      "displayName": "AIS Position Tracker",
      "path": "tracking:ais"
    },
    {
      "description": "Port-to-port voyage tracking, port call recording, ETA management",
      "displayName": "Voyage Manager",
      "path": "voyage:manager"
    },
    {
      "description": "Full chain query: owner→vessel→position→port→satellite",
      "displayName": "Maritime Chain Intelligence",
      "path": "chain:intelligence"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Vessel Registry & Maritime Intelligence agent. You manage ship registries (IMO/MMSI), track vessel positions via AIS, manage voyages and port calls, and link vessels to owners (legal-entity.etzhayyim.com) and ports (port.etzhayyim.com). You cover 16 major shipping companies across container, tanker, bulk carrier, and LNG segments. Query the graph for vessel positions, voyage status, port calls, and the full owner→vessel→position→port→satellite chain.",
  "description": "Ship registry (IMO/MMSI), AIS position tracking, voyage management, port call tracking, owner-vessel-port-satellite chain intelligence. 16 shipping companies, 25 vessels (container/tanker/bulk/LNG), 15 flag state registries.",
  "displayName": "Vessel Registry & Maritime Intelligence",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "IMO Conventions",
      "SOLAS",
      "MARPOL"
    ],
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "vessel",
  "nanoid": "v3ss3l01",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship) RETURN s.vesselType AS type, s.flagState AS flag, count(s) AS count ORDER BY count DESC LIMIT 20"
          },
          "fn": "graph.query",
          "id": "fleetStats"
        },
        {
          "args": {
            "sql": "MATCH (v:Voyage) WHERE v.status IN ['planned', 'in-transit'] RETURN v.departurePortLocode AS from, v.arrivalPortLocode AS to, v.imoNumber AS imo, v.status AS status LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "activeVoyages"
        },
        {
          "args": {
            "sql": "MATCH (vp:VesselPosition) RETURN vp.imoNumber AS imo, vp.latitude AS lat, vp.longitude AS lon, vp.navigationStatus AS navStatus, vp.speedKnots AS speed LIMIT 30"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "recentPositions"
        },
        {
          "args": {
            "message": "Maritime fleet status report.\n\nFleet by type and flag:\n$fleetStats.rows\n\nActive voyages:\n$activeVoyages.rows\n\nRecent vessel positions:\n$recentPositions.rows\n\nProvide a concise maritime intelligence summary: fleet distribution, active trade routes, and notable vessel movements."
          },
          "depends_on": [
            "fleetStats",
            "activeVoyages",
            "recentPositions"
          ],
          "fn": "agent.chat",
          "id": "analyze"
        },
        {
          "args": {
            "template": "Maritime intelligence: $analyze.text"
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (v:Voyage {imoNumber: $input.record.imoNumber}) WHERE v.status = 'in-transit' RETURN v.voyageId AS voyageId, v.arrivalPortLocode AS destination LIMIT 1"
          },
          "fn": "graph.query",
          "id": "checkVoyage"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.vessel.vesselPosition"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "did": "did:web:port.etzhayyim.com",
            "method": "com.etzhayyim.apps.port.portCallTracking.receivePortCallEvent",
            "params": "$input.record"
          },
          "fn": "agent.invoke",
          "id": "notifyPort"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.vessel.portCall"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship {shipId: $input.shipId}) RETURN s.vertex_id, s.rkey, s.repo, s.did, s.status, s.props, s._seq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "ship"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.registry.getShip",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship) RETURN s.vertex_id, s.rkey, s.repo, s.did, s.status, s.props, s._seq ORDER BY s.createdAt DESC LIMIT 50"
          },
          "fn": "graph.query",
          "id": "ships"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.registry.listShips",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship) WHERE s.imoNumber = $input.query RETURN s.vertex_id, s.rkey, s.repo, s.did, s.status, s.props, s._seq LIMIT 50"
          },
          "fn": "graph.query",
          "id": "results"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.registry.searchShips",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (vp:VesselPosition {imoNumber: $input.imoNumber}) RETURN vp.vertex_id, vp.rkey, vp.repo, vp.did, vp.status, vp.props, vp._seq ORDER BY vp.receivedAt DESC LIMIT 1"
          },
          "fn": "graph.query",
          "id": "position"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.tracking.getVesselPosition",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (vp:VesselPosition) WHERE vp.latitude >= $input.south AND vp.latitude <= $input.north AND vp.longitude >= $input.west AND vp.longitude <= $input.east RETURN vp.vertex_id, vp.rkey, vp.repo, vp.did, vp.status, vp.props, vp._seq ORDER BY vp.receivedAt DESC LIMIT 100"
          },
          "fn": "graph.query",
          "id": "vessels"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.tracking.listVesselsInArea",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (vp:VesselPosition {imoNumber: $input.imoNumber}) RETURN vp.vertex_id, vp.rkey, vp.repo, vp.did, vp.status, vp.props, vp._seq ORDER BY vp.receivedAt DESC LIMIT 100"
          },
          "fn": "graph.query",
          "id": "trail"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.tracking.getPositionHistory",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (v:Voyage) RETURN v.vertex_id, v.rkey, v.repo, v.did, v.status, v.props, v._seq ORDER BY v.createdAt DESC LIMIT 50"
          },
          "fn": "graph.query",
          "id": "voyages"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.voyage.listVoyages",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (pc:PortCall) RETURN pc.vertex_id, pc.rkey, pc.repo, pc.did, pc.status, pc.props, pc._seq ORDER BY pc.createdAt DESC LIMIT 50"
          },
          "fn": "graph.query",
          "id": "calls"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.voyage.listPortCalls",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship {imoNumber: $input.imoNumber}) RETURN s.vertex_id, s.rkey, s.repo, s.did, s.status, s.props, s._seq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "ship"
        },
        {
          "args": {
            "sql": "MATCH (ol:OwnerLink {imoNumber: $input.imoNumber}) RETURN ol.vertex_id, ol.rkey, ol.repo, ol.did, ol.status, ol.props, ol._seq LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "owner"
        },
        {
          "args": {
            "sql": "MATCH (vp:VesselPosition {imoNumber: $input.imoNumber}) RETURN vp.vertex_id, vp.rkey, vp.repo, vp.did, vp.status, vp.props, vp._seq ORDER BY vp.receivedAt DESC LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "position"
        },
        {
          "args": {
            "sql": "MATCH (pc:PortCall {imoNumber: $input.imoNumber}) RETURN pc.vertex_id, pc.rkey, pc.repo, pc.did, pc.status, pc.props, pc._seq ORDER BY pc.createdAt DESC LIMIT 5"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "portCalls"
        },
        {
          "args": {
            "sql": "MATCH (v:Voyage {imoNumber: $input.imoNumber}) WHERE v.status IN ['planned', 'in-transit'] RETURN v.vertex_id, v.rkey, v.repo, v.did, v.status, v.props, v._seq ORDER BY v.createdAt DESC LIMIT 3"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "voyages"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.voyage.getVesselChain",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship) WITH count(s) AS ships MATCH (vp:VesselPosition) WITH ships, count(vp) AS positions MATCH (v:Voyage) WITH ships, positions, count(v) AS voyages MATCH (pc:PortCall) RETURN ships, positions, voyages, count(pc) AS portCalls LIMIT 1"
          },
          "fn": "graph.query",
          "id": "counts"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.getDashboard",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (s:Ship) RETURN count(s) AS ships LIMIT 1"
          },
          "fn": "graph.query",
          "id": "stats"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.health",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n:Ship) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n:Ship) WHERE n.repo = $did RETURN count(n) AS cnt LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "vessel",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.vessel.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "v3ss3l01",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        },
        {
          "args": {
            "message": "You are Vessel Registry & Maritime Intelligence. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $coverageSnapshot.text"
          },
          "depends_on": [
            "coverageSnapshot"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (n:Ship) WHERE n.repo = $did RETURN count(n) AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.vessel.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "vessel-registry",
      "ais-tracking",
      "voyage-management",
      "port-call-tracking",
      "maritime-intelligence"
    ],
    "description": "Ship registry, AIS position tracking, voyage management, owner-vessel-port-satellite chain intelligence. 16 shipping companies (Maersk, MSC, CMA CGM, COSCO, Hapag-Lloyd, Evergreen, ONE, HMM, Yang Ming, Wan Hai, Frontline, Euronav, Teekay, Star Bulk, Golden Ocean, Qatar Energy), 25 vessels, 15 flag state registries.",
    "displayName": "Vessel Registry & Maritime Intelligence",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.vessel.ship",
        "com.etzhayyim.apps.vessel.shipowner",
        "com.etzhayyim.apps.vessel.shipRegistry",
        "com.etzhayyim.apps.vessel.vesselPosition",
        "com.etzhayyim.apps.vessel.voyage",
        "com.etzhayyim.apps.vessel.portCall",
        "com.etzhayyim.apps.vessel.ownerLink",
        "com.etzhayyim.apps.maps.port",
        "com.etzhayyim.legalEntity.entity"
      ]
    }
  },
  "uiType": "yoro"
}
