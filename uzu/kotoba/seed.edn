;; uzu 渦 — seed substrate (ADR-2606211500). Three kinds of row:
;;
;;   :type :world-step  — the organism's environment as a deterministic tape (no Math/random).
;;                        :regime is the hidden truth; :signal is the noisy observation.
;;   :type :organism    — a thermodynamic active-inference agent. :prefs (C) = what MATTERS
;;                        to this subject (= meaning). Same tape, different :prefs ⇒ different
;;                        life, because meaning is subject-dependent.
;;   :type :flow        — a MEASURED real-world energy-like flow, in its NATIVE unit/class
;;                        (physical W / economic USD-yr / informational bit-s / experiential
;;                        index). Real public aggregates (:source), :sourcing :representative.
;;                        NEVER summed across classes. Live ingest is G7 (operator step).
;;   :type :circulation — a coupling edge of the open dissipative system (energy→economy→
;;                        information→attention/meaning→behavior→energy). :from/:to are flow ids.
[
 ;; ───────────────────────── world tape (12 steps) ─────────────────────────────
 {:type :world-step :step 0  :regime :abundant :signal {:nutrient 0.88 :threat 0.12}}
 {:type :world-step :step 1  :regime :benign   :signal {:nutrient 0.50 :threat 0.18}}
 {:type :world-step :step 2  :regime :scarce   :signal {:nutrient 0.20 :threat 0.22}}
 {:type :world-step :step 3  :regime :hostile  :signal {:nutrient 0.42 :threat 0.80}}
 {:type :world-step :step 4  :regime :abundant :signal {:nutrient 0.92 :threat 0.08}}
 {:type :world-step :step 5  :regime :hostile  :signal {:nutrient 0.38 :threat 0.88}}
 {:type :world-step :step 6  :regime :benign   :signal {:nutrient 0.58 :threat 0.12}}
 {:type :world-step :step 7  :regime :scarce   :signal {:nutrient 0.12 :threat 0.25}}
 {:type :world-step :step 8  :regime :abundant :signal {:nutrient 0.85 :threat 0.15}}
 {:type :world-step :step 9  :regime :hostile  :signal {:nutrient 0.45 :threat 0.82}}
 {:type :world-step :step 10 :regime :benign   :signal {:nutrient 0.60 :threat 0.10}}
 {:type :world-step :step 11 :regime :scarce   :signal {:nutrient 0.18 :threat 0.20}}

 ;; ───────────────────────── organisms (same tape, different meaning) ──────────
 ;; kurage 海月 — values nutrient, threat-averse: forages abundance, flees hostility ⇒ SURVIVES.
 {:type :organism :id "kurage" :prefs {:nutrient 1.0 :threat 0.0} :temp 0.15 :energy0 12.0
  :note "well-fitted: meaning (C) aligns with the world ⇒ self-maintains"}
 ;; meial 迷い — threat-SEEKING pathology: prefers high-threat outcomes, forages into hostility ⇒ DIES.
 {:type :organism :id "meial"  :prefs {:nutrient 1.0 :threat 1.0} :temp 0.15 :energy0 12.0
  :note "mis-fitted: meaning misreads danger as desirable ⇒ spends without drawing ⇒ death"}
 ;; gyoja 行者 — ascetic: indifferent to nutrient, retreats ⇒ under-draws (illustrative).
 {:type :organism :id "gyoja"  :prefs {:nutrient 0.05 :threat 0.0} :temp 0.15 :energy0 12.0
  :note "different meaning ⇒ different action on the SAME perceptions"}

 ;; ───────────────────────── measured real-world flows ────────────────────────
 ;; :physical — thermodynamic power (W); conserved; dissipates to heat.
 {:type :flow :id "solar"       :label "Solar influx to Earth"        :class :physical :magnitude 1.73e17 :unit "W"
  :source "ultimate free-energy source; ~173,000 TW (NASA insolation)"}
 {:type :flow :id "primary"     :label "World primary energy"         :class :physical :magnitude 1.96e13 :unit "W" :efficiency 0.35
  :source "IEA 2023 ~620 EJ/yr ⇒ ~19.6 TW"}
 {:type :flow :id "electricity" :label "Global electricity"           :class :physical :magnitude 3.30e12 :unit "W" :efficiency 0.90
  :source "Our World in Data 2023 ~29,000 TWh/yr ⇒ ~3.3 TW"}
 {:type :flow :id "datacenter"  :label "Datacenter power"             :class :physical :magnitude 5.20e10 :unit "W" :efficiency 0.10
  :source "IEA 2022 ~460 TWh/yr ⇒ ~52 GW (kasa sibling)"}
 {:type :flow :id "metabolism"  :label "Human basal metabolism"       :class :physical :magnitude 8.10e11 :unit "W" :efficiency 0.25
  :source "8.1e9 people × ~100 W ⇒ ~0.81 TW"}

 ;; :economic — money flow as economic free energy (USD/yr); NOT joules.
 {:type :flow :id "gdp"         :label "Gross world product"          :class :economic :magnitude 1.05e14 :unit "USD/yr"
  :source "World Bank 2023 ~$105T/yr (kanjō sibling)"}
 {:type :flow :id "fx"          :label "FX market turnover"           :class :economic :magnitude 2.70e15 :unit "USD/yr"
  :source "BIS 2022 ~$7.5T/day gross ⇒ ~$2,700T/yr (shionome sibling)"}

 ;; :informational — information flux (bit/s); free energy in nats; NOT joules.
 {:type :flow :id "internet"    :label "Global IP traffic"            :class :informational :magnitude 1.27e15 :unit "bit/s"
  :source "Cisco/Statista ~5 ZB/yr ⇒ ~1.27 Pbit/s"}
 {:type :flow :id "mobile"      :label "Mobile/edge traffic"          :class :informational :magnitude 4.00e14 :unit "bit/s"
  :source "Ericsson Mobility ~representative"}

 ;; :experiential — attention/affect/meaning (index 0..1); SUBJECT-DEPENDENT; NOT joules.
 {:type :flow :id "attention"   :label "Human waking attention"       :class :experiential :magnitude 0.62 :unit "index"
  :source "8.1e9 people × ~16 waking h/day, normalized; subject-dependent"}
 {:type :flow :id "meaning"     :label "Collective meaning intensity" :class :experiential :magnitude 0.45 :unit "index"
  :source "Spirit-in-Physics 霊性 (ADR-2606011501) — edge-primary, no score-of-soul"}

 ;; ───────────────────────── circulation (the open dissipative loop) ──────────
 {:type :circulation :from "solar"       :to "primary"     :coupling "sun drives energy capture"          :cross-class false}
 {:type :circulation :from "primary"     :to "electricity" :coupling "conversion"                          :cross-class false}
 {:type :circulation :from "primary"     :to "metabolism"  :coupling "food is captured primary energy"     :cross-class false}
 {:type :circulation :from "electricity" :to "datacenter"  :coupling "powers compute"                       :cross-class false}
 {:type :circulation :from "electricity" :to "gdp"         :coupling "energy powers the economy"            :cross-class true}
 {:type :circulation :from "datacenter"  :to "internet"    :coupling "compute emits information"            :cross-class true}
 {:type :circulation :from "datacenter"  :to "mobile"      :coupling "compute emits information"            :cross-class true}
 {:type :circulation :from "metabolism"  :to "attention"   :coupling "bodies/brains produce attention"      :cross-class true}
 {:type :circulation :from "internet"    :to "meaning"     :coupling "information shapes meaning"            :cross-class true}
 {:type :circulation :from "mobile"      :to "meaning"     :coupling "information shapes meaning"            :cross-class true}
 {:type :circulation :from "gdp"         :to "fx"          :coupling "money circulates"                      :cross-class false}
 {:type :circulation :from "fx"          :to "gdp"         :coupling "money returns"                         :cross-class false}
 {:type :circulation :from "gdp"         :to "electricity" :coupling "economy funds/demands energy"          :cross-class true}
 {:type :circulation :from "attention"   :to "gdp"         :coupling "attention economy → activity"          :cross-class true}
 {:type :circulation :from "meaning"     :to "attention"   :coupling "meaning directs attention"             :cross-class false}
]
