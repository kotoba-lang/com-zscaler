{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:nyusatsu.etzhayyim.com",
  "name": "nyusatsu",
  "nanoid": "nyu5at5u",
  "displayName": "Nyusatsu — JP Public Procurement Aggregator",
  "description": "Self-hosted alternative to NJSS. Crawls 全省庁 (GEPS) + 47都道府県 + 1,718市町村 + 独法 + 特殊法人 入札公告 pages and normalizes into com.etzhayyim.apps.jpFiscal.procurementBid. Replaces paid NJSS API dependency (ADR-0035).",
  "performerType": "service",
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "heartbeatRequired": true,
  "domainKnowledgeRequired": true,
  "uiType": "yoro",
  "governance": {
    "classification": "internal",
    "raci": "responsible",
    "complianceFrameworks": [
      "robots.txt 順守 (source ごと検査)",
      "会計法 29 条 (入札公告は公表必須 — 再配信許容)",
      "地方自治法 234 条",
      "情報公開法 5 条"
    ]
  },
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "crawl-bid-portal",
      "normalize-bid",
      "emit-bid-record",
      "award-link-contract",
      "dedupe-crossref"
    ],
    "description": "Public procurement aggregator — central gov + prefecture + municipality + incorp.",
    "displayName": "Nyusatsu",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "capabilities": [
    "graph.query",
    "graph.write",
    "derive:social",
    "agent.chat",
    "http.fetch"
  ],
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.jpFiscal.procurementBid",
        "com.etzhayyim.apps.jpFiscal.contract"
      ]
    }
  },
  "sources": [
    {
      "id": "geps",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.geps.go.jp/",
      "rate_ms": 1500,
      "note": "政府電子調達。全省庁共通の電子入札システム。"
    },
    {
      "id": "mof",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.mof.go.jp/public_procurement/",
      "rate_ms": 2000
    },
    {
      "id": "mlit",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.mlit.go.jp/page/kanbo01_hy_000004.html",
      "rate_ms": 2000
    },
    {
      "id": "meti",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.meti.go.jp/information/procurement/",
      "rate_ms": 2000
    },
    {
      "id": "mext",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.mext.go.jp/b_menu/nyusatsu/",
      "rate_ms": 2000
    },
    {
      "id": "mhlw",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.mhlw.go.jp/general/sikaku/chotatu.html",
      "rate_ms": 2000
    },
    {
      "id": "bouei",
      "tier": "central",
      "kind": "html",
      "entry": "https://www.mod.go.jp/j/procurement/",
      "rate_ms": 2000
    },
    {
      "id": "tokyo-pref",
      "tier": "prefecture",
      "kind": "html",
      "entry": "https://www.e-procurement.metro.tokyo.lg.jp/",
      "rate_ms": 1500,
      "note": "47 prefectures 全て source 登録が必要。tokyo を pilot として拡張。"
    },
    {
      "id": "yokohama",
      "tier": "municipality",
      "kind": "html",
      "entry": "https://e-nyusatsu.city.yokohama.lg.jp/",
      "rate_ms": 1500
    },
    {
      "id": "ipa",
      "tier": "incorp",
      "kind": "html",
      "entry": "https://www.ipa.go.jp/about/nyuusatsu/",
      "rate_ms": 2000
    }
  ],
  "pipelines": [
    {
      "trigger": {
        "type": "cron",
        "cron": "0 */6 * * *"
      },
      "steps": [
        {
          "id": "crawl-central",
          "fn": "http.fetch.batch",
          "args": {
            "scope": "central",
            "concurrency": 1,
            "respectRobots": true
          }
        },
        {
          "id": "normalize-central",
          "depends_on": [
            "crawl-central"
          ],
          "fn": "agent.map",
          "args": {
            "template": "Extract procurement bid fields (tenderNo, title, issuerDid, method, estimatedJpy, openedAt, closedAt, tenderUrl) from raw HTML/PDF. Emit as com.etzhayyim.apps.jpFiscal.procurementBid records.",
            "model": "resolveModelId('jp-structured-extract')"
          }
        },
        {
          "id": "dedupe-emit",
          "depends_on": [
            "normalize-central"
          ],
          "fn": "graph.write",
          "args": {
            "template": "MERGE bid record by tenderNo, MERGE edge_etzhayyim_fiscal_flow (to_did=awardedContractDid, stage=L1, derivation_stage=L1)"
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "cron",
        "cron": "30 */12 * * *"
      },
      "steps": [
        {
          "id": "crawl-lg",
          "fn": "http.fetch.batch",
          "args": {
            "scope": "prefecture,municipality",
            "concurrency": 1,
            "respectRobots": true
          }
        },
        {
          "id": "normalize-lg",
          "depends_on": [
            "crawl-lg"
          ],
          "fn": "agent.map",
          "args": {
            "template": "extract procurement fields per LG source schema"
          }
        },
        {
          "id": "emit-lg",
          "depends_on": [
            "normalize-lg"
          ],
          "fn": "graph.write",
          "args": {
            "template": "MERGE bid"
          }
        }
      ]
    },
    {
      "trigger": {
        "type": "xrpc",
        "nsid": "com.etzhayyim.apps.nyusatsu.resolveAward"
      },
      "steps": [
        {
          "id": "link-award",
          "fn": "graph.write",
          "args": {
            "template": "MATCH (b:ProcurementBid {tenderNo:$tenderNo})-[:AWARDED_TO]->(c:Contract {contractNo:$contractNo}) SET b.awardedContractDid = c.did, b.awardedAmountJpy = c.amountJpy, b.awardedAt = $awardedAt"
          }
        }
      ]
    }
  ],
  "derive": [
    {
      "from": "com.etzhayyim.apps.jpFiscal.procurementBid",
      "emit": {
        "$type": "app.bsky.feed.post",
        "text": "入札公告: {{ issuerDisplayName }} {{ method }} 予定価格 {{ estimatedJpy | yenFormat }} — 開札 {{ closedAt | jpDate }}",
        "embed": {
          "$type": "app.bsky.embed.external",
          "external": {
            "uri": "{{ tenderUrl }}"
          }
        },
        "langs": [
          "ja"
        ]
      }
    }
  ],
  "complianceDocs": [
    "90-docs/adr/0035-jp-tax-money-flow-reverse-topology.md",
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md"
  ],
  "convoSystemPrompt": "You are the Nyusatsu actor — a self-hosted public procurement aggregator for Japan. Crawl government bid portals (central, prefecture, municipality, incorp) politely (robots.txt + 1.5s rate limit), extract structured bid fields via Murakumo LLM, and emit com.etzhayyim.apps.jpFiscal.procurementBid records. Link to contract records on award. Never rely on paid third-party aggregators.",
  "convention": "Bid records are owned by issuer DID (did:web:gov.etzhayyim.com:country:jpn:{agency}); nyusatsu itself only writes when issuer DID resolution is pending. Reconcile ownership during linkAward."
}
