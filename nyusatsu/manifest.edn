;; ADR-2606271700: JP→worldwide public-procurement mirror, OCDS-normalized, jurisdiction-attributed.
{:actor/glyph "入札"
 :actor/display-name "入札 — Worldwide Public-Procurement Mirror"
 :actor/id "nyusatsu"
 :actor/did "did:web:etzhayyim.com:actor:nyusatsu"
 :actor/tier :tier-b
 :actor/integrates ["danjo"]
 :actor/status :r1-offline    ;; R0 design + R1 offline clj green; G8 UNLOCKED (founder Lv7+ 2026-06-27), R2 residence pending
 :actor/adr ["2606271700" "2606072000"]

 :actor/purpose
 "Mirrors PUBLIC government procurement notices/awards worldwide (tenders, 入札公告/開札) into
  the kotoba Datom log as append-only, ATTRIBUTED, primary-sourced events, OCDS-normalized and
  keyed by ocid. Each tender is published BY a named issuer agency (attributed); etzhayyim
  authors no tender, predicts no winner, ranks no bidder. JP (the legacy nyusatsu/NJSS-replacement
  scope) is one jurisdiction adapter among many."

 :actor/non-goals
 {"N1" "NOT a tender-aggregation PRODUCT with winner prediction / bid scoring (non-adjudicating; G2)"
  "N2" "NOT a lobbying / who-to-influence target-list (map-not-target; G9)"
  "N3" "NOT a per-bidder risk / corruption score (edge-primary; we never rate a participant)"
  "N4" "NOT a paid-aggregator client (NJSS / 官公需ウォッチャー / commercial tender terminals prohibited as citation; G3)"
  "N5" "NOT a doxxing vector — bidder PII (sole-proprietor address etc.) is Tier-3, off-graph encrypted (G5)"
  "N6" "NOT an adopter of any jurisdiction's procurement-law stance — every notice stays attributed to its issuer"
  "N7" "NOT a RisingWave/SQL store (kotoba Datom log only; supersedes legacy jpFiscal RisingWave pipeline)"
  "N8" "NOT a contract-record owner — issuer agency DID owns com.etzhayyim.apps.govFiscal.contract; nyusatsu links award↔contract only"}

 :actor/lexicons
 ["com.etzhayyim.apps.govFiscal.procurementBid"   ;; new, jurisdiction-neutral, OCDS-aligned (ADR §2)
  "com.etzhayyim.apps.govFiscal.contract"          ;; owned by issuer DID; nyusatsu writes only resolveAward link
  "com.etzhayyim.apps.standard.shinkaEvolution"
  "com.etzhayyim.apps.standard.shinkaKnowledge"]

 :actor/cells
 [{"name" "nyusatsu_ocds_ingest"
   "module" "magatama.cells.nyusatsu_ocds_ingest"
   "murakumoNode" "reuben" "phase" "continuous"
   "io" "an OCDS/REST source (ProZorro/UK-FTS/MX/AU/CA/EU-eForms/…) → OCDS releases → normalized govFiscal.procurementBid datoms; NO LLM (structured)"}
  {"name" "nyusatsu_html_extract"
   "module" "magatama.cells.nyusatsu_html_extract"
   "murakumoNode" "reuben" "phase" "continuous"
   "io" "an HTML/PDF source (GEPS / 省庁 / 自治体 / non-OCDS portals) → Murakumo structured-extract → govFiscal.procurementBid datoms (fallback path)"}
  {"name" "nyusatsu_normalize_dedup"
   "module" "magatama.cells.nyusatsu_normalize_dedup"
   "murakumoNode" "gad" "phase" "continuous"
   "io" "raw bid datoms → MERGE by ocid; ISO-4217 currency / ISO-8601 date / OCDS-method normalization; CPV↔UNSPSC cross-walk; award→contract edge"}
  {"name" "nyusatsu_resolve_award"
   "module" "magatama.cells.nyusatsu_resolve_award"
   "murakumoNode" "gad" "phase" "event (xrpc com.etzhayyim.apps.nyusatsu.resolveAward)"
   "io" "award datom → edge_etzhayyim_fiscal_flow to govFiscal.contract / issuer DID; ≥2 primary citations (G3)"}
  {"name" "nyusatsu_social_post"
   "module" "magatama.cells.nyusatsu_social_post"
   "murakumoNode" "naphtali" "phase" "periodic (event)"
   "io" "a bid/award finding → DRY-RUN member-signed multilingual networkPost (sourceLang + en, attributed, mirror disclaimer); live = Council Lv6+ + operator + member signature (G8)"}]

 :actor/gates
 [#:gate{:id "G1" :rule "mirror-not-author — etzhayyim authors no tender; issuer is always an attributed gov DID (did:web:gov.etzhayyim.com:country:<iso3>:<agency>)"}
  #:gate{:id "G2" :rule "non-adjudicating — no winner prediction, no bidder ranking/score, no corruption/collusion verdict; a notice is reported, never judged"}
  #:gate{:id "G3" :rule "primary-source-only — ≥1 (≥2 for award) of the ISSUER's OWN publications; paid aggregators / commercial tender terminals are a prohibited citation"}
  #:gate{:id "G4" :rule "event-log / as-of — tender.status transitions are NEW datoms (planning→active→complete/cancelled/unsuccessful); nothing overwritten"}
  #:gate{:id "G5" :rule "PII — bidder sole-proprietor address / personal identifiers = Tier-3 (ADR-0018); redaction hook mandatory; encrypted off-graph"}
  #:gate{:id "G6" :rule "robots/legality — per-source robots.txt + rate-limit (≥1500ms default); rely on each jurisdiction's publication mandate (JP 会計法29/地方自治法234/情報公開法; EU TED; etc.)"}
  #:gate{:id "G7" :rule "no-server-key (NON-CUSTODIAL, NOT anti-automation) — holds NO platform-custodial unilateral signing key; READ-ONLY public ingest is EXEMPT (autonomous fetch, no key/operator, ADR-2606072802); autonomous writes/posts allowed via the actor's OWN sealed did:key (off-platform Keychain/1Password, present-only) + member CACAO leash (kaname/ibuki/tsubasa, ADR-2605231525/2606111400); posts member-signed (server-held-key false); no :tender/risk or :bidder/score"}
  #:gate{:id "G8" :rule "outward-gated (DISTINCT from G7, do not conflate) — live POSTING + award/contract WRITES = Council Lv6+ (PR-review attestation) + member signature. *** UNLOCKED: founder Lv7+ attested 2026-06-27 (ADR-2606271700 §8.1) *** — outbound now AUTHORIZED, but still requires the R2 residence legs + the actor's sealed did:key + member CACAO leash (G7) before any live post fires; G8 lifts the gate, it does not build the pipeline. READ-ONLY ingest is NOT G8-gated (inbound ≠ outbound) and runs autonomously at residence (R2)"}
  #:gate{:id "G9" :rule "map-not-target / no-enforcement — outputs route to transparency / SME market-access / spend visibility; never a who-to-lobby/influence/collude target-list"}
  #:gate{:id "G10" :rule "sourcing-honesty — :representative (synthetic seed) vs :authoritative declared on every datom; committed seed is :representative"}]

 :actor/capabilities ["graph.query" "graph.write" "http.fetch" "agent.map" "derive:social"]
 :actor/required-loops ["shinka" "koji" "kyumei" "domain-knowledge"]
 :actor/standard-rule "per-did-kyumei-shinka-autonomy@2026-04-13"

 :actor/source-registry "registry/sources.edn"  ;; worldwide, tiered (ADR §3)

 :actor/triggers
 {:cron [{:scope :supranational :cron "0 */6 * * *"}
         {:scope :national      :cron "0 */6 * * *"}
         {:scope :subnational   :cron "30 */12 * * *"}
         {:scope :standard-feed :cron "0 3 * * *"}]   ;; OCDS data-registry discovery → shinka
  :xrpc ["com.etzhayyim.apps.nyusatsu.resolveAward"]
  :subscribeRepos {:collections ["com.etzhayyim.apps.govFiscal.procurementBid"
                                 "com.etzhayyim.apps.govFiscal.contract"]}}

 :actor/compliance-docs
 ["90-docs/adr/2606271700-nyusatsu-worldwide-procurement-social-actor.md"
