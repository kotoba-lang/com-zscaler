// Zoox clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace zoox {

    entity Vehicle {
        id: string @unique
        vin: string
        model: string
        state: string
        odometerKm: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Signal {
        id: string @unique
        vehicleId: string
        name: string
        value: float
        unit: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity ChargeSession {
        id: string @unique
        vehicleId: string
        connectorId: string
        energyKwh: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Connector {
        id: string @unique
        stationId: string
        standard: string
        powerKw: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Trip {
        id: string @unique
        vehicleId: string
        distanceKm: float
        startedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Command {
        id: string @unique
        vehicleId: string
        name: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
