try-surveillance :product-sales :fear-marketing :ad-targeting :manipulation}, :tsuchifumi.ontology/node-kinds "[{:kind :region, :doc \"A region / population cohort under earthing-EMF Wellbecoming assessment. Carries DISCLOSED exposure factors (ambient EMF, device-hours, indoor-fraction) + earthing-access / institutional-grounding factors. Aggregate only — no individual is representable (G3).\", :keys [:id :name :kind :population-weight :ambient-emf :device-hours :indoor-fraction :barefoot-access :greenspace-access :grounded-building :footwear-insulation :grounding-policy :consent :note]} {:kind :evidence, :doc \"An evidence-catalog record: a CLAIM about earthing/EMF, its evidence TIER, domain, and DISCLOSED source. The honesty layer — analyze weights every burden by the tier of the claim it rests on; a :contested/:anecdotal claim is never asserted as established harm (G2).\", :keys [:id :claim :tier :domain :source :note]} {:kind :driver, :doc \"A risk DRIVER of the earthing-EMF gap (e.g. urbanization, insulated footwear ubiquity, screen-time growth, missing grounding standards). Carries likelihood × impact × evidence-confidence + a Meadows leverage level + reversibility — the risk register + leverage-point input.\", :keys [:id :name :likelihood :impact :evidence-tier :leverage :reversibility :note]}]"}]
