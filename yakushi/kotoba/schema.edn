;; yakushi 薬師 — kotoba EAVT schema
;; ADR-2605250500 · R0 scaffold
;; Defines the schema for pharmaceutical manufacturing data.

[;; ───────────────────────────── :rawMaterialAttestation/* ─────────────────────────────
 {:db/ident :rawMaterialAttestation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for raw material attestation"}
 {:db/ident :rawMaterialAttestation/materialName
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Name of raw material"}
 {:db/ident :rawMaterialAttestation/grade
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Material grade (公定 or 劇物)"}
 {:db/ident :rawMaterialAttestation/hazardClass
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Hazard classification"}

 ;; ───────────────────────────── :apiSynthesisAttestation/* ─────────────────────────────
 {:db/ident :apiSynthesisAttestation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for API synthesis attestation"}
 {:db/ident :apiSynthesisAttestation/apiName
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "API (active pharmaceutical ingredient) name"}
 {:db/ident :apiSynthesisAttestation/route
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Synthesis route (published literature reference)"}
 {:db/ident :apiSynthesisAttestation/witness1
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "First witness DID"}
 {:db/ident :apiSynthesisAttestation/witness2
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Second witness DID"}

 ;; ───────────────────────────── :fillFinishAttestation/* ─────────────────────────────
 {:db/ident :fillFinishAttestation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for fill-finish attestation"}
 {:db/ident :fillFinishAttestation/productForm
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Product form (eye-drop, tablet, topical)"}
 {:db/ident :fillFinishAttestation/sterileProcess
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Sterilization method"}
 {:db/ident :fillFinishAttestation/witnessOperator
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Process operator witness DID"}
 {:db/ident :fillFinishAttestation/witnessQp
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "QP witness DID"}

 ;; ───────────────────────────── :qcAttestation/* ─────────────────────────────
 {:db/ident :qcAttestation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for QC attestation"}
 {:db/ident :qcAttestation/lotId
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Lot ID"}
 {:db/ident :qcAttestation/testResults
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "QC test results"}
 {:db/ident :qcAttestation/qpDid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Qualified Person DID"}
 {:db/ident :qcAttestation/verdict
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Release verdict (release or reject)"}

 ;; ───────────────────────────── :lotAttestation/* ─────────────────────────────
 {:db/ident :lotAttestation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for lot attestation"}
 {:db/ident :lotAttestation/lotId
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Manufacturing lot ID"}
 {:db/ident :lotAttestation/lotDid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Lot-specific DID"}
 {:db/ident :lotAttestation/apiName
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Active pharmaceutical ingredient name"}
 {:db/ident :lotAttestation/manufacturingDate
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Manufacturing date"}
 {:db/ident :lotAttestation/expirationDate
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Expiration/shelf-life date"}

 ;; ───────────────────────────── :adverseEventReport/* ─────────────────────────────
 {:db/ident :adverseEventReport/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for adverse event report"}
 {:db/ident :adverseEventReport/lotId
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Associated lot ID (no patient DID)"}
 {:db/ident :adverseEventReport/severity
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Severity level (mild, moderate, severe)"}
 {:db/ident :adverseEventReport/outcome
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Event outcome (recovered, not-recovered, unknown)"}
 {:db/ident :adverseEventReport/eventCid
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "IPFS CID of encrypted event envelope"}

 ;; ───────────────────────────── :settlementIntent/* ─────────────────────────────
 {:db/ident :settlementIntent/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for settlement intent"}
 {:db/ident :settlementIntent/grossMinor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Gross amount in USDC minor units"}
 {:db/ident :settlementIntent/titheMinor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "10% tithe amount in USDC minor units"}
 {:db/ident :settlementIntent/makerPayoutMinor
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "Maker payout (gross - tithe) in minor units"}
 {:db/ident :settlementIntent/state
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Settlement state (intent or executed)"}
 {:db/ident :settlementIntent/buyerSigRef
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Buyer signature reference (if executed)"}

 ;; ───────────────────────────── :formulationAttestation/* (Wave 2, ADR-2606171400) ─────────────────────────────
 ;; Disinfectant / antiseptic FORMULATION (diluted / blended from generic off-patent
 ;; actives) — distinct from :apiSynthesisAttestation (de-novo synthesis).
 {:db/ident :formulationAttestation/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "Unique ID for disinfectant formulation attestation"}
 {:db/ident :formulationAttestation/activeName
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Disinfectant active INN slug (ethanol, sodium-hypochlorite, povidone-iodine, …)"}
 {:db/ident :formulationAttestation/concPercent
  :db/valueType :db.type/double
  :db/cardinality :db.cardinality/one
  :db/doc "Active concentration in percent (must fall inside G21 efficacy window)"}
 {:db/ident :formulationAttestation/useClass
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Use class (surface, skin-antiseptic, hand-hygiene) — G24"}
 {:db/ident :formulationAttestation/coFormulants
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Comma-joined co-formulants (G22 toxic-gas screen — hypochlorite+acid/ammonia refused)"}
 {:db/ident :formulationAttestation/witness1
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "First witness DID (G9)"}
 {:db/ident :formulationAttestation/witness2
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Second witness DID (G9)"}

 ;; ───────────────────────────── :yakushiSbtEligibility/* ─────────────────────────────
 {:db/ident :yakushiSbtEligibility/did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "DID of SBT-eligible member"}
 {:db/ident :yakushiSbtEligibility/role
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "Role (process-operator, qp-equivalent, quality-analyst)"}
 ]
