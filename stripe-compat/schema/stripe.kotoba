// Stripe clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace stripe {

    entity Customer {
        id: string @unique
        email: string
        name: string
        phone: string
        balance: integer
        currency: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity PaymentIntent {
        id: string @unique
        customer: string
        amount: integer
        currency: string
        status: string
        description: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Charge {
        id: string @unique
        customer: string
        paymentIntent: string
        amount: integer
        currency: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Refund {
        id: string @unique
        charge: string
        amount: integer
        reason: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Invoice {
        id: string @unique
        customer: string
        amountDue: integer
        currency: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Subscription {
        id: string @unique
        customer: string
        priceId: string
        status: string
        currentPeriodEnd: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Product {
        id: string @unique
        name: string
        description: string
        active: boolean
        createdAt: datetime
        updatedAt: datetime
    }

    entity Price {
        id: string @unique
        product: string
        unitAmount: integer
        currency: string
        recurringInterval: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }

