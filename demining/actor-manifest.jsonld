{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:demining.etzhayyim.com",
  "name": "demining",
  "nanoid": "TBD",
  "displayName": "Demining — Humanitarian Mine Action",
  "description": "Humanitarian Mine Action (HMA) agent: Non-Technical Survey, Technical Survey, clearance task lifecycle, Land Release (IMAS 07.11), Explosive Ordnance Risk Education (IMAS 12.10), victim assistance referral, detector / PPE / MDD / flail inventory. IMSMA-compatible. Ottawa Treaty (APMBC) + CCM + CCW Protocol V aligned. Scope excludes manufacture, possession, or transfer of anti-personnel mines.",
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "performerType": "service",
  "heartbeatRequired": true,
  "domainKnowledgeRequired": true,
  "governance": {
    "classification": "restricted",
    "raci": "responsible",
    "rationale": "SHA/CHA coordinates and victim PII are Tier 3. Only Land Release decisions demote to Tier 1 public Repo."
  },
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "60-apps/etzhayyim-project-demining/CLAUDE.md",
    "60-apps/etzhayyim-project-demining/classifications.jsonld"
  ],
  "convoSystemPrompt": "You are the Demining humanitarian mine action agent. Your scope is IMAS-conformant: Non-Technical Survey (08.10), Technical Survey (08.20), clearance (09.10), EOD (09.30), MDD (09.40), mechanical clearance (09.50), Land Release (07.11), EORE (12.10), victim assistance (13.10), asset inventory. You NEVER assist with manufacture, possession, transfer, or deployment of anti-personnel mines (prohibited under Ottawa Treaty APMBC Art.1 and 日本 対人地雷禁止法). Treat SHA/CHA coordinates, detector hit coordinates, and victim PII as Tier 3 (server-side Preferences, never public AT Repo). Only post-release polygons and aggregate EORE summaries may be published to Tier 1 social feed. Authoritative taxonomy is IMAS; use UNSPSC 46101500 and CPC v2.1 only for procurement/statistics crosswalk. APMBC Art.7 transparency forms (A–J) are the reporting contract for state-party use.",
  "pipelines": [
    {
      "id": "survey-to-social",
      "trigger": { "type": "subscribeRepos", "collections": ["com.etzhayyim.apps.demining.surveyRecord"] },
      "steps": [
        {
          "id": "validateScope",
          "fn": "agent.chat",
          "args": {
            "message": "Validate this survey record is humanitarian mine action (IMAS 08.10/08.20). Reject if scope includes manufacture, stockpile, or deployment of APM. Input: $input.record"
          }
        },
        {
          "id": "writeArea",
          "fn": "graph.write",
          "depends_on": ["validateScope"],
          "args": {
            "template": "MERGE (a:HazardArea {areaId: $input.record.areaId}) SET a.status = $input.record.status, a.imasStage = $input.record.imasStage"
          }
        },
        {
          "id": "announceAggregate",
          "fn": "derive:social",
          "depends_on": ["writeArea"],
          "args": {
            "template": "Survey progress update: $input.record.areaLabel ($input.record.imasStage). Coordinates withheld until Land Release."
          }
        }
      ]
    },
    {
      "id": "land-release-to-public",
      "trigger": { "type": "subscribeRepos", "collections": ["com.etzhayyim.apps.demining.landReleaseDecision"] },
      "steps": [
        {
          "id": "demoteTier",
          "fn": "graph.write",
          "args": {
            "template": "MATCH (a:HazardArea {areaId: $input.record.areaId}) SET a.tier = 1, a.releasedAt = $input.record.decidedAt, a.polygonPublic = $input.record.polygonPublic"
          }
        },
        {
          "id": "publishReleasedArea",
          "fn": "derive:social",
          "depends_on": ["demoteTier"],
          "args": {
            "template": "Land Released per IMAS 07.11: $input.record.areaLabel — $input.record.releasedSqm sqm. Method: $input.record.releaseMethod."
          }
        }
      ]
    },
    {
      "id": "eore-session",
      "trigger": { "type": "subscribeRepos", "collections": ["com.etzhayyim.apps.demining.eoreSession"] },
      "steps": [
        {
          "id": "recordSession",
          "fn": "graph.write",
          "args": {
            "template": "MERGE (s:EoreSession {sessionId: $input.record.sessionId}) SET s.beneficiaries = $input.record.beneficiaries, s.curriculum = $input.record.curriculum"
          }
        },
        {
          "id": "announceEore",
          "fn": "derive:social",
          "depends_on": ["recordSession"],
          "args": {
            "template": "EORE session (IMAS 12.10) delivered — $input.record.beneficiaries beneficiaries reached in $input.record.locationLabel."
          }
        }
      ]
    }
  ],
  "taxonomyRefs": {
    "authoritative": "IMAS",
    "procurement": ["UNSPSC:46101500", "UNSPSC:46101600", "UNSPSC:46181500", "HS2022:9031.80"],
    "statistics": ["CPC:91290", "CPC:94900", "ISIC:8423", "ISIC:9499"],
    "treaty": ["APMBC", "CCM", "CCW Protocol V"]
  },
  "jurisdictionGates": {
    "description": "Per-jurisdiction additional consent + scope gates applied by validateScope pipeline step before any write. Gate keys align with ISO 3166-1 alpha-2 (upper) of the SHA/CHA / victim / asset. Controller must resolve jurisdiction from adminAreaDid before pipeline runs.",
    "default": {
      "allowedActivities": ["survey", "clearance", "release", "eore", "victim-assistance", "asset-inventory"],
      "prohibitedActivities": ["apm-manufacture", "apm-stockpile", "apm-transfer", "apm-deploy", "cm-manufacture", "cm-stockpile", "cm-transfer", "cm-deploy"],
      "consentGate": "nmaa-authorization",
      "tierOverride": null
    },
    "byJurisdiction": {
      "JP": {
        "statutes": ["410AC0000000115 (対人地雷禁止法)", "421AC0000000085 (クラスター弾禁止法)"],
        "treaty": ["APMBC", "CCM"],
        "extraGate": "export-control (外為法)"
      },
      "GB": { "statutes": ["Landmines Act 1998", "Cluster Munitions (Prohibitions) Act 2010"], "treaty": ["APMBC", "CCM"] },
      "CA": { "statutes": ["S.C. 1997 c.33", "S.C. 2014 c.27"], "treaty": ["APMBC", "CCM"], "note": "CCM s.11 interoperability — flag but do not rely on" },
      "AU": { "statutes": ["Anti-Personnel Mines Convention Act 1998", "Criminal Code Div.72 (2012)"], "treaty": ["APMBC", "CCM"] },
      "NZ": { "statutes": ["APM Prohibition Act 1998", "Cluster Munitions Prohibition Act 2009"], "treaty": ["APMBC", "CCM"] },
      "DE": { "statutes": ["AntiPersMinenÜbkAG", "KrWaffKontrG"], "treaty": ["APMBC", "CCM"], "extraGate": "BAFA export control" },
      "FR": { "statutes": ["Loi 98-564", "Loi 2010-819"], "treaty": ["APMBC", "CCM"] },
      "IT": { "statutes": ["Legge 374/1997", "Legge 95/2011"], "treaty": ["APMBC", "CCM"] },
      "ES": { "statutes": ["Ley 33/1998"], "treaty": ["APMBC", "CCM"] },
      "CH": { "statutes": ["KMG SR 514.51"], "treaty": ["APMBC", "CCM"] },
      "BE": { "statutes": ["Loi 9 mars 1995", "Loi 18 mai 2006"], "treaty": ["APMBC", "CCM"] },
      "NL": { "statutes": ["Uitvoeringswet 1999"], "treaty": ["APMBC", "CCM"] },
      "ZA": { "statutes": ["Act 36 of 2003"], "treaty": ["APMBC"] },
      "BR": { "statutes": ["Lei 10.300/2001"], "treaty": ["APMBC"] },
      "CO": {
        "statutes": ["Ley 554/2000", "Ley 759/2002"], "treaty": ["APMBC"],
        "riskLevel": "heavy-contamination",
        "extraGate": "Descontamina Colombia + AICMA sign-off",
        "tierOverride": { "shaCoordsVisibility": "descontamina-only" }
      },
      "KH": {
        "statutes": ["1999 APM Prohibition Law"], "treaty": ["APMBC"],
        "riskLevel": "heavy-contamination",
        "extraGate": "CMAA (Cambodian Mine Action Authority) authorization",
        "tierOverride": { "shaCoordsVisibility": "cmaa-only" }
      },
      "LA": {
        "statutes": ["NRA Decree 2006"], "treaty": ["CCM"],
        "riskLevel": "heavy-cmr-contamination",
        "extraGate": "NRA (National Regulatory Authority for UXO/Mine Action) authorization",
        "tierOverride": { "shaCoordsVisibility": "nra-only" }
      },
      "VN": {
        "statutes": ["Decree 18/2019/ND-CP"], "treaty": [],
        "riskLevel": "heavy-uxo-contamination",
        "extraGate": "VNMAC (Vietnam National Mine Action Centre) authorization",
        "nonParty": true,
        "note": "Non-party to APMBC/CCM. Domestic UXO framework governs."
      },
      "BA": {
        "statutes": ["Demining Law Official Gazette 5/02"], "treaty": ["APMBC"],
        "riskLevel": "heavy-contamination",
        "extraGate": "BHMAC authorization",
        "tierOverride": { "shaCoordsVisibility": "bhmac-only" }
      },
      "HR": { "statutes": ["Zakon o protuminskom djelovanju OG 110/2015"], "treaty": ["APMBC"], "extraGate": "HCR authorization" },
      "UA": {
        "statutes": ["Закон про протимінну діяльність (2018+)"], "treaty": ["APMBC"],
        "riskLevel": "active-conflict + heavy-contamination",
        "extraGate": "MoD + SESU + NMAA sign-off + DSN classification check",
        "tierOverride": { "shaCoordsVisibility": "nmaa-only", "victimPii": "nmaa-only", "operatorPii": "nmaa-only" },
        "note": "Active conflict. SHA/CHA coords may be protected under Ukrainian State Secrets (DSN) regime. Assume Tier 3 absolute until explicit NMAA release."
      },
      "AF": {
        "statutes": ["2004 APM Law (Islamic Republic era)"], "treaty": ["APMBC"],
        "riskLevel": "heavy-contamination + governance-uncertain",
        "extraGate": "DMAC (Directorate of Mine Action Coordination) via UNMAS liaison",
        "tierOverride": { "shaCoordsVisibility": "unmas-dmac-only", "victimPii": "unmas-dmac-only" },
        "note": "Post-2021 de facto authorities; operate via UNMAS-brokered access. Operator PII especially sensitive."
      },
      "IQ": {
        "statutes": ["Law No. 20 of 2009 (DMA)"], "treaty": ["APMBC"],
        "riskLevel": "heavy-contamination",
        "extraGate": "DMA (Directorate for Mine Action) authorization + IKMAA (Kurdistan region)",
        "tierOverride": { "shaCoordsVisibility": "dma-only" }
      },
      "MM": {
        "statutes": [], "treaty": [],
        "riskLevel": "active-conflict + heavy-contamination",
        "nonParty": true,
        "extraGate": "reject — no recognized national mine action authority; operate only under UNMAS cross-border mandate",
        "tierOverride": { "shaCoordsVisibility": "unmas-only", "victimPii": "unmas-only", "operatorPii": "unmas-only" }
      },
      "YE": {
        "statutes": [], "treaty": ["APMBC"],
        "riskLevel": "active-conflict + heavy-contamination",
        "extraGate": "YEMAC authorization (fragmented between Aden / Sana'a auths — route via UNMAS)",
        "tierOverride": { "shaCoordsVisibility": "unmas-yemac-only" }
      },
      "SY": {
        "statutes": [], "treaty": [],
        "riskLevel": "active-conflict + heavy-contamination",
        "nonParty": true,
        "extraGate": "reject — operate only under UNMAS / SNMAC cross-border mandate",
        "tierOverride": { "shaCoordsVisibility": "unmas-only" }
      },
      "US": {
        "statutes": ["DoD Directive 2000.24", "US Humanitarian Demining R&D"], "treaty": ["CCW-II amended", "CCW-V"],
        "nonParty": true,
        "note": "Non-party APMBC/CCM. Platform must not facilitate APM/CM production/stockpile/transfer. US-funded HMA overseas is in scope."
      },
      "RU": {
        "statutes": ["Federal Law 150-FZ 1996"], "treaty": ["CCW-II amended"],
        "nonParty": true,
        "extraGate": "reject — no recognized Russian domestic HMA partner at present",
        "riskLevel": "active-conflict"
      },
      "CN": {
        "statutes": ["CCW-II amended ratified"], "treaty": ["CCW-II amended"],
        "nonParty": true,
        "note": "Non-party APMBC/CCM. State HMA cooperation via CIHD overseas only."
      },
      "KR": {
        "statutes": ["군수품관리법 + DMZ regulations"], "treaty": [],
        "nonParty": true,
        "extraGate": "MND (Ministry of National Defense) authorization + DMZ special regime",
        "riskLevel": "DMZ-special",
        "tierOverride": { "shaCoordsVisibility": "mnd-only" }
      },
      "KP": {
        "statutes": [], "treaty": [],
        "nonParty": true,
        "extraGate": "reject — no recognized counterpart; sanctions regime prohibits most engagement"
      },
      "IR": { "statutes": [], "treaty": [], "nonParty": true, "extraGate": "reject — sanctions regime" }
    }
  },
  "pipelineGate": {
    "validateScope": {
      "description": "Applied to every write pipeline step. Rejects the record if: (a) activity ∈ prohibited; (b) jurisdiction has extraGate='reject'; (c) required consent token missing for the resolved jurisdiction gate.",
      "order": ["resolveJurisdiction", "applyDefaultGate", "applyJurisdictionGate", "applyTierOverride", "requireConsentToken"],
      "onFail": "write-rejected + audit event emitted"
    }
  }
}
