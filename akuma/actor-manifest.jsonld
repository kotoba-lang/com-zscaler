{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:akuma.etzhayyim.com",
  "name": "akuma",
  "nanoid": "ak0m4r3d",
  "displayName": "Akuma — Authorized Red Team Probing",
  "description": "Scope-bound authorized red team / vulnerability probing actor. Operates ONLY against owner-attested + etzhayyim-approved targets registered as com.etzhayyim.apps.akuma.scope contracts. Intrusiveness ceiling: passive | safe-active | intrusive. Exploit weaponization, RCE proof, lateral movement, and DoS are out of scope (rejected at policy). ADR-2605151400.",
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T2",
  "performerType": "service",
  "uiType": "yoro",
  "heartbeatRequired": true,
  "domainKnowledgeRequired": true,
  "convoSystemPrompt": "You are the Akuma agent — an authorized red team probing actor. Every action you take MUST be backed by an active com.etzhayyim.apps.akuma.scope contract that carries owner_signature AND authority_signature (etzhayyim). Before any runProbe call, verify: (1) scope.status == 'active', (2) target ∈ scope.targets and ∉ scope.excludedTargets, (3) probe.intrusiveness <= scope.intrusivenessTier, (4) tool ∈ tier-allowed set. Tool tiers: passive={dns,whois,tls}, safe-active={http-head}, intrusive={nmap,nuclei,zap,sqlmap}. Refuse exploit weaponization, RCE proof, DoS, lateral movement, and any probe outside the scope's allowed_ports / allowed_paths. When you produce a finding, encrypt the raw payload to vault.etzhayyim.com and write only metadata to the graph (zero-knowledge invariant). Findings flow to yabai as VulnFinding evidence. Operating entity is etzhayyim; Etzhayyim Japan株式会社 is vendor only.",
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "vault.write",
    "policy.evaluate"
  ],
  "profile": {
    "agentType": "autonomous",
    "isBot": true,
    "operator": "etzhayyim",
    "displayName": "Akuma — Authorized Red Team",
    "description": "Scope-gated authorized vulnerability probing with owner + authority dual-signature, intrusiveness tiering, and append-only audit.",
    "capabilities": [
      "scope-contract-management",
      "passive-recon",
      "safe-active-scan",
      "intrusive-scan",
      "finding-vault-write",
      "remediation-verify"
    ]
  },
  "governance": {
    "classification": "restricted",
    "raci": "responsible",
    "complianceFrameworks": [
      "OWASP Testing Guide v4",
      "PTES (Penetration Testing Execution Standard)",
      "NIST SP 800-115",
      "MITRE ATT&CK"
    ],
    "rules": [
      {
        "id": "RULE-AKUMA-SCOPE-DUAL-SIGNATURE",
        "name": "Owner + Authority Dual Signature Required",
        "enforcement": "Every scope contract MUST carry verified owner_signature AND etzhayyim authority_signature before status transitions to 'active'. Single-signed scopes remain 'draft' and runProbe denies."
      },
      {
        "id": "RULE-AKUMA-INTRUSIVENESS-CEILING",
        "name": "No Weaponization or DoS",
        "enforcement": "Tools above 'intrusive' tier (exploit weaponization, RCE proof, lateral movement, DoS) are rejected at policy. Such work requires a separate human-driven engagement."
      },
      {
        "id": "RULE-AKUMA-EGRESS-RESTRICTED-NAMESPACE",
        "name": "Probe Pod Egress Restricted to Active Scopes",
        "enforcement": "Probe execution runs in K8s namespace 'akuma-probe' with NetworkPolicy that allows egress only to IPs resolved from currently-active scope contracts. Revocation immediately removes egress."
      },
      {
        "id": "RULE-AKUMA-AUDIT-APPEND-ONLY",
        "name": "Append-Only Audit",
        "enforcement": "Every runProbe attempt (allow or deny) writes a vertex_akuma_audit row. No soft delete. Hard delete only via authority-signed deletion record."
      },
      {
        "id": "RULE-AKUMA-VAULT-FINDING-CIPHERTEXT",
        "name": "Findings Stored as Vault Ciphertext",
        "enforcement": "Raw finding payloads (tool output, screenshots, request/response bodies) MUST be ciphertext-stored in vault.etzhayyim.com. Graph holds metadata + vaultCiphertextCid only. Zero-knowledge invariant per CLAUDE.md root rule."
      },
      {
        "id": "RULE-AKUMA-PRUNE-ON-UNAUTHORIZED",
        "name": "Seed-Tier Prune on Unauthorized Probe",
        "enforcement": "Any probe attempt where reason ∈ {'target-not-in-scope','scope-not-active'} triggers Bonsai seed-tier prune (ADR-2605091800): full actor freeze + human review."
      },
      {
        "id": "RULE-AKUMA-OPERATING-ENTITY",
        "name": "Operating Entity = etzhayyim",
        "enforcement": "Authority signing key lives in etzhayyim HSM path. Payoff and decision rights belong to etzhayyim; Etzhayyim Japan株式会社 is vendor only (CLAUDE.md root rule)."
      }
    ]
  },
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.akuma.scope",
        "com.etzhayyim.apps.akuma.finding",
        "com.etzhayyim.apps.yabai.risk",
        "com.etzhayyim.apps.malak.indicator"
      ]
    }
  },
  "pipelines": [
    {
      "trigger": {"type": "xrpc", "nsid": "com.etzhayyim.apps.akuma.runProbe"},
      "steps": [
        {
          "id": "loadScope",
          "fn": "graph.query",
          "args": {
            "sql": "SELECT scope_id AS \"scopeId\", status, target_kind AS \"targetKind\", targets, excluded_targets AS \"excludedTargets\", allowed_ports AS \"allowedPorts\", allowed_paths AS \"allowedPaths\", intrusiveness_tier AS \"intrusivenessTier\", valid_from_ms AS \"validFromMs\", valid_until_ms AS \"validUntilMs\", rate_limit_rps AS \"rateLimitRps\" FROM vertex_akuma_scope WHERE scope_id = $scopeId LIMIT 1",
            "params": {"scopeId": "$input.scopeId"}
          }
        },
        {
          "id": "rateBudget",
          "fn": "graph.query",
          "args": {
            "sql": "SELECT count(*) AS \"currentRps\" FROM vertex_akuma_audit WHERE scope_id = $scopeId AND target = $target AND attempted_at_ms >= $windowStart",
            "params": {"scopeId": "$input.scopeId", "target": "$input.target", "windowStart": "$input._nowMinus1s"}
          }
        },
        {
          "id": "policyCheck",
          "fn": "policy.evaluate",
          "depends_on": ["loadScope", "rateBudget"],
          "args": {
            "package": "etzhayyim.akuma.scope",
            "input": {
              "scope": "$loadScope.rows[0]",
              "probe": "$input",
              "rate": "$rateBudget.rows[0]",
              "nowMs": "$input._nowMs"
            }
          }
        },
        {
          "id": "auditAttempt",
          "fn": "graph.write",
          "depends_on": ["policyCheck"],
          "args": {
            "sql": "INSERT INTO vertex_akuma_audit (vertex_id, rkey, repo, owner_did, scope_id, target, tool, intrusiveness, allowed, reason, attempted_at_ms, created_date, sensitivity_ord, actor_id) VALUES (concat('at://', $did, '/com.etzhayyim.apps.akuma.audit/', $auditId), $auditId, $did, $did, $scopeId, $target, $tool, $intrusiveness, $allowed, $reason, $nowMs, CURRENT_DATE, 300, 't2:akuma')",
            "params": {
              "auditId": "$input._auditId",
              "scopeId": "$input.scopeId",
              "target": "$input.target",
              "tool": "$input.tool",
              "intrusiveness": "$input.intrusiveness",
              "allowed": "$policyCheck.decision.allow",
              "reason": "$policyCheck.decision.reason",
              "nowMs": "$input._nowMs"
            }
          }
        },
        {
          "id": "dispatchProbe",
          "fn": "agent.invoke",
          "depends_on": ["auditAttempt"],
          "when": "$policyCheck.decision.allow == true",
          "args": {
            "target": "k8s://akuma-probe/runner",
            "payload": {
              "tool": "$input.tool",
              "target": "$input.target",
              "port": "$input.port",
              "toolArgs": "$input.toolArgs",
              "scopeId": "$input.scopeId"
            }
          }
        }
      ]
    },
    {
      "trigger": {"type": "subscribeRepos", "collections": ["com.etzhayyim.apps.yabai.risk"]},
      "steps": [
        {
          "id": "loadScopes",
          "fn": "graph.query",
          "args": {
            "sql": "SELECT scope_id FROM vertex_akuma_scope WHERE status = 'active' AND $target = ANY(targets) LIMIT 5",
            "params": {"target": "$input.record.entityId"}
          }
        },
        {
          "id": "queuePassiveProbe",
          "fn": "agent.chat",
          "depends_on": ["loadScopes"],
          "when": "$loadScopes.rows.length > 0 AND $input.record.riskScore >= 85",
          "args": {
            "message": "Yabai Challenge-tier risk on $input.record.entityId. Active scopes: $loadScopes.rows. Queue passive recon (dns + whois + tls) only."
          }
        }
      ]
    }
  ],
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": ["shinka", "koji", "kyumei", "domain-knowledge"],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "complianceDocs": [
    "90-docs/adr/2605151400-akuma-authorized-redteam-actor.md",
    "90-docs/adr/2605091800-pruning-protocol.md",
    "90-docs/adr/0018-pii-tier3-cohort-first.md"
  ]
}
