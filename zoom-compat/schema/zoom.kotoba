namespace zoom {

    entity Meeting {
        id: string @unique
        topic: string
        type: integer
        status: string
        duration: integer
        timezone: string
        hostId: string
        startTime: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Webinar {
        id: string @unique
        topic: string
        type: integer
        duration: integer
        hostId: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Recording {
        id: string @unique
        meetingId: string
        recordingType: string
        duration: integer
        fileSize: integer
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Registrant {
        id: string @unique
        email: string
        firstName: string
        lastName: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity User {
        id: string @unique
        email: string
        firstName: string
        lastName: string
        type: integer
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

}
