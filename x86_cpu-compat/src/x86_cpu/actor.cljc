                   (cond-> (contains? data :coreId) (conj [:db/add id :x86_cpu.TlbLevel/coreId (get data :coreId)]))
                   (cond-> (contains? data :level) (conj [:db/add id :x86_cpu.TlbLevel/level (get data :level)]))
                   (cond-> (contains? data :entries) (conj [:db/add id :x86_cpu.TlbLevel/entries (as-long (get data :entries))]))
                   (cond-> (contains? data :pageSizeKb) (conj [:db/add id :x86_cpu.TlbLevel/pageSizeKb (as-long (get data :pageSizeKb))]))
                   (conj [:db/add id :x86_cpu.TlbLevel/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-tlb-level
  "Delete a TlbLevel."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

;; ── PowerState ────────────────────────────────────────────────────────────────
(defn create-power-state
  "Create a PowerState."
  [port data]
  (require-fields data ["name" "voltageV"])
  (let [id (new-id "xcpu_pow")
        e {:db/id id
           :x86_cpu.PowerState/id id
           :x86_cpu.PowerState/coreId (get data :coreId)
           :x86_cpu.PowerState/name (get data :name)
           :x86_cpu.PowerState/voltageV (as-double (get data :voltageV))
           :x86_cpu.PowerState/tdpW (as-double (get data :tdpW))
           :x86_cpu.PowerState/createdAt (now)
           :x86_cpu.PowerState/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-power-states
  "List PowerState with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-power-states port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :x86_cpu.PowerState/id))
         rows (apply-filters rows (:filter opts) [:x86_cpu.PowerState/coreId :x86_cpu.PowerState/name :x86_cpu.PowerState/voltageV :x86_cpu.PowerState/tdpW])]
     (paginate rows opts))))

(defn get-power-state
  "Retrieve a PowerState by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-power-state port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-power-state
  "Update a PowerState; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :coreId) (conj [:db/add id :x86_cpu.PowerState/coreId (get data :coreId)]))
                   (cond-> (contains? data :name) (conj [:db/add id :x86_cpu.PowerState/name (get data :name)]))
                   (cond-> (contains? data :voltageV) (conj [:db/add id :x86_cpu.PowerState/voltageV (as-double (get data :voltageV))]))
                   (cond-> (contains? data :tdpW) (conj [:db/add id :x86_cpu.PowerState/tdpW (as-double (get data :tdpW))]))
                   (conj [:db/add id :x86_cpu.PowerState/updatedAt (now)]))]
      (-transact port sets)
      (-pull port id))))

(defn delete-power-state
  "Delete a PowerState."
  [port id]
  (-transact port [[:db/retractEntity id]])
  {:id id :deleted true})

