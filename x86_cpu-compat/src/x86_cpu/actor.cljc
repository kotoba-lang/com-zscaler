(defn create-x86-core
  "Create a X86Core."
  [port data]
  (require-fields data ["name" "isa"])
  (let [id (new-id "xcpu_x86")
        e {:db/id id
           :x86_cpu.X86Core/id id
           :x86_cpu.X86Core/name (get data :name)
           :x86_cpu.X86Core/isa (get data :isa)
           :x86_cpu.X86Core/microarch (get data :microarch)
           :x86_cpu.X86Core/frequencyGhz (as-double (get data :frequencyGhz))
           :x86_cpu.X86Core/issueWidth (as-long (get data :issueWidth))
           :x86_cpu.X86Core/createdAt (now)
           :x86_cpu.X86Core/updatedAt (now)}]
    (-transact port [e])
    e))

(defn list-x86-cores
  "List X86Core with optional filtering + cursor pagination → L4 list map.
   opts: {:filter {<attr-kw> v} :limit N :starting-after <db/id>}."
  ([port] (list-x86-cores port {}))
  ([port opts]
   (let [rows (mapv (fn [e] (-pull port e)) (-find-by-attr port :x86_cpu.X86Core/id))
         rows (apply-filters rows (:filter opts) [:x86_cpu.X86Core/name :x86_cpu.X86Core/isa :x86_cpu.X86Core/microarch :x86_cpu.X86Core/frequencyGhz :x86_cpu.X86Core/issueWidth])]
     (paginate rows opts))))

(defn get-x86-core
  "Retrieve a X86Core by id; opts {:expand #{:field}} inlines referenced entities. nil if absent."
  ([port id] (get-x86-core port id nil))
  ([port id opts]
   (when-let [rec (-pull port id)]
     (let [want (:expand opts)]
       (cond-> rec)))))

(defn update-x86-core
  "Update a X86Core; returns the new entity map, or nil if absent."
  [port id data]
  (when (-pull port id)
    (let [sets (-> []
                   (cond-> (contains? data :name) (conj [:db/add id :x86_cpu.X86Core/name (get data :name)]))
                   (cond-> (contains? data :isa) (conj [:db/add id :x86_cpu.X86Core/isa (get data :isa)]))
                   (cond-> (contains? data :microarch) (conj [:db/add id :x86_cpu.X86Core/microarch (get data :microarch)]))
                   (cond-> (contains? data :frequencyGhz) (conj [:db/add id :x86_cpu.X86Core/frequencyGhz (as-double (get data :frequencyGhz))]))
                   (cond-> (contains? data :issueWidth) (conj [:db/add id :x86_cpu.X86Core/issueWidth (as-long (get data :issueWidth))]))
