// x86_cpu clean-room schema -> Datomic EAVT mapping
// x86 CPU microarchitecture design.
// Generated by 70-tools/scaffold_wave11_compute_photonics.py.

namespace x86_cpu {

    entity X86Core {
        id: string @unique
        name: string
        isa: string
        microarch: string
        frequencyGhz: float
        issueWidth: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity ExecPort {
        id: string @unique
        coreId: string
        index: integer
        units: string
        throughput: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity MicroOp {
        id: string @unique
        coreId: string
        mnemonic: string
        fusedDomain: string
        latency: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity CacheLevel {
        id: string @unique
        coreId: string
        level: string
        sizeKb: integer
        associativity: integer
        latencyCycles: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity TlbLevel {
        id: string @unique
        coreId: string
        level: string
        entries: integer
        pageSizeKb: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity PowerState {
        id: string @unique
        coreId: string
        name: string
        voltageV: float
        tdpW: float
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
