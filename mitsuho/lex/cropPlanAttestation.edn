[{:db/id -1, :lex.cropPlanAttestation/lexicon 1, :lex.cropPlanAttestation/id "com.etzhayyim.mitsuho.cropPlanAttestation", :lex.cropPlanAttestation/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"cropPlanId\" \"parcelId\" \"season\" \"varietals\" \"pesticideManifest\" \"organicCertification\"], :properties {:cropPlanId {:type \"string\", :description \"Unique identifier for the crop plan.\"}, :parcelId {:type \"string\", :description \"Reference to the parcel where the crop will be cultivated.\"}, :season {:type \"string\", :description \"Agricultural season for the plan (e.g., 'Spring 2026').\"}, :varietals {:type \"array\", :items {:type \"string\"}, :description \"List of varietals to be planted.\"}, :pesticideManifest {:type \"array\", :items {:type \"string\"}, :description \"List of pesticides to be used (must be empty for G9 compliance).\"}, :organicCertification {:type \"boolean\", :description \"True if the plan is organically certified.\"}, :gmoAttestationCid {:type \"string\", :nullable true, :description \"CID reference to Council Lv6+ ≥3 sig attestation for GMO varietals (if applicable, G10).\"}, :rotationPlan {:type \"array\", :items {:type \"string\"}, :description \"Planned crop rotation for soil health.\"}}}}}"}]