[{:db/id -1, :lex.foodLotAttestation/lexicon 1, :lex.foodLotAttestation/id "com.etzhayyim.mitsuho.foodLotAttestation", :lex.foodLotAttestation/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"foodLotId\" \"harvestId\" \"processingDate\" \"kilojoulesPerKg\" \"macronutrients\" \"shelfLifeDays\" \"handlingInstructions\"], :properties {:foodLotId {:type \"string\", :description \"Unique identifier for the processed food lot.\"}, :harvestId {:type \"string\", :description \"Reference to the harvest event from which this food lot originated.\"}, :processingDate {:type \"string\", :format \"date-time\", :description \"Date and time of processing.\"}, :kilojoulesPerKg {:type \"number\", :description \"Energy content of the food lot in kilojoules per kilogram.\"}, :macronutrients {:type \"object\", :properties {:protein {:type \"number\"}, :carbohydrate {:type \"number\"}, :fat {:type \"number\"}}, :description \"Macronutrient breakdown (g per 100g).\"}, :shelfLifeDays {:type \"number\", :description \"Estimated shelf life in days.\"}, :handlingInstructions {:type \"string\", :description \"Instructions for storage and handling.\"}, :packagingType {:type \"string\", :description \"Type of packaging used.\"}}}}}"}]