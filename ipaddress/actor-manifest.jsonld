{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:ipaddress.etzhayyim.com",
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the IP address intelligence agent. You manage IP/ASN/WHOIS/GeoIP data with a role-based DID hierarchy spanning from ITU treaties through ICANN/RIR/NIR to individual IP addresses. You collect from 1st sources (RIR APIs, WHOIS, GeoIP databases). You provide full IP analysis (GeoIP+WHOIS+ASN+PTR+Scan), track RIR delegations, detect BGP anomalies via ct-monitor, and feed threat intelligence to yabai.etzhayyim.com.",
  "description": "IP address, ASN, WHOIS, GeoIP, reverse DNS, port scan intelligence. Role-based DID hierarchy (treaty/charter/standard/sovereign/contract/RIR/NIR/provider/ASN/prefix/IPv4/IPv6). 1st-source collection from RIR APIs, WHOIS, GeoIP databases. Governance hierarchy from ITU through ICANN/RIR/NIR to end users.",
  "displayName": "IP/ASN Intelligence",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "raci": "responsible",
    "sensitivity": "restricted"
  },
  "heartbeatRequired": true,
  "name": "ipaddress",
  "nanoid": "n7w1p4d0",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "command": "collectRirDelegations"
          },
          "fn": "agent.invoke",
          "id": "collectRir"
        },
        {
          "args": {
            "command": "getRirStats"
          },
          "depends_on": [],
          "fn": "agent.invoke",
          "id": "rirStats"
        },
        {
          "args": {
            "message": "You are IP/ASN Intelligence. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $rirStats.text"
          },
          "depends_on": [
            "rirStats"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 3 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "command": "analyzeIp",
            "params": {
              "ip": "$input.record.address"
            }
          },
          "fn": "agent.invoke",
          "id": "enrichIp"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.ipaddress.ipAddress"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "message": "You are IP/ASN Intelligence. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $input.record"
          },
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "notifyDelegation"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.ipaddress.delegationEvent"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "ipaddress",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.ipaddress.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "n7w1p4d0",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        },
        {
          "args": {
            "message": "You are IP/ASN Intelligence. Based on the following new data, write a concise social post (1-2 sentences, informative and specific). Data: $coverageSnapshot.text"
          },
          "depends_on": [
            "coverageSnapshot"
          ],
          "fn": "agent.chat",
          "id": "compose"
        },
        {
          "args": {
            "template": "$compose.text"
          },
          "depends_on": [
            "compose"
          ],
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS nodeCount, c.latestSeq AS latestSeq, c.topCollections AS topCollections, c._seq AS snapshotSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageStats"
        },
        {
          "args": {
            "sql": "MATCH (c:ActorCoverageSnapshot {actorDid: $did}) RETURN c.nodeCount AS totalNodes LIMIT 1"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageHealth"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.ipaddress.coverage.get",
        "type": "xrpc"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "lookup-ip",
      "analyze-ip",
      "get-asn",
      "whois-lookup",
      "geolocate-ip",
      "reverse-dns",
      "get-ip-reputation",
      "collect-rir-delegations",
      "collect-scan"
    ],
    "description": "IP/ASN/WHOIS/GeoIP/PTR/scan intelligence with role-based DID hierarchy. RIR delegation tracking, BGP anomaly correlation, hosting provider monitoring.",
    "displayName": "IP/ASN Intelligence",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.ipaddress.ipAddress",
        "com.etzhayyim.apps.ipaddress.asn",
        "com.etzhayyim.apps.ipaddress.delegationEvent",
        "com.etzhayyim.apps.ipaddress.scanResult"
      ]
    }
  },
  "uiType": "yoro"
}
