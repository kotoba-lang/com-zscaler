{:lexicon 1
 :id "com.etzhayyim.kiyome.sanitizationRecord"
 :defs
 {:main
  {:type "record" :key "tid"
   :record
   {:type "object"
    :required ["siteId" "agent" "dwellSeconds" "createdAt"]
    :properties
    {:siteId {:type "string"}
     :surfaceClass {:type "string" :enum ["high-touch" "floor" "kitchen" "bathroom"]}
     :agent {:type "string" :description "sanitizing agent (no claim beyond label efficacy, G8)"}
     :dwellSeconds {:type "integer" :minimum 0 :description "contact dwell time (efficacy honesty)"}
     :createdAt {:type "string" :format "datetime"}}}}}}
