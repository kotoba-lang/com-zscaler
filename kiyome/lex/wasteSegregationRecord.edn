{:lexicon 1
 :id "com.etzhayyim.kiyome.wasteSegregationRecord"
 :defs
 {:main
  {:type "record" :key "tid"
   :record
   {:type "object"
    :required ["siteId" "streams" "handoffActor" "createdAt"]
    :properties
    {:siteId {:type "string"}
     :streams {:type "array" :items {:type "string"} :description "recycle/compost/landfill/hazardous segregated streams"}
     :handoffActor {:type "string" :description "downstream actor DID (haraedo/kurashimori/hodoki/kanayama); never disposed outside policy"}
     :createdAt {:type "string" :format "datetime"}}}}}}
