{:lexicon 1
 :id "com.etzhayyim.kiyome.cleaningPassAttestation"
 :defs
 {:main
  {:type "record" :key "tid"
   :record
   {:type "object"
    :required ["siteId" "areaM2" "onDeviceOnly" "createdAt"]
    :properties
    {:siteId {:type "string" :description "site id (hashed; no address PII)"}
     :areaM2 {:type "integer" :minimum 0}
     :method {:type "string" :enum ["sweep" "vacuum" "mop" "wipe"]}
     :onDeviceOnly {:type "boolean" :const true :description "G9 invariant — no imagery/sensor feed left the robot; always true"}
     :imageryRetained {:type "boolean" :const false :description "G9 invariant — never retains occupant imagery; always false"}
     :witnessQuorumMet {:type "boolean" :description "G3: >=2 robot sigs + >=1 human"}
     :createdAt {:type "string" :format "datetime"}}}}}}
