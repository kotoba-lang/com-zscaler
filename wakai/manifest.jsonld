      "io": "member voluntary contribution → mutualAidContributionAttestation"
    },
    {
      "name": "mutual_aid_distribution",
      "module": "kotodama.cells.wakai_mutual_aid_distribution",
      "murakumoNode": "asher",
      "phase": "event",
      "io": "need attestation + Council ≥3 discernment + ≥3 community witnesses → mutualAidDistributionAttestation"
    },
    {
      "name": "emergency_pool_activation",
      "module": "kotodama.cells.wakai_emergency_pool_activation",
      "murakumoNode": "asher",
      "phase": "event",
      "io": "kazaori emergencyDeclaration active → emergency dispatch coordination",
      "crossActorPair": "kazaori"
    },
    {
      "name": "health_event_support",
      "module": "kotodama.cells.wakai_health_event_support",
      "murakumoNode": "asher",
      "phase": "event",
      "io": "iyashi/hagukumi/yakushi event cross-link → distribution routing",
      "crossActorPair": "iyashi + hagukumi + yakushi triad"
    },
    {
      "name": "public_fund_backstop_request",
      "module": "kotodama.cells.wakai_public_fund_backstop_request",
      "murakumoNode": "asher",
      "phase": "event",
      "io": "pool insufficient → Council Lv6+ ≥4/7 backstop request",
      "crossActorPair": "toritate + Public Fund Safe"
    },
    {
      "name": "pool_state_reporting",
      "module": "kotodama.cells.wakai_pool_state_reporting",
      "murakumoNode": "asher",
      "phase": "continuous (monthly summary)",
      "io": "aggregate pool state → mutualAidPoolStateReport (NO individual member-contribution amounts public)"
    }
  ],
