;; meibo 名簿 — verified legal-institution directory registry (ADR-2607062200).
;; R0: 22 entries across 10 jurisdictions (jp/us/uk/de/kr/fr/au/ca/it/es).
;;
;; INSTITUTION-LEVEL LINKS ONLY (G1) — never individual professional records.
;; Every :dir/url verified live (WebSearch/WebFetch) before being recorded here,
;; never guessed/remembered — same provenance discipline as saisei's
;; :tl/source-url / :proc/official-forms-url and tate's :clause/source-url.
;;
;; :dir/kind — :bar-association (弁護士/attorney register) | :licensed-scrivener
;; (Japan-specific 司法書士/行政書士 licensed non-attorney professions) |
;; :court-locator | :insolvency-practitioner-register (UK-specific).
;;
;; :dir/disclosure-basis (added per owner follow-up question "国として登録公開が
;; 義務付けられているのは?") — distinguishes "the law itself requires this
;; registry to be published/searchable" from "registration is mandatory but
;; public web-searchability is the regulator's own practice, not a codified
;; disclosure duty we could locate." Only meaningful for :bar-association /
;; :licensed-scrivener / :insolvency-practitioner-register kinds (a court
;; locator isn't a professional-registry disclosure question) — omitted on
;; :court-locator entries. Researched via WebSearch, not memory (G10); see
;; :dir/disclosure-note for the specific citation/reasoning per entry.
;;
;; Values:
;;   :statutory-mandatory                     — a statute/regulation explicitly
;;                                               requires public accessibility
;;   :mandatory-registration-public-by-practice — registration is mandatory and
;;                                               the register is treated/published
;;                                               as public, but no explicit
;;                                               "must be web-searchable" clause
;;                                               was located
;;   :voluntary-opt-in                        — registration to practice is
;;                                               mandatory, but the SEARCHABLE
;;                                               WEB TOOL'S listing is opt-in /
;;                                               self-reported (the regulator
;;                                               disclaims responsibility for it)
;;   :varies-by-subunit                       — regulated per state/province/
;;                                               territory; no single national
;;                                               disclosure mandate found
;;   :unconfirmed                             — mandatory licensing confirmed,
;;                                               but no public-disclosure clause
;;                                               located in this wave's research
;;
;; DATOMIZED (Phase 4 fan-out): top-level vector-of-entity-maps -> tx-data.
;; Each entry already carried idiomatic :dir/* namespaced keys (kept as-is,
;; no re-prefixing) and only scalar values (string/keyword) -- only change is
;; a sequential :db/id added per entry so `(d/transact conn ...)` can consume
;; this file directly. Read via meibo.methods.edn's own minimal reader (which
;; treats every :token as an opaque string, not a real keyword) is unaffected:
;; it just sees one more ":db/id" string key per map, ignored by every
;; existing (get d ":dir/...") consumer.

[{:dir/note "登録は任意・自己申告ベース — 掲載の有無は在籍の証明にならない。訴訟書類作成代理権あり", :dir/url "https://www.nichibenren.or.jp/search.html", :dir/id "dir:jp-bengoshi", :dir/disclosure-basis :voluntary-opt-in, :db/id -1, :dir/disclosure-note "弁護士法9条で日弁連への登録(名簿記載)自体は義務。ただし『ひまわりサーチ』の詳細情報掲載は任意登録制で、日弁連は掲載内容について責任を負わないと明記 — 掲載が無いことは非在籍の証明にならない", :dir/jurisdiction :jp, :dir/kind :bar-association, :dir/label "弁護士検索 (日本弁護士連合会)"} {:dir/note "簡裁代理権を持つ司法書士は簡易裁判所の一部手続で代理可能。破産・個人再生の申立書類作成代理も可能", :dir/url "https://www.shiho-shoshi.or.jp/other/doui/", :dir/id "dir:jp-shihoshoshi", :dir/disclosure-basis :mandatory-registration-public-by-practice, :db/id -2, :dir/disclosure-note "司法書士法8条で登録(氏名・生年月日・事務所所在地等)は義務。しほサーチは月2回更新の公式検索だが、『検索ツールでの公開』自体を明文で義務付ける条文は今回確認できず", :dir/jurisdiction :jp, :dir/kind :licensed-scrivener, :dir/label "司法書士検索 (日本司法書士会連合会)"} {:dir/note "重要: 行政書士に裁判所提出書類(訴訟書類)の作成代理権は無い — 自己破産・個人再生の申立書類は対象外 (弁護士・司法書士の権限)", :dir/url "https://www.gyosei.or.jp/members-search", :dir/id "dir:jp-gyoseishoshi", :dir/disclosure-basis :mandatory-registration-public-by-practice, :db/id -3, :dir/disclosure-note "行政書士法6条で登録(氏名・住所・事務所名称等)は義務。会員検索は依頼者の信頼確保を目的に運用されているが、司法書士同様『検索ツール公開』自体の明文義務は今回確認できず", :dir/jurisdiction :jp, :dir/kind :licensed-scrivener, :dir/label "行政書士検索 (日本行政書士会連合会)"} {:dir/note "No single national attorney registry — attorney licensing is per-state; find your state bar here", :dir/url "https://www.americanbar.org/groups/bar-leadership/resources/local-bar-resource-directory/", :dir/id "dir:us-bar-directory", :dir/disclosure-basis :varies-by-subunit, :db/id -4, :dir/disclosure-note "Attorney licensing/registration is state-regulated, not federal. ~44 states + DC are reported to publish an online public database, but there is no single federal statute or unified model rule mandating this — it varies by state", :dir/jurisdiction :us, :dir/kind :bar-association, :dir/label "State Bar Association Directory (American Bar Association)"} {:db/id -5, :dir/id "dir:us-court-locator", :dir/jurisdiction :us, :dir/kind :court-locator, :dir/label "Find a Federal Court (United States Courts)", :dir/url "https://www.uscourts.gov/federal-court-finder/find", :dir/note "Bankruptcy is federal — use this to find your district's U.S. Bankruptcy Court"} {:db/id -6, :dir/id "dir:uk-solicitors-register", :dir/jurisdiction :uk, :dir/kind :bar-association, :dir/label "Solicitors Register (Solicitors Regulation Authority)", :dir/url "https://www.sra.org.uk/consumers/register/", :dir/disclosure-basis :statutory-mandatory, :dir/disclosure-note "Legal Services Act 2007 established the SRA as approved regulator; the SRA's own Roll, Registers and Publication Regulations state the SRA SHALL publish all entries on the roll/registers (bar certain address fields) — an explicit publication duty"} {:db/id -7, :dir/id "dir:uk-court-locator", :dir/jurisdiction :uk, :dir/kind :court-locator, :dir/label "Find a Court or Tribunal (HM Courts & Tribunals Service)", :dir/url "https://www.find-court-tribunal.service.gov.uk/"} {:dir/note "Only a licensed Insolvency Practitioner can act as trustee in bankruptcy or DRO approved intermediary", :dir/url "https://www.gov.uk/find-an-insolvency-practitioner", :dir/id "dir:uk-insolvency-practitioner", :dir/disclosure-basis :unconfirmed, :db/id -8, :dir/disclosure-note "Licensing itself is clearly statutory (Insolvency Act 1986 + Insolvency Practitioners Regulations 1990, via a Recognised Professional Body) but the precise clause mandating the PUBLIC register's web-searchability was not pinned down in this wave's research", :dir/jurisdiction :uk, :dir/kind :insolvency-practitioner-register, :dir/label "Find an Insolvency Practitioner (Insolvency Service)"} {:db/id -9, :dir/id "dir:de-anwaltsverzeichnis", :dir/jurisdiction :de, :dir/kind :bar-association, :dir/label "Bundesweites Amtliches Anwaltsverzeichnis (Bundesrechtsanwaltskammer)", :dir/url "https://www.brak.de/service/bundesweites-amtliches-anwaltsverzeichnis/", :dir/disclosure-basis :statutory-mandatory, :dir/disclosure-note "BRAO (Bundesrechtsanwaltsordnung) requires the Gesamtverzeichnis to be accessible to everyone free of charge, via an electronic search system, with the Federal Ministry of Justice regulating data collection/maintenance/access by ordinance — the clearest explicit statutory publication duty found in this wave"} {:db/id -10, :dir/id "dir:de-gerichtsverzeichnis", :dir/jurisdiction :de, :dir/kind :court-locator, :dir/label "Orts- und Gerichtsverzeichnis (Justizportal des Bundes und der Länder)", :dir/url "https://justiz.de/index.php"} {:dir/note "대한변호사협회 직영 공공법률플랫폼", :dir/url "https://www.klaw.or.kr/search", :dir/id "dir:kr-byeonhosa", :dir/disclosure-basis :unconfirmed, :db/id -11, :dir/disclosure-note "변호사법 is clear on registration duty and confidentiality obligations (§26), but no explicit public-register-disclosure clause was located in this wave's research — the search tool is KBA-operated but its statutory disclosure basis wasn't confirmed", :dir/jurisdiction :kr, :dir/kind :bar-association, :dir/label "대한변협 나의 변호사 (대한변호사협회 공식 서비스)"} {:db/id -12, :dir/id "dir:kr-court", :dir/jurisdiction :kr, :dir/kind :court-locator, :dir/label "대한민국 법원 대국민서비스", :dir/url "https://www.scourt.go.kr/portal/main.jsp"} {:db/id -13, :dir/id "dir:fr-avocats", :dir/jurisdiction :fr, :dir/kind :bar-association, :dir/label "Annuaire des avocats de France (Conseil National des Barreaux)", :dir/url "https://cnb.avocat.fr/annuaire-des-avocats-de-france", :dir/disclosure-basis :statutory-mandatory, :dir/disclosure-note "Loi n°71-1130 du 31 décembre 1971 (as amended) directs the CNB to establish, update, and make available online a national directory of lawyers registered on a bar's roll, compiled from each bar council's data — an explicit statutory publication duty"} {:db/id -14, :dir/id "dir:fr-tribunal", :dir/jurisdiction :fr, :dir/kind :court-locator, :dir/label "Trouver et contacter un tribunal (Justice.fr)", :dir/url "https://www.justice.fr/trouver-contacter-tribunal"} {:dir/note "Legal practice is regulated per-state/territory; this is the national pointer", :dir/url "https://legalservicescouncil.org.au/australian-legal-profession-register.html", :dir/id "dir:au-legal-profession-register", :dir/disclosure-basis :varies-by-subunit, :db/id -15, :dir/disclosure-note "Legal Profession Uniform Law makes practising without a certificate an offence (s.10) and is adopted state-by-state (NSW/VIC/WA); no single unified statutory public-register-disclosure clause was located covering all of Australia in this wave's research", :dir/jurisdiction :au, :dir/kind :bar-association, :dir/label "Australian Legal Profession Register (Legal Services Council)"} {:db/id -16, :dir/id "dir:au-federal-court", :dir/jurisdiction :au, :dir/kind :court-locator, :dir/label "Federal Court of Australia", :dir/url "https://www.fedcourt.gov.au/"} {:dir/note "Legal practice is regulated per-province — this is Ontario's; find your own province's law society if elsewhere", :dir/url "https://lso.ca/public-resources/finding-a-lawyer-or-paralegal", :dir/id "dir:ca-law-society", :dir/disclosure-basis :varies-by-subunit, :db/id -17, :dir/disclosure-note "Every lawyer must be a Law Society member under each province's own Law Society Act (e.g. Ontario's), but no single unified statutory public-register-disclosure clause covering all of Canada was located in this wave's research", :dir/jurisdiction :ca, :dir/kind :bar-association, :dir/label "Lawyer and Paralegal Directory (Law Society of Ontario)"} {:db/id -18, :dir/id "dir:ca-federal-court", :dir/jurisdiction :ca, :dir/kind :court-locator, :dir/label "Federal Court of Canada", :dir/url "https://www.fct-cf.ca/en/home"} {:db/id -19, :dir/id "dir:it-avvocati", :dir/jurisdiction :it, :dir/kind :bar-association, :dir/label "Ricerca Avvocato (Consiglio Nazionale Forense)", :dir/url "https://www.consiglionazionaleforense.it/ricerca-avvocato", :dir/disclosure-basis :mandatory-registration-public-by-practice, :dir/disclosure-note "Legge 247/2012 requires the professional orders to maintain the Albo and (art. 10 re: advertising) requires a list of registered lawyers' contact emails consultable BY PUBBLICHE AMMINISTRAZIONI specifically — narrower than a general public-web-search mandate; the CNF's own Ricerca Avvocato tool is broader in practice than what this specific clause requires"} {:db/id -20, :dir/id "dir:it-giustizia-map", :dir/jurisdiction :it, :dir/kind :court-locator, :dir/label "Giustizia Map (Ministero della Giustizia)", :dir/url "https://www.giustizia.it/giustizia/it/mg_4.page"} {:db/id -21, :dir/id "dir:es-abogacia", :dir/jurisdiction :es, :dir/kind :bar-association, :dir/label "Censo General de Letrados (Consejo General de la Abogacía Española)", :dir/url "https://www.abogacia.es/", :dir/disclosure-basis :mandatory-registration-public-by-practice, :dir/disclosure-note "Real Decreto 135/2021 (Estatuto General de la Abogacía Española) requires colegiación (bar membership) to practice; the Consejo General publishes a national census as part of its own institutional function, but no explicit 'must be web-searchable' statutory clause was located in this wave's research"} {:db/id -22, :dir/id "dir:es-organos-judiciales", :dir/jurisdiction :es, :dir/kind :court-locator, :dir/label "Buscador de órganos judiciales (Ministerio de Justicia)", :dir/url "https://www.administraciondejusticia.gob.es/buscador-de-organos"}]
