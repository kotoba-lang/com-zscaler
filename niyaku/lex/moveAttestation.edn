[{:db/id -1, :moveAttestation/lexicon 1, :moveAttestation/id "com.etzhayyim.niyaku.moveAttestation", :moveAttestation/defs "{:main {:type \"record\", :key \"tid\", :record {:type \"object\", :required [\"moveId\" \"boxId\" \"vesselId\" \"terminalId\" \"direction\" \"fromSlot\" \"toSlot\"], :properties {:energyKwh {:type \"number\", :description \"net electric energy for the move (regen-credited, G8)\"}, :terminalId {:type \"string\", :description \"terminal UN/LOCODE + berth\"}, :boxId {:type \"string\", :description \"ISO container number\"}, :liftWitness {:type \"string\", :description \"spreader-engage robot DID + landing robot DID (≥2, G3)\"}, :residualSwayRad {:type \"number\", :description \"load sway at landing (rad); gated < threshold per G4\"}, :antiSwayVerified {:type \"boolean\", :description \"anti-sway settle confirmed before landing\"}, :toSlot {:type \"string\", :description \"destination slot\"}, :craneId {:type \"string\", :description \"STS crane DID performing the lift\"}, :hazmatClass {:type \"string\", :description \"IMDG class if dangerous goods (segregation per G9)\"}, :moveId {:type \"string\", :description \"unique handling-move identifier\"}, :timestamp {:type \"string\", :description \"ISO-8601 attestation time\"}, :fromSlot {:type \"string\", :description \"origin slot: bay/row/tier or yard address\"}, :direction {:type \"string\", :description \"discharge (ship→shore) | load (shore→ship)\"}, :vesselId {:type \"string\", :description \"vessel DID\"}}}}}"}]
