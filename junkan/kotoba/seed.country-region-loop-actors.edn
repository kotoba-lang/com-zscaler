;; junkan 循環 — designed country/region loop actors.
;;
;; This is a design registry, not a claim that each actor has live data yet.
;; Actors start :designed, become :seeded when representative public aggregate
;; signals exist, and become :active only after Council-approved public-source
;; ingestion. Every actor inherits the G4/G5/G6/G7/G11 posture from junkan.
[
 {:type :loop-domain
  :id :packaged-goods-culture
  :label "Packaged goods vs loose/refill/local-channel retail culture"
  :sign-convention "positive=toward loose/refill/local-small-quantity; negative=toward packaged/modern-retail"
  :stocks [:cashflow-unit-size
           :trust-proximity
           :freshness-local-provenance
           :price-transparency-by-weight
           :language-label-fit
           :distribution-friction
           :waste-refill-norm
           :modern-retail-standardization]
  :loops [:R-kirana-cashflow-trust
          :R-language-local-trust
          :R-freshness-refill
          :B-sachet-conversion
          :B-modern-retail-standardization]
  :source-classes [:household-consumption :census-language :retail-channel :price-index :geospatial]}

 {:type :loop-actor
  :id "junkan.loop.packaged-goods-culture.world"
  :parent nil
  :scope :world
  :jurisdiction "WORLD"
  :region nil
  :languages []
  :domains [:packaged-goods-culture]
  :stocks :inherit-domain
  :loops :inherit-domain
  :sources [:household-consumption :census-language :retail-channel]
  :fission-rules [:language-fragmentation :settlement-split :regional-sign-reversal :category-split]
  :gates [:analysis-only :hypothesis-only :aggregate-only :non-essentialist :map-not-ranking :candidate-not-directive]
  :status :designed}

