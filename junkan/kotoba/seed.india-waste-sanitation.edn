;; junkan 循環 — India municipal solid-waste collection / segregation / processing /
;; recycling-linkage cycle seed.
;;
;; Question:
;;   Which structural factors keep some Indian urban/rural segments in an
;;   uncollected-accumulation / open-dumping / informal-exclusion regime, and which
;;   keep others moving toward reliable collection, source segregation, processing
;;   capacity, and recycler-market linkage (circularity)?
;;
;; Discipline:
;;   - aggregate-only: region/language/channel/settlement cohorts, never persons or
;;     named waste-picker/household identities.
;;   - hypothesis-only: :polarity/:magnitude/:confidence are disclosed model
;;     hypotheses, not causal proof or a municipality scorecard.
;;   - non-essentialist: this does NOT model "Indian sanitation" as one uniform
;;     condition. India also has ODF++/5-star SBM-U certified cities, scientific
;;     processing capacity build-out, and waste-picker cooperative integration
;;     pilots; those counter-forces are represented explicitly.
;;   - analysis-only (G4): this seed feeds a read-off, never a dispatch/collection
;;     schedule/route/payment instruction. On-the-ground collection execution is a
;;     separate, Governor-gated actor's concern (see junkan CLAUDE.md), not junkan's.
;;
;; Sign convention in junkan.methods.waste-sanitation:
;;   :toward-circular     => positive pressure toward collection/segregation/processing/recycling
;;   :toward-accumulation => negative pressure toward uncollected/unsegregated/landfill/open-dumping
;;   :ambiguous            => zero contribution, retained for coverage/context
[
 {:type :waste-signal
  :id "in-rural-collection-coverage-gap"
  :name "Rural and peri-urban door-to-door collection coverage remains uneven"
  :region :pan-india :settlement :rural
  :languages [:hi :bn :te :mr :ta :ur :gu :kn :ml :or :pa :as]
  :channel :municipal-door-to-door
  :stock :collection-reliability
  :polarity :toward-accumulation
  :magnitude 0.74 :confidence 0.55
  :basis "CPCB Annual Report on Implementation of Solid Waste Management Rules and SBM-U (Gramin+Urban) dashboards show materially lower door-to-door collection coverage outside class-I/II towns; hypothesis: sparse rural/peri-urban routes leave uncollected waste to accumulate or be self-disposed."
  :sourceUrl "https://cpcb.nic.in/"
  :sourcing :representative}

 {:type :waste-signal
  :id "in-urban-door-to-door-scaleup"
  :name "Urban door-to-door collection scale-up under Swachh Bharat Mission-Urban"
  :region :pan-india :settlement :urban
  :languages [:hi :bn :te :mr :ta :ur :gu :kn :ml :or :pa :as]
  :channel :municipal-door-to-door
  :stock :collection-reliability
  :polarity :toward-circular
  :magnitude 0.7 :confidence 0.54
  :basis "SBM-U dashboard-reported door-to-door collection coverage claims are high across ULBs, particularly ODF++/5-star certified cities; hypothesis: sustained municipal investment and IEC drives raise reliable collection in covered wards."
  :sourceUrl "https://sbmurban.org/"
  :sourcing :representative}

 {:type :waste-signal
  :id "in-north-source-segregation-low-compliance"
  :name "North Indian household source-segregation compliance remains partial"
  :region :north :settlement :mixed
  :languages [:hi :ur :pa]
  :channel :public-dustbin
  :stock :source-segregation
  :polarity :toward-accumulation
  :magnitude 0.6 :confidence 0.45
  :basis "MoHUA/CPCB monitoring notes wet/dry segregation-at-source compliance well below mandate in several northern ULBs; hypothesis: mixed-waste habits keep collected material low-value and harder to process."
  :sourceUrl "https://mohua.gov.in/"
  :sourcing :representative}

 {:type :waste-signal
  :id "in-west-segregation-ward-pilots"
  :name "West Indian ward-level segregation-at-source pilots raise compliance"
  :region :west :settlement :urban
  :languages [:mr :gu :hi :en]
  :channel :municipal-door-to-door
  :stock :source-segregation
  :polarity :toward-circular
  :magnitude 0.58 :confidence 0.44
  :basis "Representative hypothesis: Maharashtra/Gujarat ULB ward-level source-segregation pilots (twin-bin distribution, penalty-plus-IEC enforcement) are associated with reported rises in wet/dry separation compliance."
  :sourceUrl "https://sbmurban.org/"
  :sourcing :representative}

 {:type :waste-signal
  :id "in-informal-waste-picker-exclusion"
  :name "Informal waste-pickers recover large recyclable volumes without formal integration"
  :region :pan-india :settlement :urban
  :languages [:hi :bn :te :mr :ta :ur :gu :kn :ml :or :pa :as]
  :channel :informal-collection
  :stock :informal-worker-integration
  :polarity :toward-accumulation
  :magnitude 0.68 :confidence 0.5
  :basis "Solid Waste Management Rules 2016 mandate ULB integration of waste-picker/kabadiwala networks, but implementation is uneven; hypothesis: where integration (ID, social protection, formal linkage into ULB systems) is absent, a large de facto recycling workforce stays outside the formal circularity loop."
  :sourceUrl "https://cpcb.nic.in/"
  :sourcing :representative}

 {:type :waste-signal
  :id "in-south-waste-picker-cooperative-integration"
  :name "South Indian waste-picker cooperative / dry-waste-collection-center integration pilots"
  :region :south :settlement :urban
  :languages [:ta :te :kn :ml :en]
  :channel :informal-collection
  :stock :informal-worker-integration
  :polarity :toward-circular
  :magnitude 0.56 :confidence 0.42
  :basis "Representative hypothesis: cooperative-model dry-waste-collection-center programs in southern metros formally register and route material through waste-picker cooperatives, raising both worker integration and recovered-material quality."
  :sourceUrl "https://sbmurban.org/"
  :sourcing :representative}

 {:type :waste-signal
