;; junkan 循環 — demographic-dynamics seed: peer low-fertility societies (KR/JP/IT/SG).
;; ADR-2605290927. Schema: ontology.junkan-demography.edn. Companion to
;; seed.china-one-child.edn — the SAME 5-stock / 5-loop / Meadows frame applied to four
;; more sub-replacement societies so junkan can read the CROSS-SOCIETY CONTRAST: which
;; demographic stock is the BINDING constraint in each (norm-lockin vs cost vs
;; non-marriage vs youth-precarity vs familism). Loaded alongside the China seed by
;; methods/demography.cljc; per-jurisdiction read-off is `society-contrast`.
;;
;; ANALYSIS-ONLY (G4). Each row is a disclosed policy LEVER or structural driver with
;; 誰が定めたか / 経緯 / 関係者 as on-the-record public facts; :polarity is a DISCLOSED
;; HYPOTHESIS (G5) about its net effect on fertility (:suppress collapse-ward /
;; :boost replacement-ward). NO individual / PII (G6). A resilience MAP, never a
;; population target or a country ranking (G7); junkan never prescribes who should
;; reproduce (G11, anti-coercion). sourcing :representative — real, named, public facts.

[
 ;; ══ South Korea (KR) — TFR ≈ 0.7, the world's lowest. Binding: education-cost + gender ══
 {:type :instrument :id "kr-family-planning-1962" :name "가족계획사업 (Family-planning program / 둘만 낳아 잘 기르자)"
  :jurisdiction "KR" :kind :law :year 1962
  :enactor "Economic Planning Board + Planned Parenthood Federation of Korea, under the 5-year economic plans (1962–1996)"
  :origin "State anti-natal program (slogans «3-3-35», «둘만 낳아 잘 기르자» two-is-enough) to cut fertility for development — succeeded, formally ended 1996 as fertility fell below replacement."
  :stakeholders ["Economic Planning Board" "PPFK" "rural & urban couples"]
  :stock :fertility-rate :polarity :suppress :magnitude 0.7 :reversibility :statutory :meadows 5
  :basis "ROK family-planning program 1962–1996" :sourcing :representative :confidence 0.7}

 {:type :instrument :id "kr-private-education-cost" :name "사교육비 (private-education / hagwon cost)"
  :jurisdiction "KR" :kind :value :year 2000
  :enactor "Emergent — hyper-competitive credentialism (수능 / SKY-university funnel) driving the world's highest private-education spending"
  :origin "Intense hagwon/sagyoyuk cost makes each child extraordinarily expensive — the dominant cost driver behind Korea's record-low fertility."
  :stakeholders ["parents" "private tutoring (hagwon) industry" "students"]
  :stock :childrearing-cost :polarity :suppress :magnitude 0.85 :reversibility :cultural :meadows 5
  :basis "OECD-high private-education-expenditure share" :sourcing :representative :confidence 0.65}

 {:type :instrument :id "kr-gender-care-penalty" :name "독박육아・모성 패널티 (gendered care + motherhood penalty)"
  :jurisdiction "KR" :kind :value :year 2010
  :enactor "Emergent — high female education/employment against an unchanged expectation of solo childcare + a workplace motherhood penalty + long working hours"
  :origin "The opportunity cost + career penalty of motherhood is among the steepest globally; women increasingly forgo marriage/children (the 비혼/4B currents). A deep (Meadows 2–3) reproductive-cohort driver."
  :stakeholders ["working women" "employers" "households"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.8 :reversibility :cultural :meadows 3
  :basis "Gender-gap in unpaid care + motherhood employment-penalty literature" :sourcing :representative :confidence 0.6}

 {:type :instrument :id "kr-housing-cost-seoul" :name "수도권 주거비 (Seoul-metro housing / jeonse cost)"
  :jurisdiction "KR" :kind :institution :year 2015
  :enactor "Emergent — capital-region concentration + housing/jeonse price escalation"
  :origin "High entry cost of household formation in the Seoul metropolitan area where opportunity concentrates — delays marriage and raises the cost stock."
  :stakeholders ["young couples" "housing market" "Seoul-metro employers"]
  :stock :childrearing-cost :polarity :suppress :magnitude 0.6 :reversibility :institutional :meadows 5
  :basis "Seoul-metro housing price-to-income trend" :sourcing :representative :confidence 0.55}

 {:type :instrument :id "kr-low-fertility-framework-2005" :name "저출산·고령사회기본법 (Framework Act on Low Birth Rate & Aging Society)"
  :jurisdiction "KR" :kind :law :year 2005
  :enactor "National Assembly — 2005 Framework Act; successive 5-year basic plans funding pronatal spending (cumulatively >₩300tn)"
  :origin "The pivot to ENCOURAGEMENT: a statutory framework + very large pronatal expenditure. Fertility nonetheless fell to <0.8 — the clearest demonstration that spending without reaching the cost/gender constraints does not move the curve."
  :stakeholders ["National Assembly" "Presidential Committee on Ageing Society & Population" "young families"]
  :stock :fertility-rate :polarity :boost :magnitude 0.25 :reversibility :statutory :meadows 8
  :basis "2005 저출산·고령사회기본법; 1st–4th Basic Plans" :sourcing :representative :confidence 0.6
  :note "Large boost spend, weak effect — overwhelmed by the cost + gender stocks."}

 {:type :instrument :id "kr-parental-cash-2023" :name "부모급여 (parental cash allowance)"
  :jurisdiction "KR" :kind :institution :year 2023
  :enactor "Ministry of Health & Welfare — 부모급여 (2023, monthly cash for infants) + expanded parental leave"
  :origin "Direct cash transfer to lower the cost stock; early, small relative to the education + housing cost gap."
  :stakeholders ["Ministry of Health & Welfare" "young families"]
  :stock :childrearing-cost :polarity :boost :magnitude 0.2 :reversibility :statutory :meadows 5
  :basis "부모급여 scheme 2023–" :sourcing :representative :confidence 0.45}

 ;; ══ Japan (JP) — TFR ≈ 1.2. Binding: non-marriage + work/gender culture ══════════
 {:type :instrument :id "jp-marriage-decline" :name "非婚化・晩婚化 (declining & late marriage)"
  :jurisdiction "JP" :kind :value :year 2010
  :enactor "Emergent — rising lifelong-unmarried rates + later marriage; ~98% of births occur within marriage in Japan"
  :origin "Because childbearing is tightly coupled to marriage, falling/later marriage is the dominant proximate driver of low fertility — a reproductive-cohort + paradigm constraint the childcare levers barely touch."
  :stakeholders ["young adults" "labor market" "households"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.78 :reversibility :cultural :meadows 2
  :basis "生涯未婚率 + mean-age-at-marriage trends; births-within-marriage share" :sourcing :representative :confidence 0.65
  :note "The JP-specific binding constraint: it is a non-marriage problem more than a per-couple-fertility problem."}

 {:type :instrument :id "jp-work-gender-culture" :name "長時間労働・性別分業 (long hours + gendered care)"
  :jurisdiction "JP" :kind :value :year 2000
  :enactor "Emergent — long-working-hours norm + 専業主婦 expectation + uneven unpaid-care division"
  :origin "Work culture + gendered care raise the opportunity cost of children and discourage marriage/second births — a deep reproductive-cohort driver."
  :stakeholders ["working women" "employers" "households"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.7 :reversibility :cultural :meadows 3
  :basis "Working-hours + unpaid-care-gap statistics" :sourcing :representative :confidence 0.6}

 {:type :instrument :id "jp-childcare-waitlist" :name "待機児童 (childcare shortage / waitlists)"
  :jurisdiction "JP" :kind :institution :year 2010
  :enactor "Structural — insufficient licensed childcare capacity in urban areas (待機児童 problem)"
  :origin "Childcare shortages force a career interruption that raises the effective cost of a child; partially eased post-2018 but long a binding constraint."
  :stakeholders ["dual-earner families" "municipalities" "childcare sector"]
  :stock :childrearing-cost :polarity :suppress :magnitude 0.5 :reversibility :institutional :meadows 5
  :basis "待機児童 counts; urban childcare-capacity gap" :sourcing :representative :confidence 0.5}

 {:type :instrument :id "jp-angel-plan-1994" :name "エンゼルプラン (Angel Plan childcare expansion)"
  :jurisdiction "JP" :kind :law :year 1994
  :enactor "4-ministry agreement (Health/Welfare, Education, Labour, Construction) after the 1990 «1.57ショック»"
  :origin "Japan's first comprehensive pronatal/childcare-support program; followed by New Angel Plan / 子ども・子育て support — early reach below the parameter level but under-scaled vs the marriage + work-culture stocks."
  :stakeholders ["national ministries" "municipalities" "working parents"]
  :stock :childrearing-cost :polarity :boost :magnitude 0.25 :reversibility :statutory :meadows 5
  :basis "1994 エンゼルプラン; 1999 新エンゼルプラン" :sourcing :representative :confidence 0.55}

 {:type :instrument :id "jp-kishida-childcare-2023" :name "異次元の少子化対策 (child-rearing support expansion)"
  :jurisdiction "JP" :kind :law :year 2023
  :enactor "Cabinet (Kishida) — 2023 «こども未来戦略» / expanded 児童手当 + こども家庭庁 (Children & Families Agency)"
  :origin "A larger pronatal package (child-allowance expansion, support agency). Acts at Meadows 8/5; effect uncertain while the marriage + work-culture constraints persist."
  :stakeholders ["Cabinet" "こども家庭庁" "young families"]
  :stock :fertility-rate :polarity :boost :magnitude 0.25 :reversibility :statutory :meadows 8
  :basis "2023 こども未来戦略; 児童手当 expansion; こども家庭庁 establishment" :sourcing :representative :confidence 0.5}

 ;; ══ Italy (IT) — TFR ≈ 1.2. Binding: youth precarity + familistic low services ═══
 {:type :instrument :id "it-youth-precarity" :name "precarietà giovanile (youth unemployment + precarious work)"
  :jurisdiction "IT" :kind :institution :year 2010
  :enactor "Structural — high youth unemployment + temporary-contract dualism delaying economic independence"
  :origin "Precarious early careers delay leaving home, partnership, and childbearing — the dominant proximate driver of Italy's very late and low fertility."
  :stakeholders ["young adults" "employers" "temporary-contract workers"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.75 :reversibility :institutional :meadows 5
  :basis "Youth-unemployment + temporary-contract share; mean-age-at-first-birth" :sourcing :representative :confidence 0.6}

 {:type :instrument :id "it-familism-low-childcare" :name "familismo (familistic welfare, thin public childcare)"
  :jurisdiction "IT" :kind :institution :year 2000
  :enactor "Structural welfare-regime feature — care responsibility placed on the family, low public 0–3 childcare coverage"
  :origin "A familistic model expects households (women) to provide care with thin public services — raising the private cost/opportunity cost of children (Esping-Andersen familism)."
  :stakeholders ["families" "women providing unpaid care" "municipalities"]
  :stock :childrearing-cost :polarity :suppress :magnitude 0.7 :reversibility :institutional :meadows 5
  :basis "Low 0–3 formal-childcare-coverage; familistic-welfare literature" :sourcing :representative :confidence 0.55}

 {:type :instrument :id "it-gender-care-division" :name "divisione di genere (gendered care + low female employment)"
  :jurisdiction "IT" :kind :value :year 2005
  :enactor "Emergent — strong gendered division of unpaid care + relatively low female labor-force participation (esp. south)"
  :origin "Uneven care expectations raise the personal cost of children and depress fertility even where desired family size is higher."
  :stakeholders ["women" "households" "employers"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.6 :reversibility :cultural :meadows 3
  :basis "Female labor-participation + unpaid-care-gap statistics" :sourcing :representative :confidence 0.5}

 {:type :instrument :id "it-assegno-unico-2022" :name "Assegno Unico Universale (Universal Single Allowance)"
  :jurisdiction "IT" :kind :law :year 2022
  :enactor "Parliament / Draghi government — 2022 Assegno Unico e Universale per i figli (universal per-child allowance)"
  :origin "Consolidated, near-universal monthly child allowance — the most substantial recent pronatal corrective; lowers the cost stock but is recent and modest vs the precarity constraint."
  :stakeholders ["Parliament" "INPS" "families with children"]
  :stock :childrearing-cost :polarity :boost :magnitude 0.3 :reversibility :statutory :meadows 5
  :basis "2022 Assegno Unico Universale (D.Lgs. 230/2021)" :sourcing :representative :confidence 0.55}

 {:type :instrument :id "it-late-home-leaving" :name "indipendenza tardiva (late departure from the family home)"
  :jurisdiction "IT" :kind :value :year 2010
  :enactor "Emergent — prolonged co-residence with parents into the 30s, coupled to precarity + housing cost"
  :origin "Late household formation compresses the reproductive window and lowers completed fertility."
  :stakeholders ["young adults" "parents" "housing market"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.55 :reversibility :cultural :meadows 3
  :basis "Age-leaving-parental-home statistics" :sourcing :representative :confidence 0.5}

 ;; ══ Singapore (SG) — TFR ≈ 1.0. Binding: education-cost + crystallized small-family norm ══
 {:type :instrument :id "sg-stop-at-two-1972" :name "«Stop at Two» (anti-natal campaign)"
  :jurisdiction "SG" :kind :law :year 1972
  :enactor "Singapore Family Planning & Population Board (1966–) — «Stop at Two» campaign from 1972, with tax/housing/schooling disincentives for 3rd+ children"
  :origin "A strong anti-natal program (disincentives via tax, HDB allocation, school priority) for development. Reversed from 1987 («Have Three or More, if you can afford it») once fertility fell below replacement."
  :stakeholders ["Family Planning & Population Board" "HDB" "couples"]
  :stock :fertility-rate :polarity :suppress :magnitude 0.7 :reversibility :statutory :meadows 12
  :basis "«Stop at Two» 1972–1987; population-policy reversal 1987" :sourcing :representative :confidence 0.65}

 {:type :instrument :id "sg-small-family-norm" :name "small-family norm (crystallized post «Stop at Two»)"
  :jurisdiction "SG" :kind :value :year 1990
  :enactor "Emergent — the small-family default internalized after a generation of «Stop at Two»"
  :origin "A Meadows level-2 paradigm: one/two children seen as normal; persists after the policy reversal (cultural hysteresis, the same R2 lock-in seen in China)."
  :stakeholders ["urban families" "two generations raised under the campaign"]
  :stock :small-family-norm :polarity :suppress :magnitude 0.7 :reversibility :cultural :meadows 2
  :basis "Reported low ideal/achieved family size" :sourcing :representative :confidence 0.55
  :note "Year nominal (norm has no enactment date), used only for era bucketing."}

 {:type :instrument :id "sg-education-competition" :name "education competition (tuition / streaming cost)"
  :jurisdiction "SG" :kind :value :year 2000
  :enactor "Emergent — high-stakes examination + private-tuition culture"
  :origin "Intense education competition makes each child costly in money and parental time — a primary cost driver behind sub-replacement fertility."
  :stakeholders ["parents" "private-tuition sector" "students"]
  :stock :childrearing-cost :polarity :suppress :magnitude 0.75 :reversibility :cultural :meadows 5
  :basis "Private-tuition expenditure share" :sourcing :representative :confidence 0.55}

 {:type :instrument :id "sg-work-gender-cost" :name "work culture + opportunity cost (gendered care)"
  :jurisdiction "SG" :kind :value :year 2010
  :enactor "Emergent — long working hours + career opportunity cost + gendered care expectations"
  :origin "High opportunity cost of children for a dual-career, high-cost-of-living city-state — a reproductive-cohort driver."
  :stakeholders ["working couples" "employers" "households"]
  :stock :reproductive-cohort :polarity :suppress :magnitude 0.6 :reversibility :cultural :meadows 3
  :basis "Working-hours + cost-of-living + female-employment statistics" :sourcing :representative :confidence 0.5}

 {:type :instrument :id "sg-marriage-parenthood-2001" :name "Marriage & Parenthood Package (Baby Bonus)"
  :jurisdiction "SG" :kind :law :year 2001
  :enactor "Government of Singapore — Marriage & Parenthood Package / Baby Bonus (2001, expanded 2008/2013/2023): cash gift, Child Development Account co-savings, leave, housing priority"
  :origin "The flagship pronatal package after «Stop at Two». Substantial and repeatedly enlarged yet fertility remains ≈1.0 — the corrective is overwhelmed by the cost + norm stocks. (Predecessor: the controversial 1984 graduate-mother scheme, soon abandoned — recorded as on-record history; junkan endorses no selective-natal target, G7/G11.)"
  :stakeholders ["Government of Singapore" "HDB" "young families"]
  :stock :fertility-rate :polarity :boost :magnitude 0.3 :reversibility :statutory :meadows 8
  :basis "Marriage & Parenthood Package 2001–2023; Baby Bonus / CDA" :sourcing :representative :confidence 0.6}

 {:type :instrument :id "sg-housing-bto-cost" :name "housing access (BTO wait + cost)"
  :jurisdiction "SG" :kind :institution :year 2010
  :enactor "HDB Build-To-Order allocation + private-housing cost in a land-scarce city-state"
  :origin "Although HDB widens ownership, BTO waiting times + overall cost delay household formation — a cost-side suppressor."
  :stakeholders ["HDB" "young couples" "housing market"]
  :stock :childrearing-cost :polarity :suppress :magnitude 0.45 :reversibility :institutional :meadows 5
  :basis "BTO waiting-time + housing-cost trends" :sourcing :representative :confidence 0.45}
]
