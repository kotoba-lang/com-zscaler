;; kotoba.app.edn — actor:junkan KOTOBA Mesh application manifest (observatory on-kse, ADR-2606230001 §4).
;; Deploy: kotoba app deploy kotoba.app.edn  (compiles methods/mesh.clj → CID → control datoms)
{:kotoba.app/name    "junkan"
 :kotoba.app/version "0.1.0"
 :kotoba.app/components
 [{:name     "junkan"
   :src      "methods/mesh.clj"                  ; Clojure default → run + on-kse
   :scale    1
   :triggers [{:type :kse :topic "etzhayyim/actor/junkan"}]
   :requires #{:cap/kqe}}
  ;; self-publication: the ANALYSIS-ONLY observer periodically drafts its OWN history
  ;; (on-record governance-asymmetry instruments — law/institution + 誰が/経緯/関係者)
  ;; + findings (DISCLOSED-HYPOTHESIS loop read-offs 好循環/悪循環 + Meadows leverage
  ;; candidates) as DRY-RUN MIRROR social posts, and — once it holds its own mesh-runtime
  ;; key (self-custodied, no-server-key, ADR-2605231525) under a member CACAO leash —
  ;; signs them itself. junkan publishes disclosed hypotheses, never verdicts/proven
  ;; causation (G5/G7). Live broadcast stays Council Lv6+ + operator gated and is carried
  ;; via ossekai/kataribe on junkan's behalf, never by junkan (§1.12/G11/G13); R0 = dry-run.
  ;; ADR-2606272355.
  {:name     "junkan-social"
   :src      "methods/social.cljc"
   :scale    1
   :triggers [{:type :tick :cron "0 */6 * * *"}                 ; every 6h: self-publish backlog
              {:type :kse  :topic "etzhayyim/actor/junkan/publish"}]
   :requires #{:cap/kqe :cap/atproto}}]

 :kotoba.app/placement {:spread  :zone
                        :require {:tier "edge"}}}
