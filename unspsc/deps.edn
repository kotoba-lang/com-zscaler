{:paths ["src" "resources"]
 ;; unspsc — the concrete UNSPSC commodity actor: 18,342 living actors = the
 ;; kotodama organism runtime + a per-code data table + a segment-capability
 ;; library. The generic organism machinery (life / organism graph / ReAct) lives
 ;; in kotodama; this actor injects its domain (capability/run + the result shape).
 ;; Persisted as-of on the kotoba Datom log. Per the ADR superseding 2606131645.
 ;;   kotodama      — generic organism runtime (transitively: langgraph-clj + langchain-clj)
 :deps {io.github.com-junkawasaki/kotodama
        {:git/tag "v0.1.0" :git/sha "802a04d"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :build-taxonomy {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
                   :main-opts ["-m" "unspsc.build-taxonomy"]}
  :enrich {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
           :main-opts ["-m" "unspsc.enrich"]}
  :fleet {:main-opts ["-m" "unspsc.fleet"]}
  ;; local workspace dev — valid from the MAIN root checkout
  ;; (orgs/etzhayyim/root/20-actors/unspsc → orgs/com-junkawasaki/*);
  ;; inside a .claude/worktrees/* checkout use the default git deps.
  :dev {:override-deps
        {io.github.com-junkawasaki/kotodama     {:local/root "../../../../com-junkawasaki/kotodama"}
         io.github.com-junkawasaki/langgraph-clj {:local/root "../../../../kotoba-lang/langgraph"}
         io.github.com-junkawasaki/langchain-clj {:local/root "../../../../kotoba-lang/langchain"}}}}}
