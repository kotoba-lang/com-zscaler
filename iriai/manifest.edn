 :actor/gates
 [{:gate/id "G1" :gate/name "commons-map-not-shutoff-list" :gate/rule "A COVERAGE + RESILIENCE map, NEVER a target-list / shut-off list; a lifeline is a commons right of use (入会権), never WITHHELD as leverage. :iriai/shutoff + :iriai/disconnect + :iriai.region/deny + :iriai.person/* unrepresentable (test-enforced); aggregate region-scale only, no per-person connection/location"}
  {:gate/id "G2" :gate/name "commons-not-a-market" :gate/rule "cash ≡ 0 to the consumer (§1.16 in-kind); never billed, never disconnected for non-payment. Instruments {:grant :milestone-escrow :in-kind} ONLY — :iriai.fund/tariff + :iriai.fund/price + :iriai.fund/subscription + :iriai.fund/equity + :iriai.fund/disconnect-for-nonpayment unrepresentable. Imputed value is market-equivalent transparency-only, NOT a price"}
  {:gate/id "G3" :gate/name "steward-not-sovereign" :gate/rule "iriai PROPOSES; the commons (1 SBT = 1 vote) DECIDES. NO :iriai/fund / :iriai.manage/decide / :iriai.manage/dispatch route; every proposal advisory:true / binds-fund:false / decided-by 1-sbt-1-vote (the tanemaki steward pattern)"}
  {:gate/id "G4" :gate/name "non-profit-rails-only" :gate/rule "Funding is donation → TitheRouter 10% → Public Fund (USDC/Base/ERC-4337, or non-custodial fiat→USDC on-ramp); no custodial-fiat / no ad-funding / no for-profit utility capture as a funding source"}
  {:gate/id "G5" :gate/name "assessment-r0-only-never-acts" :gate/rule "Compute-only R0; iriai stops at actuation-class :intent. :iriai/actuate + :iriai.infra/energize + open-valve + ignite + activate-link unrepresentable; live actuation is the producer actor's cell under Council Lv7+ + operator-DID + member-sig (infra-robotics R0 precedent, §1.12 Transparent-Force)"}
  {:gate/id "G6" :gate/name "no-server-key" :gate/rule "Platform holds no signing key; the heartbeat performs no network I/O (local append-only ledger). Autonomous writes attributed to a consenting member via a CACAO leash (ADR-2606111400/2605231525); server-held-key structurally false"}
  {:gate/id "G7" :gate/name "kotoba-eavt-native" :gate/rule "State is kotoba EAVT Datoms (content-addressed commit-DAG, verify-chain); datoms flagged :iriai/derived + :iriai/sourcing"}
  {:gate/id "G8" :gate/name "synthetic-seed" :gate/rule "R0 seed is :synthetic; real region/utility-coverage data is an operator/Council step (no-server-key bars a custodial key, not read-only public ingest — a future G7 leg)"}
  {:gate/id "G9" :gate/name "maintenance-safety-floor" :gate/rule "An UNSAFE asset is never deferred for cost — its maintenance verdict MUST be :corrective-repair or :decommission, never :ok/:inspect/:preventive-service/:refurbish (test-enforced; mirrors mizuho chlorination clamp + kamado purge gate + kafun refuse-precedes-routing). The twin SIMULATES; iriai never actuates upkeep (:iriai.maint/dispatch-crew unrepresentable, G5); upkeep OpEx is §1.16 in-kind — never billed (:iriai.maint/consumer-bill unrepresentable, G2). ADR-2606280900"}]

 :actor/non-goals
 [{:n/id "N1" :n/rule "Never PRODUCES a lifeline — production is hikari/mizuho/kamado/noroshi; iriai is the SoS synthesizer + funding + governance umbrella only"}
  {:n/id "N2" :n/rule "Never ACTUATES — never energizes a grid, opens a valve, ignites gas, or activates a link (R0 assessment + design; live actuation unrepresentable, producer + Council Lv7+ only)"}
  {:n/id "N3" :n/rule "Never a metered product, never a market — no tariff/price/subscription/bill; the lifeline is a commons right delivered §1.16 in-kind (cash≡0)"}
  {:n/id "N4" :n/rule "Never withholds a lifeline as leverage — there is no shut-off/disconnect/deny route; the inversion of utility-as-coercion"}
  {:n/id "N5" :n/rule "Never decides funding — iriai proposes (advisory); the Public Fund (1 SBT = 1 vote) decides; no per-person connection/location data (aggregate region-scale only)"}]

