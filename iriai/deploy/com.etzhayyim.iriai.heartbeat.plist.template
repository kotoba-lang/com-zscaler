<?xml version="1.0" encoding="UTF-8"?>
<!-- iriai 入会 — commons heartbeat LaunchAgent (ADR-2606280900). -->
<!-- Generated by deploy/install.clj from this template; do not install by hand. -->
<!-- Runs ONE deterministic, idempotent-by-content commons beat hourly at :44. -->
<!-- No-server-key: depends on the LOCAL seed + bb; appends to a local ledger only. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.etzhayyim.iriai.heartbeat</string>
    <key>ProgramArguments</key>
    <array>
      <string>@@BB@@</string>
      <string>@@REPO@@/20-actors/iriai/cell.cljc</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@@REPO@@</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>ETZHAYYIM_NODE_NAME</key>
      <string>judah</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
      <key>Minute</key>
      <integer>44</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@@LOGDIR@@/iriai-heartbeat.out.log</string>
    <key>StandardErrorPath</key>
    <string>@@LOGDIR@@/iriai-heartbeat.err.log</string>
  </dict>
</plist>
