// Zipline clean-room schema -> Datomic EAVT mapping
// Generated by deepen_actors.py (ADR 260607 deepening phase).

namespace zipline {

    entity Drone {
        id: string @unique
        serial: string
        model: string
        batteryPct: float
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Mission {
        id: string @unique
        droneId: string
        type: string
        status: string
        createdAt: datetime
        updatedAt: datetime
    }

    entity Waypoint {
        id: string @unique
        missionId: string
        lat: float
        lon: float
        altitudeM: float
        seq: integer
        createdAt: datetime
        updatedAt: datetime
    }

    entity Telemetry {
        id: string @unique
        droneId: string
        lat: float
        lon: float
        altitudeM: float
        recordedAt: datetime
        createdAt: datetime
        updatedAt: datetime
    }

    entity Payload {
        id: string @unique
        droneId: string
        type: string
        weightKg: float
        createdAt: datetime
        updatedAt: datetime
    }

    entity Swarm {
        id: string @unique
        name: string
        droneCount: integer
        leaderId: string
        createdAt: datetime
        updatedAt: datetime
    }

}

    // Auto-injected Cognitive Schema
    entity CognitiveRecord {
        id: string @unique
        originalPayload: string
        aiStatus: string
        aiInsights: json
        computedAt: datetime
    }
