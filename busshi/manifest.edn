;; busshi 物資 — actor manifest (clj-native, kotoba-Datom-native)
;; World commodity & raw-materials KG mirror. OBSERVATION ONLY — 取引しない / 採掘しない.
;; ADR-2606161730 (R0) · risk axis = ADR-2606161700 (§2(l) multi-gen 子・孫 × wellbecoming)
{:actor/id        "busshi"
 :actor/glyph     "物"
 :actor/tier      :tier-b
 :actor/integrates ["abaki" "inochi" "kabuto" "kamado" "kanayama" "kanjo" "kasa" "mitooshi" "rare-earth-coverage" "shionome" "tsumugi"]
 :actor/domain    "busshi.etzhayyim.com"
 :actor/kind      :observation-watcher
 :actor/purpose   "World commodity & raw-materials KG-mirror observatory. Mirrors commodities/materials (precious metals 金銀PGM / base metals / rare-critical metals / energy 石油ガス石炭 / agricultural softs) into the kotoba Datom log and runs the §2(l) multi-generational (子・孫) × wellbecoming RISK axis (ADR-2606161700): producer concentration + multi-gen footprint routed to RESILIENCE / de-monopolization / restoration. OBSERVATION ONLY — never trades (取引しない), never extracts (採掘しない), never forecasts; a resilience map, NEVER a target-list or market signal. Umbrella sibling of rare-earth-coverage (rare-metals specialist), kabuto (supply-chain), kanjō (financials), kasa (compute), shionome (capital flows)."
 :actor/status    :r0
 :actor/adr       "2606161730"
 :actor/related   ["2606161700" "2606022000" "2606032000" "2606072201" "2605252400" "2606051500"]

 :actor/charter-rider
 {:rider/version "3.2"
  :rider/applied true}

 :actor/gates
 [{:gate/id "G1" :gate/name "observation-only-no-trade" :gate/rule "Never a trade — no buy/sell/position/order; :busshi/trade unrepresentable (test-enforced)"}
  {:gate/id "G2" :gate/name "risk-axis-not-target-list" :gate/rule "§2(l) multi-gen 子・孫 × wellbecoming axis → resilience/de-monopolization/restoration; NEVER a target-list"}
  {:gate/id "G3" :gate/name "non-adjudicating-no-forecast" :gate/rule "Producer share + price level are disclosed facts, never a verdict/forecast; no :busshi/signal, no point-forecast attr"}
  {:gate/id "G4" :gate/name "kotoba-eavt-native" :gate/rule "State is kotoba EAVT Datoms (no SQL/RisingWave/Cypher); derived datoms flagged :busshi/derived + :busshi/sourcing"}
  {:gate/id "G5" :gate/name "aggregate-first-no-coordinates" :gate/rule "Aggregate-first; no precise mine/well coordinates; no person-level data"}
  {:gate/id "G6" :gate/name "murakumo-only" :gate/rule "Any narration via Murakumo no-VKE mesh only (ADR-2605215000)"}
  {:gate/id "G7" :gate/name "no-server-key" :gate/rule "Platform holds no key; live primary-source ingest is an operator step (R0 seed = :representative)"}
  {:gate/id "G8" :gate/name "no-paid-terminal" :gate/rule "No Bloomberg/Refinitiv-style paid data terminal (Rider §2(e)); public-info only"}]

 :actor/non-goals
 [{:n/id "N1" :n/rule "NOT an extraction/mining actor — extraction is gated by §2(l) (ADR-2606161700) as its own actor; busshi only observes"}
  {:n/id "N2" :n/rule "NOT a trading desk / no market signal (shionome echo)"}
  {:n/id "N3" :n/rule "NOT a price forecaster (mitooshi owns distributions; busshi observes levels)"}
  {:n/id "N4" :n/rule "NOT a paid terminal / data-broker (Rider §2(c)+§2(e))"}
  {:n/id "N5" :n/rule "No person/individual data"}]

 :actor/methods
 [{:method/id "busshi_edn" :method/file "methods/busshi_edn.cljc" :method/role "seed loader + classify"}
  {:method/id "analyze"    :method/file "methods/analyze.cljc"    :method/role "analyze → datoms → render-datoms → coverage → render-report (+ bb CLI)"}
  {:method/id "kotoba"     :method/file "methods/kotoba.cljc"     :method/role "Wave 2 (ADR-2606171000): content-addressed append-only OBSERVATION LEDGER (tx-cid/append-tx/read-log/verify-chain)"}
  {:method/id "autorun"    :method/file "methods/autorun.cljc"    :method/role "Wave 2 (ADR-2606171000): deterministic idempotent-by-content heartbeat — analyze → append observation datoms on change (+ bb CLI)"}
  {:method/id "ie_flow"    :method/file "methods/ie_flow.cljc"    :method/role "SoS score (ADR-2606212200): embeds shared etzhayyim.ie-flow.metrics — observation → measured flow events (commodity multigen-risk rectified into resilience routes) → order-index/score in the SoS scoreboard; OBSERVATION-ONLY; record-flow! to 80-data/ie-flow/busshi/ (gitignored)"}]

 :actor/lex
 [{:lex/id "commodityObservation"}
  {:lex/id "resilienceMap"}]

 :actor/seed
 {:seed/file "kotoba/seed.edn"
  :seed/ontology "kotoba/ontology.busshi.edn"
  :seed/sourcing :representative
  :seed/classes [:precious-metal :base-metal :rare-metal :energy :ag-soft]}

 :actor/ledger
 {:ledger/file "data/persisted/busshi.observations.kotoba.edn"
  :ledger/kind :append-only-content-addressed-commit-dag
  :ledger/gitignored true
  :ledger/idempotent-by-content true
  :ledger/note "Generated observation ledger of resilience observations; tamper-evident (verify-chain); no-server-key; appends only on change; a record of concentration OBSERVATIONS, never a target-list."}

 :actor/tests
 {:runner "babashka"
  :cmd "./20-actors/busshi/run_tests.sh"
  :suites ["methods/test_busshi_edn.cljc" "methods/test_analyze.cljc"
           "methods/test_kotoba.cljc" "methods/test_autorun.cljc"]}}
