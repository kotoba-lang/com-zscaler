{:paths ["src" "cells" "methods" "registry"]
 ;; langgraph-clj (kotoba-lang/langgraph) — zero-/low-dep .cljc → portable to
 ;; JVM / SCI / ClojureScript / GraalVM (ADR-aligned with the sibling
 ;; kyoninka / robotaxi / itonami actors).
 ;; NOTE: langgraph's own deps.edn pulls langchain via a :git/sha. We pin
 ;; io.github.kotoba-lang/langchain to a LOCAL checkout here in the root :deps —
 ;; tools.deps gives the root project's declaration highest priority, so this
 ;; overrides the transitive git coord offline (no network needed for tests).
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../../../../kotoba-lang/langchain"}}
 :aliases
 {;; offline workspace dev — langchain override is already in :deps (root-authority),
  ;; kept as an empty alias for parity with the kyoninka/robotaxi/itonami shape.
  :dev {:override-deps {}}
  ;; clojure -M:test → cognitect test-runner over test/ (+ methods/ if scanned).
  ;; cheshire is pulled in so the existing methods/* charter-gate tests (which
  ;; read the central lexicons via cheshire) remain loadable under the JVM too.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      cheshire/cheshire {:mvn/version "5.13.0"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
