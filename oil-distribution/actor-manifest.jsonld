{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:oil-distribution.etzhayyim.com",
  "actors": [
    {
      "description": "Downstream product terminal coverage.",
      "displayName": "Product Terminals",
      "path": "network:product-terminal"
    },
    {
      "description": "Wholesale and storage hub coverage.",
      "displayName": "Wholesale Hubs",
      "path": "network:wholesale-hub"
    },
    {
      "description": "Product family balance and inventory stress coverage.",
      "displayName": "Product Balance",
      "path": "analytics:product-balance"
    },
    {
      "description": "Distribution bottleneck and inventory risk coverage.",
      "displayName": "Inventory Constraints",
      "path": "risk:inventory"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Oil Distribution agent. Track product terminals, wholesale hubs and downstream movement of refined products. Explain where diesel, gasoline and jet bottlenecks appear after refining.",
  "description": "Product terminal, wholesale hub and downstream distribution coverage across diesel, gasoline, jet and fuel oil networks.",
  "displayName": "Oil Distribution & Product Terminal Intelligence",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "complianceFrameworks": [
      "EPA Fuel Standards",
      "SECA Fuel Rules",
      "IFRS Inventory Control"
    ],
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "oil-distribution",
  "nanoid": "01ld1str",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal) RETURN t.country_code AS country, count(t) AS count, sum(t.storage_capacity) AS storage ORDER BY storage DESC LIMIT 20"
          },
          "fn": "graph.query",
          "id": "terminalStats"
        },
        {
          "args": {
            "sql": "MATCH (h:WholesaleHub) RETURN h.country_code AS country, count(h) AS count, sum(h.throughput_bpd) AS throughput LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "hubStats"
        },
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal) RETURN t.product_family AS family, count(t) AS count LIMIT 20"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "productMix"
        },
        {
          "args": {
            "message": "Oil distribution report.\n\nTerminal stats:\n$terminalStats.rows\n\nHub stats:\n$hubStats.rows\n\nProduct mix:\n$productMix.rows\n\nSummarize downstream product concentration, hub bottlenecks and likely end-market stress points."
          },
          "depends_on": [
            "terminalStats",
            "hubStats",
            "productMix"
          ],
          "fn": "agent.chat",
          "id": "analyze"
        },
        {
          "args": {
            "template": "Oil distribution report: $analyze.text"
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */8 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal {product_family: $input.record.productFamily}) RETURN t.terminal_code AS terminalCode, t.country_code AS country, t.storage_capacity AS storage LIMIT 20"
          },
          "fn": "graph.query",
          "id": "matchDemandNodes"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.oilRefining.yieldSnapshot"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal {terminal_code: $input.terminalCode}) RETURN t.vertex_id, t.repo, t.collection, t.status LIMIT 1"
          },
          "fn": "graph.query",
          "id": "terminal"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilDistribution.network.getProductTerminal",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal) RETURN t.vertex_id, t.repo, t.collection, t.status LIMIT 50"
          },
          "fn": "graph.query",
          "id": "terminals"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilDistribution.network.listProductTerminals",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (h:WholesaleHub) RETURN h.vertex_id, h.repo, h.collection, h.status LIMIT 50"
          },
          "fn": "graph.query",
          "id": "hubs"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilDistribution.network.listWholesaleHubs",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal {country_code: $input.countryCode}) RETURN t.terminal_code AS terminalCode, t.product_family AS productFamily, t.storage_capacity AS storage LIMIT 50"
          },
          "fn": "graph.query",
          "id": "balance"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilDistribution.analytics.getProductBalance",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (t:ProductTerminal) RETURN count(t) AS terminals LIMIT 1"
          },
          "fn": "graph.query",
          "id": "stats"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.oilDistribution.health",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did RETURN count(n) AS nodeCount, coalesce(max(n._seq), 0) AS latestSeq LIMIT 1"
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "sql": "MATCH (n) WHERE n.repo = $did AND n.collection IS NOT NULL RETURN n.collection AS collection, count(n) AS cnt ORDER BY cnt DESC LIMIT 10"
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "params": {
              "actorName": "oil-distribution",
              "bucket": "6h",
              "collection": "com.etzhayyim.apps.oilDistribution.coverageSnapshot",
              "latestSeq": 0,
              "nanoid": "01ld1str",
              "nodeCount": "$coverageNodes.rows[0].nodeCount"
            },
            "template": "MERGE (c:ActorCoverageSnapshot {actorDid: $did, bucket: $bucket, actorName: $actorName, nanoid: $nanoid, nodeCount: $nodeCount, latestTs: $latestTs, repo: $did, collection: $collection, status: 'active'})"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "product-terminal-registry",
      "wholesale-hub-mapping",
      "downstream-flow-analysis",
      "inventory-constraint-monitoring",
      "product-balance-monitoring"
    ],
    "description": "Tracks product terminals, wholesale hubs and refinery-to-market product movements.",
    "displayName": "Oil Distribution & Product Terminal Intelligence",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.oilDistribution.productTerminal",
        "com.etzhayyim.apps.oilDistribution.wholesaleHub",
        "com.etzhayyim.apps.oilRefining.yieldSnapshot",
        "com.etzhayyim.apps.oilShipping.cargo"
      ]
    }
  },
  "uiType": "yoro"
}
