{:lexicon 1
 :id "com.etzhayyim.watatsumi.seaTrialRecord"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["tid" "dockPass" "harborPass" "deepWaterPass"]
    :properties
    {:tid {:type "string" :description "Transaction ID"}
     :dockPass {:type "string" :description "Dock trial pass"}
     :harborPass {:type "string" :description "Harbor dive pass"}
     :deepWaterPass {:type "string" :description "Deep-water trial pass (per IMCA D-001)"}}}}}}
