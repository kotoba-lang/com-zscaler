;; silicon 珪 — kotoba EAVT schema
;; ADR-2605242500 + 2605242545 · ADR-2606021139 (silicon = independent actor)
;; Ternary silicon-fab orchestration over kotoba Datoms: wafer-lot process history
;; (append-only per-step attestation; G8), fab equipment registry, §2(a)(c) force
;; review gate (G1), and chip attestation where chips are LEASED, never sold (G2,
;; land-trust-analogue inalienability). Projects the silicon lexicons
;; (waferLotAttestation / fabEquipmentTelemetry / silenForceReview /
;; chipManufacturingAttestation) into first-class Datom state (G6).

[;; 8 fab process steps (lexicon knownValues): litho deposition etch implant cmp metrology test packaging

 ;; ───────────────────────────── :wafer-lot/* — a lot moving through the fab ─────────────────────────────
 {:db/ident :wafer-lot/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity
  :db/doc "lot id, e.g. LOT-7NM-2026-0001"}
 {:db/ident :wafer-lot/chip-type
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "target device, e.g. iwakura-ternary-infer / fuigo-ternary-train"}
 {:db/ident :wafer-lot/state
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":in-fab | :verified | :rework | :scrapped | :quarantined (as-of trajectory)"}
 {:db/ident :wafer-lot/current-step-index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "monotonic step counter into process_history"}

 ;; ───────────────────────────── :process-step/* — append-only per-step attestation (G8) ─────────────────────────────
 {:db/ident :process-step/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :process-step/lot
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :process-step/step-index
  :db/valueType :db.type/long
  :db/cardinality :db.cardinality/one
  :db/doc "monotonic step number within this lot (append-only chain; never rewritten, G8)"}
 {:db/ident :process-step/process
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":litho | :deposition | :etch | :implant | :cmp | :metrology | :test | :packaging"}
 {:db/ident :process-step/executing-cell-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "DID of the silicon_* Pregel cell that ran the super-step"}
 {:db/ident :process-step/equipment-did
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one
  :db/doc "ref → :fab-equipment unit that executed the recipe"}
 {:db/ident :process-step/recipe-uri
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "AT URI of the versioned recipe record"}
 {:db/ident :process-step/outcome
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":ok | :rework-required | :scrapped | :quarantined"}
 {:db/ident :process-step/force-review-uri
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "REQUIRED when process ∈ {:litho :implant} (HIGH §2(a)(c) risk; G1). ref → :force-review"}
 {:db/ident :process-step/completed-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "ISO-8601 datetime (passed in; no wall-clock in cell)"}

 ;; ───────────────────────────── :fab-equipment/* — equipment registry ─────────────────────────────
 {:db/ident :fab-equipment/did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :fab-equipment/category
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc "8-process self-design category: :litho :deposition :etch :implant :cmp :metrology :test :packaging"}
 {:db/ident :fab-equipment/status
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":r0-rtl-sim (Phase 1) | :fpga | :mpw | :production — see ADR-2605242500 4-phase roadmap"}
 {:db/ident :fab-equipment/telemetry-uri
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "AT URI of fabEquipmentTelemetry down-sample"}

 ;; ───────────────────────────── :force-review/* — §2(a)(c) Council gate (G1) ─────────────────────────────
 {:db/ident :force-review/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :force-review/scope
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":rtl-commit | :cad-commit | :robotics-commit | :wafer-lot | :shipment | :baseline-design"}
 {:db/ident :force-review/risk-class
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":HIGH-2a | :HIGH-2c | :HIGH-both | :MEDIUM-2a | :MEDIUM-2c | :LOW"}
 {:db/ident :force-review/verdict
  :db/valueType :db.type/keyword
  :db/cardinality :db.cardinality/one
  :db/doc ":approve | :approve-with-conditions | :deny | :defer-30day-objection. Only :approve / :approve-with-conditions clear a gated step (G1)"}
 {:db/ident :force-review/council-attestors
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/many
  :db/doc "Council Lv6+ ≥3 multisig attestor DIDs (ADR-2605242500 Decision 4)"}
 {:db/ident :force-review/attested-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}

 ;; ───────────────────────────── :chip/* — manufactured chip (LEASED, never sold; G2) ─────────────────────────────
 {:db/ident :chip/id
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/unique :db.unique/identity}
 {:db/ident :chip/chip-type
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :chip/lot
  :db/valueType :db.type/ref
  :db/cardinality :db.cardinality/one}
 {:db/ident :chip/die-xy
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}
 {:db/ident :chip/bin
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "test bin classification"}
 {:db/ident :chip/force-review-uri
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "REQUIRED before ship (G1)"}
 {:db/ident :chip/leased-to-did
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one
  :db/doc "SBT-holder lessee DID. Chips are LEASED, never transferred/sold (G2 inalienability, land-trust analogue). No :chip/owner attribute exists by design"}
 {:db/ident :chip/manufactured-at
  :db/valueType :db.type/string
  :db/cardinality :db.cardinality/one}]
