/label \"請求に理由がある場合: 支払い/convenio\"}]", :proc/label "Emplazamiento (訴状送達・メキシコ)", :proc/deadline-rules "[{:dl/label \"Contestación\", :dl/rule \"期限は手続種別・entidad federativa による (ordinario mercantil は9日等) — 通知記載と現地規則を必ず確認\", :dl/anchor \"Código de Comercio art. 1399 / 各州 CPC\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :mx, :proc/genuine-channels [:formal-service], :db/id -124, :proc/refer-when ["消費者紛争は PROFECO conciliación が先行可能" "高額 → Defensoría Pública"], :proc/trigger-keywords ["emplazamiento" "citación"], :proc/id "proc:mx-emplazamiento"} {:proc/options "[{:opt/id :reconocimiento, :opt/kind :self-submit, :opt/protective true, :opt/label \"solicitud de reconocimiento de créditos を conciliador へ提出 (本人可; anticipo・depósito・vale など前払金も crédito: kaiyaku 縁-ledger と突合)\"}]", :proc/label "Reconocimiento de créditos (acreedor・concurso・メキシコ)", :proc/deadline-rules "[{:dl/label \"Solicitud de reconocimiento de créditos\", :dl/rule \"sentencia de concurso mercantil の DOF (Diario Oficial de la Federación) 公告から20 días naturales 以内に conciliador へ solicitud de reconocimiento de créditos を提出 (art.122 frac.I); その後 lista provisional への objeción 期間・reconocimiento 判決への apelación 期間という後続2機会があるが、frac.III の期間経過後は債権の reconocimiento を求められない\", :dl/anchor \"Ley de Concursos Mercantiles art.122\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :mx, :proc/genuine-channels [:mail], :proc/track :insolvency, :db/id -125, :proc/refer-when ["garantía・compensación・crédito elevado (担保・相殺・高額債権)"], :proc/trigger-keywords ["concurso mercantil" "reconocimiento de créditos" "conciliador" "síndico"], :proc/id "proc:mx-concurso"} {:proc/options "[{:opt/id :contestacion, :opt/kind :self-submit, :opt/protective true, :opt/label \"contestación を期限内に提出 (請求への認否 + reconvención があれば併せて)\"} {:opt/id :audiencia, :opt/kind :self-decide, :opt/label \"audiencia preliminar に出席 (合意・調整の余地)\"}]", :proc/label "Contestación de demanda de divorcio (家事・メキシコ)", :proc/deadline-rules "[{:dl/label \"Contestación\", :dl/rule \"juicio oral familiar では demandado は emplazamiento から9 días hábiles 以内に contestación を提出 (CNPCF art.665); 後に audiencia preliminar が15日内に設定される。CNPCF は2023施行だが州ごとに declaratoria で段階適用 — 採用済みの州のみ、未採用州は当該州の CPC を確認\", :dl/anchor \"Código Nacional de Procedimientos Civiles y Familiares art. 665\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :mx, :proc/genuine-channels [:mail :formal-service], :proc/track :family, :db/id -126, :proc/refer-when ["guarda y custodia・pensión alimenticia・bienes (親権・養育費・財産) が争点 → abogado / Defensoría Pública" "kokoro 心 (精神的サポート — 家事事件は Wellbecoming 負荷が大きい)"], :proc/trigger-keywords ["divorcio" "juicio oral familiar" "demanda de divorcio"], :proc/id "proc:mx-family"} {:proc/options "[{:opt/id :contestacion, :opt/kind :self-submit, :opt/protective true, :opt/label \"contestación を15 días hábiles 以内に提出 (事由・renta 計算・通知の適法性を争う)\"} {:opt/id :no-self-help-protection, :opt/kind :self-decide, :opt/protective true, :opt/label \"arrendador の autotutela (cambio de cerradura・corte de servicios・sacar pertenencias) は違法・delito になりうる — el lanzamiento は orden judicial によってのみ; 受けたら Ministerio Público・abogado・Defensoría へ\"}]", :proc/label "Juicio de arrendamiento / desahucio (住居・メキシコ)", :proc/deadline-rules "[{:dl/label \"Contestación a la demanda de arrendamiento\", :dl/rule \"juicio especial de arrendamiento の被告 (inquilino) は notificación から原則15 días hábiles 以内に contestación を提出。賃料2か月分の遅延・用途違反等で arrendador は rescisión 可 (CCF art.2489)。通知だけで強制退去はできず、lanzamiento は裁判所の sentencia + ejecución によってのみ。州ごとに手続法が異なる (CNPCF 段階適用 / 地方 CPC) — 通知記載と当該州規則を確認\", :dl/anchor \"Código Civil Federal art. 2489 (rescisión) + juicio especial de arrendamiento (CPC estatal / CNPCF)\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :mx, :proc/genuine-channels [:mail :formal-service], :proc/track :housing, :db/id -127, :proc/refer-when ["事由が複雑・desalojo ilegal → abogado / Defensoría Pública / PROFECO (consumo)"], :proc/trigger-keywords ["desahucio" "arrendamiento inmobiliario" "lanzamiento" "desocupación"], :proc/id "proc:mx-housing"} {:proc/options "[{:opt/id :oposicion, :opt/kind :self-submit, :opt/protective true, :opt/label \"salario mínimo inembargable・excedente の30%上限を超える embargo には juez へ異議を提出 (pensión alimenticia を除く)\"} {:opt/id :verify, :opt/kind :self-decide, :opt/protective true, :opt/label \"descuento/embargo が salario mínimo 床・excedente の30%上限を超えていないか empleador/expediente で確認\"}]", :proc/label "Embargo de salario (賃金差押え・執行・メキシコ)", :proc/deadline-rules "[{:dl/label \"Embargo de salario への対応\", :dl/rule \"原則 salario は embargable でない (LFT art.112) — salario mínimo は inembargable で、唯一の例外は pensión alimenticia (art.110 fracc.V)。民事・商事債務では SCJN の判例上、salario mínimo を超える excedente についてのみ、かつ原則その30%まで embargo 可。pensión alimenticia では excedente の全部に及びうる。descuentos も salario mínimo 超過分の30%が上限 (art.110)。上限超過の embargo には juez へ異議・tercería を申立てられる\", :dl/anchor \"Ley Federal del Trabajo art. 112 (inembargabilidad) + art. 110 (30% del excedente) + jurisprudencia SCJN\", :dl/source-url \"https://mexico.justia.com/federales/leyes/ley-federal-del-trabajo/titulo-tercero/capitulo-vii/\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :mx, :proc/genuine-channels [:mail :formal-service], :proc/track :enforcement, :db/id -128, :proc/refer-when ["保護額を侵害・pensión alimenticia・複数 embargo → abogado / Defensoría Pública / PROFEDET"], :proc/trigger-keywords ["embargo de salario" "embargo de sueldo" "descuento de salario" "embargo de remuneraciones"], :proc/id "proc:mx-enforcement"} {:proc/options "[{:opt/id :protest, :opt/kind :self-submit, :opt/protective true, :opt/label \"書面 protest を1か月以内に (理由不要 — まず構造を逆転させる)\"} {:opt/id :no-self-help-protection, :opt/kind :self-decide, :opt/protective true, :opt/label \"鍵交換等は違法 — utkastelse は namsmannen のみ\"}]", :proc/label "Oppsigelse av leieforhold (住居・ノルウェー)", :proc/deadline-rules "[{:dl/label \"Protest (書面異議)\", :dl/rule \"**1か月以内に書面で protest すると oppsigelse は失効し, 賃貸人が3か月以内に提訴しない限り無効** — 異議の負担が借家人に有利に逆転する構造\", :dl/anchor \"husleieloven §9-8\", :dl/source-url \"https://lovdata.no/lov/1999-03-26-17\", :dl/critical true, :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :no, :proc/genuine-channels [:mail :formal-service], :proc/track :housing, :db/id -129, :proc/refer-when ["Leieboerforeningen (借家人協会)"], :proc/trigger-keywords ["leieforhold" "leieavtale"], :proc/id "proc:no-husleie"} {:proc/options "[{:opt/id :forhandlinger, :opt/kind :self-submit, :opt/protective true, :opt/label \"書面で forhandlinger を請求 (2 uker — まず期限と stå i stilling を確保)\"} {:opt/id :fagforening, :opt/kind :self-decide, :opt/label \"fagforening (組合) / NAV へ即登録\"}]", :proc/label "Oppsigelse (解雇・労働・ノルウェー)", :proc/deadline-rules "[{:dl/label \"Forhandlinger (協議請求)\", :dl/rule \"oppsigelse を争う forhandlinger の請求は2 uker 以内 — 在職継続権 (stå i stilling) の起点にもなる\", :dl/anchor \"arbeidsmiljøloven §17-3\", :dl/source-url \"https://lovdata.no/lov/2005-06-17-62\", :dl/critical true, :dl/verify-service-date true} {:dl/label \"Søksmål (提訴)\", :dl/rule \"無効 (ugyldighet) の søksmål は8 uker 以内・erstatning のみなら6か月以内 (forhandling 終了から起算)\", :dl/anchor \"arbeidsmiljøloven §17-4\", :dl/source-url \"https://lovdata.no/lov/2005-06-17-62\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :no, :proc/genuine-channels [:mail :personal-service], :proc/track :labor, :db/id -130, :proc/refer-when ["fri rettshjelp (労働事件は対象になり得る)" "kokoro 心 (精神的サポート)"], :proc/trigger-keywords ["oppsigelse"], :proc/id "proc:no-oppsigelse"} {:proc/options "[{:opt/id :anmeld-no, :opt/kind :self-submit, :opt/protective true, :opt/label \"bostyrer へ fordring を anmeld (forskudd・gavekort も債権: kaiyaku 縁-ledger と突合)\"} {:opt/id :lg-no, :opt/kind :self-submit, :opt/label \"元従業員なら **lønnsgaranti** (NAV の賃金保証) へ\"}]", :proc/label "Konkurs hos motpart (債権者側・倒産・ノルウェー)", :proc/deadline-rules "[{:dl/label \"Fordringsanmeldelse\", :dl/rule \"債権は bostyrer へ anmeld — Brønnøysund 公告記載の frist 内に (遅延届出も審査され得るが配当リスク)\", :dl/anchor \"konkursloven §109 以下\", :dl/source-url \"https://lovdata.no/lov/1984-06-08-58\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :no, :proc/genuine-channels [:mail :email], :proc/track :insolvency, :db/id -131, :proc/refer-when ["pant/担保 → advokat"], :proc/trigger-keywords ["konkurs"], :proc/id "proc:no-konkurs"} {:proc/options "[{:opt/id :tilsvar, :opt/kind :self-submit, :opt/label \"tilsvar を forliksrådet へ (認否 + 言い分)\"} {:opt/id :møte, :opt/kind :self-decide, :opt/label \"調停期日に出席 (和解の場 — 合意義務はない)\"}]", :proc/label "Innkalling til forliksrådet (強制調停・ノルウェー)", :proc/deadline-rules "[{:dl/label \"Tilsvar (答弁) / 出席義務\", :dl/rule \"innkalling 記載の期限内に tilsvar — 無応答・無断欠席は fraværsdom (欠席判決); 小額民事は forliksrådet 前置が原則 (本人手続前提の制度)\", :dl/anchor \"tvisteloven §6-3・§6-6\", :dl/source-url \"https://lovdata.no/lov/2005-06-17-90\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :no, :proc/genuine-channels [:formal-service :mail], :db/id -132, :proc/refer-when ["NOK 200,000 超や複雑な事案 → advokat"], :proc/trigger-keywords ["forliksrådet" "forliksklage"], :proc/id "proc:no-forliksklage"} {:proc/options "[{:opt/id :klage, :opt/kind :self-submit, :opt/protective true, :opt/label \"trekk が livsopphold (livsoppholdssats + boligutgifter) を侵害するなら namsmannen へ見直し/klage を申立て\"} {:opt/id :verify, :opt/kind :self-decide, :opt/protective true, :opt/label \"残額が livsoppholdssats + boligutgifter を下回っていないか namsmannen と確認 (収入/支出を申告)\"}]", :proc/label "Utleggstrekk (賃金差押え・執行・ノルウェー)", :proc/deadline-rules "[{:dl/label \"Utleggstrekk への対応\", :dl/rule \"namsmannen が lønn/trygd から utleggstrekk (控除) を行うが、skyldner は livsopphold (生活費) に必要な額を必ず保持できる (beslagsfrie midler, dekningsloven §2-7)。保護額は forskrift om livsoppholdssatser の標準率で算定し、boligutgifter (家賃/住宅ローン利息・公共料金・暖房) は上乗せされる。namsmannen は食・住・電気等の必要支出を奪わないよう経済状況を考慮する。算定に異議があれば namsmannen/tingretten に klage できる\", :dl/anchor \"dekningsloven §2-7 + forskrift om livsoppholdssatser (FOR-2014-06-13-724) + tvangsfullbyrdelsesloven\", :dl/source-url \"https://lovdata.no/lov/1984-06-08-59\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :no, :proc/genuine-channels [:mail :formal-service], :proc/track :enforcement, :db/id -133, :proc/refer-when ["保護額を侵害・複数 trekk が重複・gjeldsordning 検討 → advokat / NAV gjeldsrådgivning / fri rettshjelp"], :proc/trigger-keywords ["utleggstrekk" "trekk i lønn" "namsmannen" "utlegg"], :proc/id "proc:no-enforcement"} {:proc/options "[{:opt/id :tilsvar, :opt/kind :self-submit, :opt/protective true, :opt/label \"tingretten が定める期限内に tilsvar を提出 (自分の立場・子の最善を述べる)\"} {:opt/id :mekling, :opt/kind :self-decide, :opt/label \"familievernkontor の mekling に出席 (合意の余地; meklingsattest は提訴要件)\"}]", :proc/label "Foreldretvist (家事・ノルウェー)", :proc/deadline-rules "[{:dl/label \"Tilsvar / mekling\", :dl/rule \"foreldretvist (fast bosted・samvær・foreldreansvar の争い) を court に提起する前に obligatorisk mekling (familievernkontor) を経て meklingsattest (有効期間6か月) を得る必要がある (barneloven §51)。stevning が届いたら saksøkte は tingretten が定める期限 (通常3週間, tvisteloven §9-3) 内に tilsvar を提出。tingretten は conflict-and-reconciliation model で扱い、子に関し専門家 (心理士等) を任命することが多い。重大な暴力・虐待の有罪がある場合は meklingsattest なしでも提訴可\", :dl/anchor \"barneloven §51 (mekling) + tvisteloven §9-3 (tilsvar)\", :dl/source-url \"https://lovdata.no/lov/2005-06-17-90\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :no, :proc/genuine-channels [:mail :formal-service], :proc/track :family, :db/id -134, :proc/refer-when ["fast bosted・samvær・foreldreansvar・vold (親権・面会・DV) が争点 → advokat / fri rettshjelp" "kokoro 心 (精神的サポート — 家事事件は Wellbecoming 負荷が大きい)"], :proc/trigger-keywords ["foreldretvist" "barnefordeling" "samvær" "foreldreansvar"], :proc/id "proc:no-family"} {:proc/options "[