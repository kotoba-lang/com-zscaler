roc/deadline-rules "[{:dl/label \"Contestación\", :dl/rule \"通知から15日 (días hábiles・営業日, proceso ordinario CABA/federal) 以内に contestación — 管轄 (provincia) により異なる; 無応答は rebeldía\", :dl/anchor \"CPCCN arts. 338・356\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :ar, :proc/genuine-channels [:formal-service], :db/id -106, :proc/refer-when ["patrocinio jurídico gratuito (CABA 大学・公的の無料代理)"], :proc/trigger-keywords ["traslado de la demanda"], :proc/id "proc:ar-traslado"} {:proc/options "[{:opt/id :verificacion, :opt/kind :self-submit, :opt/protective true, :opt/label \"pedido de verificación de créditos を síndico へ提出 (本人可; anticipo・seña・vale など前払金も crédito: kaiyaku 縁-ledger と突合)\"}]", :proc/label "Verificación de créditos (acreedor・concurso・アルゼンチン)", :proc/deadline-rules "[{:dl/label \"Pedido de verificación de créditos\", :dl/rule \"sentencia de apertura が定める fecha (verificación tempestiva) までに pedido de verificación de créditos を síndico へ (monto・causa・privilegios を明示, art.32); 期日後は verificación tardía (art.56) — concurso 係属中は incidente、終了後は acción individual、いずれも presentación en concurso から2年以内\", :dl/anchor \"Ley 24.522 art.32 (tempestiva) / art.56 (tardía)\", :dl/source-url \"https://servicios.infoleg.gob.ar/infolegInternet/verNorma.do?id=25379\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :ar, :proc/genuine-channels [:mail], :proc/track :insolvency, :db/id -107, :proc/refer-when ["garantía・compensación・crédito elevado・arancel art.32 (担保・相殺・高額債権)"], :proc/trigger-keywords ["concurso preventivo" "quiebra" "verificación de créditos" "síndico"], :proc/id "proc:ar-concurso"} {:proc/options "[{:opt/id :contestacion, :opt/kind :self-submit, :opt/protective true, :opt/label \"contestación + prueba を5日以内に提出 (intimación previa の有無・renta 計算・通知の適法性を確認)\"} {:opt/id :no-self-help-protection, :opt/kind :self-decide, :opt/protective true, :opt/label \"el locador の autotutela (cambio de cerradura・corte de servicios・sacar pertenencias) は違法 — el lanzamiento は orden judicial によってのみ; 受けたら policía・abogado・patrocinio jurídico gratuito へ\"}]", :proc/label "Juicio de desalojo (住居・アルゼンチン)", :proc/deadline-rules "[{:dl/label \"Contestación de la demanda de desalojo\", :dl/rule \"juicio sumarísimo de desalojo (falta de pago・vencimiento) では被告 (inquilino) は notificación から5日以内に contestación + prueba を提出。住居の falta de pago では訴提起前に CCyC art.1222 の intimación fehaciente (carta documento — WhatsApp/email/口頭は無効) が必須。通知だけで強制退去はできず、el lanzamiento は orden judicial (sentencia + ejecución) によってのみ\", :dl/anchor \"CPCCN (proceso sumarísimo de desalojo) + CCyC art. 1222 (intimación previa)\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :ar, :proc/genuine-channels [:formal-service], :proc/track :housing, :db/id -108, :proc/refer-when ["事由が複雑・desalojo sin intimación / lanzamiento ilegal → abogado / patrocinio jurídico gratuito"], :proc/trigger-keywords ["desalojo" "juicio de desalojo" "lanzamiento" "locación"], :proc/id "proc:ar-housing"} {:proc/options "[{:opt/id :propuesta, :opt/kind :self-submit, :opt/protective true, :opt/label \"自分の propuesta reguladora (alimentos・bienes・hijos の効果案) + 根拠資料を提示 (相手案に同意しない自由)\"} {:opt/id :audiencia, :opt/kind :self-decide, :opt/label \"判事召喚の audiencia に出席 (効果の合意・調整の余地; 離婚自体は incausado)\"}]", :proc/label "Divorcio — propuesta reguladora (家事・アルゼンチン)", :proc/deadline-rules "[{:dl/label \"Propuesta reguladora / audiencia\", :dl/rule \"divorcio の petición には必ず propuesta reguladora (効果の規律案) を添える (CCyC art.438)。一方配偶者のみが申立てた場合、他方は別の propuesta reguladora を提示でき、根拠資料を添付する。判事は propuestas を評価し audiencia に召喚する。divorcio incausado なので convenio の不一致でも離婚判決は停止されない (離婚自体は争えない)。効果 (alimentos・bienes・hijos) に争いがあれば判事が当該州 procesal 法の手続で解決 — traslado の応答期限は当該州 CPC で異なるため通知記載と州規則を確認\", :dl/anchor \"Código Civil y Comercial art. 438 (+ procesal provincial)\", :dl/verify-service-date true}]", :proc/verify-current-law true, :proc/jurisdiction :ar, :pr